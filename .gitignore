# Odoo source — shallow clone, never edited, never committed.
# Re-create with: git clone --depth 1 --branch 19.0 https://github.com/odoo/odoo.git odoo
odoo/

# Python env
.venv/
__pycache__/
*.py[cod]

# Odoo runtime data (filestore, sessions, compiled assets)
.odoo-data/

# Logs / scratch
*.log
.DS_Store

# Spartan AI config (contains API keys)
.spartan/ai.env

# Local secrets (Twilio etc.) — never committed
.env
docs/screenshots/*.yml
docs/screenshots/*.log

# Load-test artefacts — regenerated per run, and tenants.json carries live logins.
loadtest/results/
loadtest/config/tenants.json
.worktrees/

# Playwright browser QA. node_modules is ~400 MB of browser tooling; the reports
# and traces are regenerated per run, and a trace embeds a session cookie.
qa/node_modules/
qa/test-results/
qa/playwright-report/
qa/.auth/
