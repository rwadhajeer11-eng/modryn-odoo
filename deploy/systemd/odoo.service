[Unit]
Description=MODRYN on Odoo 19 (Community)
Documentation=file:/opt/modryn/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target
# Requires, not Wants: with no database this process starts, fails every
# request, and looks healthy to systemd. Tie its fate to Postgres.
Requires=postgresql.service

[Service]
Type=simple
User=odoo
Group=odoo

# TZ=UTC everywhere. The 1-minute SOS cron and the reminder sweep both do date
# arithmetic; a host running Asia/Jerusalem turns the DST transition into a
# silent correctness bug that only appears twice a year.
Environment=TZ=UTC
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8

# rtlcss is a GLOBAL npm binary that Odoo shells out to in order to build the
# RTL stylesheet bundle. systemd does not give a service the login PATH, so
# without /usr/local/bin here the Hebrew storefront renders LTR-ish and
# NOTHING logs an error.
Environment=PATH=/opt/modryn/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Twilio lives in the platform environment now: _twilio_config() reads
# TWILIO_ACCOUNT_SID and its three siblings at call time and every database
# inherits them. NOTHING ELSE puts them in this process, so without this line
# that fallback is dead code in production and every tenant quietly logs its
# messages instead of sending them. The leading '-' keeps a missing file
# non-fatal, so a box provisioned before deploy.env existed still starts.
#
# THE TRAP: this file is NOT sourced by a shell. provision.sh, restore.sh and
# gen_tenants_map.sh read it with `set -a; . file`; systemd parses the same
# bytes as plain KEY=value (provision.sh:88-104 writes exactly that). No
# export, no $-expansion, and quoting means something different on each side —
# a value containing a space or a $ will not reach this process the way it
# reaches those scripts. Also note EnvironmentFile OVERRIDES Environment=
# regardless of order: a PATH= added to deploy.env replaces the line above and
# takes rtlcss with it.
#
# 0600 root:root against User=odoo is correct, not a permission bug to fix:
# systemd reads this as PID 1, before dropping privileges. Widening it would
# hand the credentials to every process the odoo user runs. deploy.env also
# carries DOMAIN, the backup settings and LOADGEN_IP; those become process
# environment too, which is harmless but not a secret to be surprised by.
EnvironmentFile=-/etc/modryn/deploy.env

ExecStart=/opt/modryn/.venv/bin/python /opt/modryn/odoo/odoo-bin server -c /etc/odoo/odoo.conf

# Prefork forks 53 children (48 http + 4 cron + 1 gevent). KillMode=mixed sends
# SIGTERM to the main process only and lets it drain its own children; the long
# stop timeout is so an in-flight request finishes instead of being SIGKILLed.
KillMode=mixed
TimeoutStopSec=120
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
# The fail2ban jail matches on SYSLOG_IDENTIFIER=modryn. Renaming this breaks
# the jail silently — fail2ban reports the jail as running and bans nobody.
SyslogIdentifier=modryn

# --- Containment -----------------------------------------------------------
# Odoo writes attachments whose content an anonymous visitor can influence, so
# the process must not be able to write its own code. data_dir is the only
# writable path it legitimately needs.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/modryn

# ProtectSystem=strict will surface anything that writes outside data_dir as a
# permission error rather than as a mystery. If a module needs a scratch file,
# PrivateTmp already gives it /tmp — do not widen ReadWritePaths to silence a
# symptom.

[Install]
WantedBy=multi-user.target
