<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Her day, not the room's. Sections render only when their module
         injected the key — the floor board's precedent for ops keys — so this
         page never 500s in a database missing the atelier or the roster. -->
    <template id="staff_home" name="MODRYN staff home">
        <t t-call="modryn_staff.staff_layout">
            <div class="d-flex align-items-baseline justify-content-between mb-1">
                <h1 class="mb-0" t-out="home['name']"/>
                <span t-if="home['role']" class="modryn_sub" t-out="home['role']"/>
            </div>

            <div t-if="home['no_role'] or home['no_employee']"
                 class="alert alert-warning my-3" role="status">
                Your role isn't set yet — ask the owner to pick one for you
                on the Team page. Until then you'll only see what is assigned
                to you by name, and the pages your role would open are closed.
            </div>

            <!-- HER shifts this week (modryn_roster). Renamed from "Today's
                 shift": a saleswoman plans her week, not her afternoon, and the
                 old panel could only ever answer a question she had already
                 answered by turning up. -->
            <section t-if="home.get('my_shifts') is not None" class="modryn_panel mb-4">
                <header class="modryn_panel_head"><h2>My shifts</h2></header>
                <p t-if="not home['my_shifts']" class="modryn_empty">
                    You're not on this week's published rota.
                </p>
                <div t-else="" class="p-3">
                    <div t-foreach="home['my_shifts']" t-as="s" class="modryn_myshift">
                        <span class="modryn_strong"><t t-esc="s['weekday']"/></span>
                        <span class="modryn_sub" dir="ltr"><t t-esc="s['day_label']"/></span>
                        <span class="modryn_badge is_free"><t t-esc="s['type_label']"/></span>
                        <span class="modryn_sub" dir="ltr"><t t-esc="s['hours']"/></span>
                        <span class="modryn_sub"><t t-esc="s['name']"/></span>
                    </div>
                </div>
            </section>

            <!-- The WHOLE week, whether or not she is on it. Knowing the shop is
                 covered on Friday, or who to ask for a swap, means seeing the
                 shifts that are not hers - so this deliberately does not filter
                 to her own. Days with nothing on them are still drawn: a day
                 that is simply absent reads the same as a day nobody is on, and
                 only one of those is worth asking about. -->
            <section t-if="home.get('week_shifts')" class="modryn_panel mb-4">
                <header class="modryn_panel_head"><h2>This week's shifts</h2></header>
                <div class="p-3">
                    <!-- Three states, not two. "No rota yet" and "a published
                         day nobody is on" are different facts and only one of
                         them is worth asking the manager about - noga trades
                         Sunday to Thursday and, with its week not yet
                         generated, every day read "Nothing on this day": a
                         shop that looked shut all week. Same None-vs-empty
                         contract modryn_rostered_on already keeps. -->
                    <p t-if="not home.get('week_published')" class="modryn_empty mb-0">
                        This week's rota hasn't been published yet.
                    </p>
                    <div t-if="home.get('week_published')"
                         t-foreach="home['week_shifts']" t-as="d"
                         t-attf-class="modryn_weekday #{'is_today' if d['is_today'] else ''}">
                        <div class="modryn_weekday_head">
                            <span class="modryn_strong"><t t-esc="d['weekday']"/></span>
                            <span class="modryn_sub" dir="ltr"><t t-esc="d['day_label']"/></span>
                            <span t-if="d['is_today']" class="modryn_badge is_free">Today</span>
                        </div>
                        <p t-if="not d['slots']" class="modryn_sub mb-0">Nothing on this day.</p>
                        <div t-else="" class="modryn_weekday_slots">
                            <div t-foreach="d['slots']" t-as="s"
                                 t-attf-class="modryn_weekslot #{'is_mine' if s['mine'] else ''}">
                                <span class="modryn_badge is_muted"><t t-esc="s['type_label']"/></span>
                                <span class="modryn_sub" dir="ltr"><t t-esc="s['hours']"/></span>
                                <!-- The NAME, because a day can legitimately
                                     carry two shifts of the same part of the day
                                     at the same hours - bella runs exactly that
                                     on Sundays - and without it the second row
                                     reads as the page having duplicated the
                                     first. unique(name, weekday) makes the name
                                     the one field guaranteed to tell them
                                     apart; hours and type are not constrained. -->
                                <span class="modryn_sub"><t t-esc="s['name']"/></span>
                                <t t-if="s['people']">
                                    <span t-foreach="s['people']" t-as="p"
                                          class="modryn_chip"><t t-esc="p"/></span>
                                </t>
                                <span t-else="" class="modryn_sub">Nobody yet</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Today, kept as a one-line strip under the week. -->
            <section t-if="home.get('shift')" class="modryn_panel mb-4">
                <header class="modryn_panel_head"><h2>Today</h2></header>
                <!-- No t-else here: the t-if it used to pair with moved into the
                     "My shifts" panel above, and a t-else with no preceding t-if
                     sibling is a QWeb error at RENDER time - the page would have
                     500'd for every staff member, not failed to load once. -->
                <div class="p-3">
                    <t t-foreach="home['shift']" t-as="s">
                        <div>
                            <span class="modryn_strong" t-out="s['name']"/>
                            <span class="modryn_sub ms-2" t-out="s['hours']"/>
                        </div>
                    </t>
                </div>
            </section>

            <!-- My customers right now -->
            <section class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2>My customers</h2>
                    <span class="modryn_count" t-out="len(home['walkins']) + len(home['bookings'])"/>
                </header>
                <p t-if="not home['walkins'] and not home['bookings']" class="modryn_empty">
                    Nobody is assigned to you right now.
                </p>
                <table t-else="" class="table modryn_table align-middle">
                    <tbody>
                        <tr t-foreach="home['walkins']" t-as="w">
                            <td><span class="modryn_strong" t-out="w['name']"/></td>
                            <td><span class="modryn_badge is_free">Walk-in</span></td>
                            <td>
                                <span t-if="w['state'] == 'called'" class="modryn_badge is_busy">With you now</span>
                                <span t-else="" class="modryn_badge is_muted">Waiting</span>
                            </td>
                        </tr>
                        <tr t-foreach="home['bookings']" t-as="b">
                            <td><span class="modryn_strong" t-out="b['title']"/></td>
                            <td><span class="modryn_badge is_muted" t-out="b['time']"/></td>
                            <td>
                                <span t-if="b['helper']" class="modryn_badge is_muted">Helping</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <!-- My alterations (modryn_atelier) -->
            <section t-if="home.get('my_tasks') is not None" class="modryn_panel mb-4"
                     id="modryn_home_alterations">
                <header class="modryn_panel_head">
                    <h2>My alterations</h2>
                    <span class="modryn_count" t-out="len(home['my_tasks'])"/>
                </header>
                <p t-if="not home['my_tasks']" class="modryn_empty">
                    Your rail is clear — new work is assigned automatically when it lands.
                </p>
                <table t-else="" class="table modryn_table align-middle">
                    <tbody>
                        <tr t-foreach="home['my_tasks']" t-as="task">
                            <td style="width: 1%;">
                                <span t-if="task['priority'] == '2'" class="modryn_badge is_busy">High</span>
                                <span t-elif="task['priority'] == '0'" class="modryn_badge is_muted">Low</span>
                            </td>
                            <td>
                                <div class="modryn_strong" t-out="task['customer']"/>
                                <div t-if="task['dress']" class="modryn_sub">
                                    <t t-out="task['dress']"/>
                                    <t t-if="task['size']"> · <t t-out="task['size']"/></t>
                                </div>
                                <div t-if="task['note']" class="modryn_sub" t-out="task['note']"/>
                            </td>
                            <td>
                                <span t-if="task['due']"
                                      t-attf-class="modryn_badge #{'is_busy' if task['overdue'] else 'is_muted'}"
                                      t-out="task['due']"/>
                            </td>
                            <td class="text-end">
                                <!-- All three working states, always, with the
                                     current one held down. She taps whichever
                                     the garment is actually in — INCLUDING
                                     going back, which is the only way a mis-tap
                                     gets undone. Before this there was one
                                     forward button per state and "Ready" was a
                                     dead end: tapping it on the wrong row meant
                                     asking the owner to fix it in the back
                                     office.
                                     "Delivered" is deliberately not here — it
                                     stamps delivered_at and hands her the next
                                     job, so it is not a toggle. -->
                                <div class="btn-group btn-group-sm" role="group"
                                     aria-label="Task state">
                                    <t t-foreach="home.get('task_states') or []" t-as="ts">
                                        <button type="button"
                                                t-attf-class="btn #{'btn-primary' if task['state'] == ts[0] else 'btn-outline-dark'}"
                                                t-att-data-task-advance="task['id']"
                                                t-att-data-target="ts[0]"
                                                t-att-aria-pressed="'true' if task['state'] == ts[0] else 'false'"
                                                t-att-disabled="'disabled' if task['state'] == ts[0] else None"
                                                t-out="ts[1]"/>
                                    </t>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <!-- My follow-ups (modryn_ops) -->
            <section t-if="home.get('ops_tasks') is not None" class="modryn_panel mb-4"
                     id="modryn_home_followups">
                <header class="modryn_panel_head">
                    <h2>My follow-ups</h2>
                    <span class="modryn_count" t-out="len(home['ops_tasks'])"/>
                </header>
                <p t-if="not home['ops_tasks']" class="modryn_empty">Nothing to chase.</p>
                <table t-else="" class="table modryn_table align-middle">
                    <tbody>
                        <tr t-foreach="home['ops_tasks']" t-as="task">
                            <td>
                                <div class="modryn_strong" t-out="task['name']"/>
                                <div t-if="task.get('customer')" class="modryn_sub" t-out="task['customer']"/>
                            </td>
                            <td>
                                <span t-if="task.get('due')"
                                      t-attf-class="modryn_badge #{'is_busy' if task.get('overdue') else 'is_muted'}"
                                      t-out="task['due']"/>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-dark"
                                        t-att-data-task-done="task['id']">Done</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <!-- One error line for the action buttons; home.js fills it. -->
            <div id="modryn_home_error" class="alert alert-danger d-none" role="alert"/>
        </t>
    </template>

</odoo>
