<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The he/en switch. Deliberately shows only the OTHER language: it is a
         toggle, not a menu — staff screens have exactly two languages by
         product decision. A form (POST + csrf), not a link: it mutates the
         user's stored preference. -->
    <template id="lang_toggle" name="MODRYN staff language toggle">
        <!-- Every language the boutique has switched on, not a hardcoded pair.
             A <select> and not a toggle button, because a toggle can only ever
             reach the NEXT language: with three switched on, one of them
             becomes unreachable.

             The submit button is always rendered, never JS-only. `onchange`
             submits for the common case, but an inline handler is exactly the
             thing a Content-Security-Policy drops silently — and a language
             picker that quietly does nothing is worse than one with a button. -->
        <form action="/staff/lang" method="post" class="d-inline modryn_admin_lang">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="redirect" t-att-value="request.httprequest.path"/>
            <i class="fa fa-globe modryn_admin_icon" aria-hidden="true"/>
            <select name="lang" class="modryn_admin_lang_select"
                    aria-label="Language" onchange="this.form.submit()">
                <t t-foreach="request.env['res.lang'].sudo().search([])" t-as="l">
                    <option t-att-value="l.code"
                            t-att-selected="'selected' if l.code == (request.env.lang or '') else None"
                            t-out="l.name"/>
                </t>
            </select>
            <button type="submit" class="modryn_admin_link btn btn-link p-0 modryn_admin_lang_go"
                    aria-label="Apply language">
                <i class="fa fa-check" aria-hidden="true"/>
            </button>
        </form>
    </template>

    <!-- A thin alias now: every page that dressed itself in the "owner shell"
         gets the ONE unified nav instead (the portal_layout → frontend_layout
         body-forwarding idiom). Kept as a name so ten templates across four
         modules did not have to change their t-call. -->
    <template id="manage_layout" name="MODRYN owner layout">
        <t t-call="modryn_staff.staff_layout">
            <t t-out="0"/>
        </t>
    </template>

    <!-- ============================ staff list ============================ -->
    <template id="manage_staff_list" name="MODRYN staff list">
        <t t-call="modryn_staff.manage_layout">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h1 class="mb-0">Team</h1>
                <a href="/manage/staff/new" class="btn btn-primary">Add a team member</a>
            </div>

            <div t-if="not employees" class="modryn_empty">No team members yet.</div>

            <table t-else="" class="table modryn_table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Permission level</th>
                        <th>Username</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="employees" t-as="e"
                        t-attf-class="#{'modryn_archived' if not e['active'] else ''}">
                        <td>
                            <t t-out="e['name']"/>
                            <!-- Where she lives, under her name rather than in
                                 columns of its own: this table already carries
                                 seven, and an eighth and ninth would push the
                                 Actions column off a phone. -->
                            <div t-if="e['city'] or e['street']" class="modryn_sub">
                                <t t-out="e['street']"/><t t-if="e['street'] and e['city']">, </t><t t-out="e['city']"/>
                            </div>
                        </td>
                        <td t-out="e['role']"/>
                        <td t-out="e['level']"/>
                        <td dir="ltr" t-out="e['login']"/>
                        <td dir="ltr">
                            <t t-out="e['phone']"/>
                            <!-- The second number, marked as the second number.
                                 Printing them as two bare lines would leave
                                 whoever is ringing round no way to tell which
                                 one to try first. -->
                            <div t-if="e['backup_phone']" class="modryn_sub">
                                <t t-out="e['backup_phone']"/>
                                <span dir="auto">· backup</span>
                            </div>
                        </td>
                        <td>
                            <span t-if="not e['active']" class="modryn_badge is_muted">Archived</span>
                            <span t-elif="e['occupied']" class="modryn_badge is_busy">
                                Busy<t t-if="e['occupied_with']"> · <t t-out="e['occupied_with']"/></t>
                            </span>
                            <span t-else="" class="modryn_badge is_free">Available</span>
                        </td>
                        <td class="text-end">
                            <a t-attf-href="/manage/staff/edit/#{e['id']}"
                               class="btn btn-sm btn-outline-dark">Edit</a>
                            <form t-attf-action="/manage/staff/archive/#{e['id']}" method="post"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="e['active']">Archive</t>
                                    <t t-else="">Restore</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

    <!-- ========================== staff add / edit ======================== -->
    <template id="manage_staff_form" name="MODRYN staff form">
        <t t-call="modryn_staff.manage_layout">
            <h1 class="mb-4">
                <t t-if="employee">Edit team member</t>
                <t t-else="">Add a team member</t>
            </h1>

            <form method="post" class="modryn_form"
                  t-attf-action="/manage/staff/#{'edit/%s' % employee.id if employee else 'new'}">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="mb-3">
                    <label class="form-label" for="name">Name</label>
                    <input type="text" id="name" name="name" class="form-control"
                           t-att-value="values.get('name', '')"/>
                    <div t-if="errors.get('name')" class="modryn_field_error" t-out="errors['name']"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="phone">Phone</label>
                    <input type="tel" id="phone" name="phone" class="form-control" dir="ltr"
                           t-att-value="values.get('phone', '')"/>
                </div>

                <!-- Who she is, as opposed to what she does. Kept together and
                     kept ABOVE the job fields: an owner filling this in is
                     copying off one document, and interleaving it with role and
                     permission level would make her put it down and pick it up
                     four times. -->
                <fieldset class="mb-3">
                    <legend class="h6 text-muted">Personal details</legend>

                    <div class="mb-3">
                        <label class="form-label" for="backup_phone">Backup phone</label>
                        <input type="tel" id="backup_phone" name="backup_phone"
                               class="form-control" dir="ltr"
                               t-att-value="values.get('backup_phone', '')"/>
                        <div class="form-text">The number to try when the first one doesn't answer.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="id_number">ID number</label>
                        <input type="text" id="id_number" name="id_number"
                               class="form-control" dir="ltr" inputmode="numeric"
                               t-att-value="values.get('id_number', '')"/>
                        <div t-if="errors.get('id_number')" class="modryn_field_error"
                             t-out="errors['id_number']"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="city">City</label>
                        <input type="text" id="city" name="city" class="form-control"
                               t-att-value="values.get('city', '')"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="street">Street and number</label>
                        <input type="text" id="street" name="street" class="form-control"
                               t-att-value="values.get('street', '')"/>
                    </div>
                </fieldset>

                <div class="mb-3">
                    <label class="form-label" for="role_id">Role</label>
                    <select id="role_id" name="role_id" class="form-select">
                        <option value="">— Choose a role —</option>
                        <t t-foreach="roles" t-as="role">
                            <option t-att-value="role.id"
                                    t-att-selected="'selected' if str(values.get('role_id', '')) == str(role.id) else None"
                                    t-out="role.name"/>
                        </t>
                    </select>
                    <div t-if="errors.get('role_id')" class="modryn_field_error" t-out="errors['role_id']"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="level">Permission level</label>
                    <select id="level" name="level" class="form-select">
                        <t t-foreach="levels" t-as="lvl">
                            <option t-att-value="lvl[0]"
                                    t-att-selected="'selected' if values.get('level') == lvl[0] else None"
                                    t-out="lvl[1]"/>
                        </t>
                    </select>
                    <div t-if="errors.get('level')" class="modryn_field_error" t-out="errors['level']"/>
                </div>

                <!-- Credentials are set once, at hire. Changing them later is a
                     separate concern (reset flow) and deliberately not here. -->
                <t t-if="not employee">
                    <hr class="my-4"/>
                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input type="text" id="username" name="username" class="form-control" dir="ltr"
                               t-att-value="values.get('username', '')"/>
                        <div t-if="errors.get('username')" class="modryn_field_error"
                             t-out="errors['username']"/>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="password">Password</label>
                        <input type="password" id="password" name="password" class="form-control"
                               dir="ltr"/>
                        <div t-if="errors.get('password')" class="modryn_field_error"
                             t-out="errors['password']"/>
                    </div>
                </t>

                <button type="submit" class="btn btn-primary btn-lg">Save</button>
                <a href="/manage/staff" class="btn btn-link">Cancel</a>
            </form>
        </t>
    </template>

    <!-- ============================== roles =============================== -->
    <template id="manage_roles" name="MODRYN roles">
        <t t-call="modryn_staff.manage_layout">
            <h1 class="mb-2">Roles</h1>
            <p class="text-muted mb-4">
                You decide the roles — add whatever the boutique needs.
            </p>

            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

            <form action="/manage/roles/new" method="post" class="d-flex gap-2 mb-4"
                  style="max-width: 480px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="text" name="name" class="form-control" placeholder="New role name"/>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <table class="table modryn_table align-middle" style="max-width: 480px;">
                <tbody>
                    <tr t-foreach="roles" t-as="role"
                        t-attf-class="#{'modryn_archived' if not role.active else ''}">
                        <td>
                            <t t-out="role.name"/>
                            <span t-if="role.is_workshop" class="badge text-bg-dark ms-2">Workshop</span>
                        </td>
                        <td class="text-end">
                            <!-- Whether this role's members take the workshop's
                                 auto-assigned queue. A toggle, not a checkbox-and-
                                 save: one decision, one press, same as Archive. -->
                            <form t-attf-action="/manage/roles/workshop/#{role.id}" method="post"
                                  class="d-inline me-1">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="role.is_workshop">Not workshop</t>
                                    <t t-else="">Workshop</t>
                                </button>
                            </form>
                            <form t-attf-action="/manage/roles/archive/#{role.id}" method="post"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="role.active">Archive</t>
                                    <t t-else="">Restore</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- The access matrix. Rows are HER roles, columns are the staff
                 pages — she decides that seamstresses see the workshop and
                 reception sees the floor, with no developer in the loop.
                 Managers and the owner always see every staff page; "My day"
                 has no column because no matrix state may strand anyone. -->
            <h2 class="mt-5 mb-2">Page access</h2>
            <p class="text-muted mb-3">
                Tick the pages each role may open. Shift managers always see
                every page here; every staff member always has her own
                <em>My day</em> page.
            </p>
            <form action="/manage/roles/pages" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <table class="table modryn_table align-middle" style="max-width: 720px;">
                    <thead>
                        <tr>
                            <th/>
                            <th t-foreach="pages" t-as="pg" class="text-center" t-out="pg['label']"/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="roles" t-as="role"
                            t-attf-class="#{'modryn_archived' if not role.active else ''}">
                            <td t-out="role.name"/>
                            <td t-foreach="pages" t-as="pg" class="text-center">
                                <input type="checkbox" name="pages"
                                       t-att-value="'%s:%s' % (role.id, pg['key'])"
                                       t-att-checked="'checked' if pg['key'] in (granted.get(role.id) or []) else None"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <button type="submit" class="btn btn-primary">Save page access</button>
            </form>
        </t>
    </template>

    <template id="manage_rooms" name="Fitting rooms">
        <t t-call="modryn_staff.manage_layout">
            <h1 class="mb-2">Fitting rooms</h1>
            <p class="text-muted mb-4">
                Name your rooms the way your team says them out loud. When someone
                calls for help, the room is what tells a colleague where to go.
            </p>

            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

            <form action="/manage/rooms/new" method="post" class="d-flex gap-2 mb-4"
                  style="max-width: 480px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="text" name="name" class="form-control" placeholder="New room"/>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <table class="table modryn_table align-middle" style="max-width: 480px;">
                <tbody>
                    <tr t-foreach="rooms" t-as="room" t-key="room.id"
                        t-attf-class="#{'modryn_archived' if not room.active else ''}">
                        <td t-out="room.name"/>
                        <td class="text-end">
                            <form t-attf-action="/manage/rooms/archive/#{room.id}" method="post"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="room.active">Archive</t>
                                    <t t-else="">Restore</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

    <!-- ========================== opening hours =========================== -->
    <template id="manage_hours" name="Opening hours">
        <t t-call="modryn_staff.manage_layout">
            <h1 class="mb-2">Opening hours</h1>
            <p class="text-muted mb-4">
                The hours the boutique takes fittings. This is exactly what the booking
                page offers — change it here and the next customer sees the new times.
                A day can have two windows if you close for the afternoon, and if
                two brides can be in at the same hour, say so — the booking page
                will offer that hour twice.
            </p>

            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

            <form action="/manage/hours/new" method="post" class="d-flex gap-2 mb-4 flex-wrap"
                  style="max-width: 640px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <select name="weekday" class="form-select w-auto">
                    <t t-foreach="weekdays" t-as="day">
                        <option t-att-value="day[0]" t-out="day[1]"/>
                    </t>
                </select>
                <!-- type="time" so the browser does the parsing and the owner
                     never has to think of half past ten as 10.5. -->
                <input type="time" name="opens" class="form-control w-auto" dir="ltr" value="10:00"/>
                <input type="time" name="closes" class="form-control w-auto" dir="ltr" value="18:00"/>
                <!-- Spelt out, unlike the two time boxes: a bare number next to a
                     clock reads as minutes. Defaulted to one so an owner who
                     ignores it keeps the week she already had. min="1" is the
                     browser's half of the check — the route re-checks it, because
                     a hand-made POST is not obliged to obey an attribute. -->
                <label class="d-flex align-items-center gap-2 mb-0" for="capacity">
                    <span class="text-muted">How many fittings at once</span>
                    <input type="number" id="capacity" name="capacity" min="1" step="1"
                           value="1" dir="ltr" class="form-control w-auto"
                           style="max-width: 5.5rem;"/>
                </label>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <p t-if="not hours" class="modryn_empty">
                Nothing set yet — the booking page has no times to offer. Add your first day above.
            </p>

            <table t-if="hours" class="table modryn_table align-middle" style="max-width: 640px;">
                <thead>
                    <tr><th>Day</th><th>Opens</th><th>Closes</th><th>At once</th><th/></tr>
                </thead>
                <tbody>
                    <tr t-foreach="hours" t-as="h"
                        t-attf-class="#{'modryn_archived' if not h['active'] else ''}">
                        <td t-out="h['day']"/>
                        <td dir="ltr" t-out="h['opens']"/>
                        <td dir="ltr" t-out="h['closes']"/>
                        <!-- Editable in place. Every window a boutique owns was
                             seeded at one fitting, and a window's day and start
                             time cannot be re-used, so a read-only cell here
                             would mean the number could never be corrected. -->
                        <td dir="ltr">
                            <form t-attf-action="/manage/hours/capacity/#{h['id']}" method="post"
                                  class="d-flex align-items-center gap-1">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <input type="number" name="capacity" min="1" max="20" step="1"
                                       class="form-control form-control-sm" style="width: 4.5rem"
                                       t-att-value="h['capacity']"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">Save</button>
                            </form>
                        </td>
                        <td class="text-end">
                            <form t-attf-action="/manage/hours/archive/#{h['id']}" method="post"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="h['active']">Close</t>
                                    <t t-else="">Open again</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>

            <h2 class="h4 mt-5 mb-2">Days you are closed</h2>
            <p class="text-muted mb-4">
                A holiday, a wedding, stocktaking. A closed date disappears from the
                booking page completely — no times, and no waitlist either, because
                there is nothing to queue for. Leave the second date empty to close
                a single day.
                <br/>
                To shut only part of a day — you close at 14:00 for a wedding —
                fill in the two times as well. The day still appears, offering the
                hours you are open.
            </p>

            <form action="/manage/hours/closure/new" method="post"
                  class="d-flex gap-2 mb-4 flex-wrap" style="max-width: 640px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="text" name="name" class="form-control w-auto"
                       placeholder="What for?"/>
                <!-- type="date" so the browser supplies the calendar and the
                     format, exactly as type="time" does for the windows above. -->
                <input type="date" name="date_from" class="form-control w-auto" dir="ltr"/>
                <input type="date" name="date_to" class="form-control w-auto" dir="ltr"/>
                <!-- Leave both empty for the whole day, which is what a closure
                     has always been. Fill both to shut only part of it: the day
                     still appears on /book with the hours that remain. One
                     without the other is treated as a half-typed form, not as
                     "from 14:00 until whenever". -->
                <input type="time" name="start_hour" class="form-control w-auto" dir="ltr"
                       aria-label="Closed from"/>
                <input type="time" name="end_hour" class="form-control w-auto" dir="ltr"
                       aria-label="Closed until"/>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <p t-if="not closures" class="modryn_empty">
                No closed days — the booking page offers every day above.
            </p>

            <table t-if="closures" class="table modryn_table align-middle"
                   style="max-width: 640px;">
                <thead>
                    <tr><th>Reason</th><th>Dates</th><th>Hours</th><th/></tr>
                </thead>
                <tbody>
                    <tr t-foreach="closures" t-as="c"
                        t-attf-class="#{'modryn_archived' if not c['active'] else ''}">
                        <td t-out="c['name']"/>
                        <td dir="ltr" t-out="c['when']"/>
                        <!-- Blank means the whole day. Saying "All day" in every
                             ordinary row would bury the part-day ones, which are
                             the only rows where the hours carry information. -->
                        <td dir="ltr" class="modryn_sub" t-out="c['hours']"/>
                        <td class="text-end">
                            <form t-attf-action="/manage/hours/closure/archive/#{c['id']}"
                                  method="post" class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="c['active']">Open again</t>
                                    <t t-else="">Close again</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

</odoo>
