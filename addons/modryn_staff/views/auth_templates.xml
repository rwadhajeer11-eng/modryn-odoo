<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        web.frontend_layout, NOT website.layout: this is a staff screen, so it
        gets the theme's CSS but none of the storefront's header, cart or footer.
    -->
    <template id="staff_login" name="MODRYN staff login">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="true"/>
            <t t-set="no_footer" t-value="true"/>
            <div id="wrap" dir="rtl" class="modryn_staff_auth">
                <div class="modryn_staff_auth_card">
                    <h1 class="mb-1">MODRYN</h1>
                    <p class="text-muted mb-4">Staff sign in</p>

                    <form action="/staff/login" method="post" class="text-start">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>

                        <div t-if="error" class="modryn_staff_auth_error mb-3" role="alert">
                            <t t-out="error"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="username">Username</label>
                            <input type="text" id="username" name="username" class="form-control"
                                   autocomplete="username" autofocus="autofocus"
                                   t-att-value="username"/>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="password">Password</label>
                            <input type="password" id="password" name="password" class="form-control"
                                   autocomplete="current-password"/>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
                    </form>
                </div>
            </div>
        </t>
    </template>


    <!-- ============================ her own details ======================= -->
    <template id="staff_profile" name="MODRYN my details">
        <t t-call="modryn_staff.staff_layout">
            <t t-set="active_tab" t-value="'profile'"/>
            <h1 class="mb-2">My profile</h1>

            <!-- Two doors. The details form and the hours table are different
                 questions asked on different days, and stacked they made "how
                 many hours did I do" a scroll past a form about her address. -->
            <div t-if="not view" class="modryn_tiles">
                <a class="modryn_tile" href="/staff/profile?view=details">
                    <i class="fa fa-user" aria-hidden="true"/>
                    <span class="modryn_strong">My details</span>
                    <span class="modryn_sub">
                        Your name, your phone, your language — and the papers the
                        boutique holds for you.
                    </span>
                </a>
                <a class="modryn_tile" href="/staff/profile?view=hours">
                    <i class="fa fa-clock-o" aria-hidden="true"/>
                    <span class="modryn_strong">My hours</span>
                    <span class="modryn_sub">
                        How long you were on the floor, day by day.
                    </span>
                </a>
            </div>

            <a t-if="view" class="modryn_back" href="/staff/profile">Back</a>

            <t t-if="view == 'details'">
            <p class="modryn_sub mb-4">
                Keep these right and the boutique can always reach you.
                Your roles and permission level are set by the owner.
            </p>

            <div t-if="saved" class="modryn_panel mb-3" role="status">
                <span class="modryn_badge is_free">Saved</span>
            </div>
            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

            <form method="post" action="/staff/profile" class="modryn_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="mb-3">
                    <label class="form-label" for="name">Name</label>
                    <input type="text" id="name" name="name" class="form-control"
                           t-att-value="employee.name or ''"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="phone">Phone</label>
                    <input type="tel" id="phone" name="phone" class="form-control" dir="ltr"
                           t-att-value="employee.work_phone or ''"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="backup_phone">Backup phone</label>
                    <input type="tel" id="backup_phone" name="backup_phone"
                           class="form-control" dir="ltr"
                           t-att-value="employee.modryn_backup_phone or ''"/>
                    <div class="form-text">The number to try when the first one doesn't answer.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="city">City</label>
                    <input type="text" id="city" name="city" class="form-control"
                           t-att-value="employee.modryn_city or ''"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="street">Street and number</label>
                    <input type="text" id="street" name="street" class="form-control"
                           t-att-value="employee.modryn_street or ''"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="gender">Gender</label>
                    <select id="gender" name="gender" class="form-select">
                        <option value="">&#8212;</option>
                        <t t-foreach="genders" t-as="g">
                            <option t-att-value="g[0]"
                                    t-att-selected="'selected' if employee.modryn_gender == g[0] else None"
                                    t-out="g[1]"/>
                        </t>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="lang">Language</label>
                    <select id="lang" name="lang" class="form-select">
                        <t t-foreach="langs" t-as="l">
                            <option t-att-value="l.code"
                                    t-att-selected="'selected' if l.code == (request.env.lang or '') else None"
                                    t-out="l.name"/>
                        </t>
                    </select>
                </div>

                <!-- What she may NOT change, shown so she knows who to ask
                     rather than wondering why the field is missing. -->
                <div class="modryn_panel mb-4">
                    <div class="modryn_sub">Set by the owner</div>
                    <div>
                        <!-- Every role, not just the first. Her own profile is
                             the one screen where "which jobs am I down for" is
                             the question, and showing one of two reads as the
                             owner having removed the other. -->
                        <span class="modryn_strong">Roles:</span>
                        <t t-out="' &#183; '.join(employee.modryn_role_ids.mapped('name')) or '&#8212;'"/>
                    </div>
                    <div t-if="employee.modryn_id_number">
                        <span class="modryn_strong">ID number:</span>
                        <span dir="ltr" t-out="employee.modryn_id_number"/>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg">Save</button>
            </form>

            <!-- Documents. Its OWN form: a file input inside the details form
                 would mean every save re-posts the file, and a details save
                 with no file chosen would look like a failed upload. -->
            <section class="modryn_panel mt-4">
                <h2 class="h5">My documents</h2>
                <!-- Read, not written. These are the boutique's record of an
                     employment - a contract, a form, a payslip - and the
                     manager files them on the team screen. There is no Upload
                     and no Remove here because there are no routes behind
                     them any more, not because the buttons were taken away. -->
                <p class="modryn_sub">
                    What the boutique has on file for you. Only you and the
                    owner can open these; your manager adds them.
                </p>

                <div t-if="not documents" class="modryn_empty">Nothing on file yet.</div>
                <div t-else="">
                    <div t-foreach="documents" t-as="doc" class="modryn_doc_row">
                        <a t-attf-href="/staff/profile/file/#{doc.id}">
                            <i class="fa fa-file-o" aria-hidden="true"/>
                            <t t-out="doc.name"/>
                        </a>
                        <span class="modryn_sub" dir="ltr"
                              t-esc="doc.create_date.strftime('%d.%m.%Y')"/>
                    </div>
                </div>
            </section>
            </t>

            <!-- ==================== her hours ==================== -->
            <!-- TIME ON THE FLOOR, and the panel says so. It is counted from
                 the moment she presses the door to the moment she presses it
                 again, which is the only record this product keeps - calling it
                 "hours worked" would be a claim about payroll that nothing here
                 can stand behind. -->
            <section t-if="view == 'hours'" class="modryn_panel">
                <div class="d-flex align-items-baseline justify-content-between flex-wrap gap-2">
                    <h2 class="h5 mb-0">My hours on the floor</h2>
                    <span class="modryn_sub">
                        This week: <strong class="modryn_strong" dir="ltr"
                                           t-out="week_hours"/>
                    </span>
                </div>

                <p t-if="not months" class="modryn_empty mt-3">
                    Nothing recorded yet — your hours start counting the first
                    time you open the floor board.
                </p>

                <t t-else="">
                    <!-- Only the months she HAS something in. A dropdown of the
                         year's twelve would open on empty tables for the ones
                         before she was hired, which reads as lost data. -->
                    <form action="/staff/profile" method="get"
                          class="d-flex gap-2 align-items-center flex-wrap my-3">
                        <!-- The panel travels with the month, or picking one
                             would drop her back on the tiles. -->
                        <input type="hidden" name="view" value="hours"/>
                        <label class="form-label mb-0" for="month">Month</label>
                        <select id="month" name="month" class="form-select w-auto">
                            <option t-foreach="months" t-as="m" t-key="m['key']"
                                    t-att-value="m['key']"
                                    t-att-selected="m['chosen']"
                                    t-out="m['label']"/>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-dark">Show</button>
                    </form>

                    <div class="modryn_card_marks mb-2">
                        <span class="modryn_badge is_muted">
                            <t t-out="month['day_count']"/>
                        </span>
                        <span class="modryn_sub">days on the floor</span>
                        <span class="modryn_badge is_free" dir="ltr">
                            <t t-out="month['hours']"/>
                        </span>
                        <!-- Just "hours". It read "hours in August 2026", which
                             extracts as the fragment "hours in" with the month
                             stranded after it - a msgid no translator can put in
                             her own word order. The month is named on the picker
                             directly above, where she chose it. -->
                        <span class="modryn_sub">hours</span>
                    </div>

                    <p t-if="month['open']" class="modryn_sub">
                        One of these is still running, and counts up to now.
                    </p>

                    <p t-if="not month['days']" class="modryn_empty">
                        You were not on the floor that month.
                    </p>
                    <table t-else="" class="table modryn_table align-middle">
                        <thead>
                            <tr><th>Day</th><th>On and off</th><th>Hours</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="month['days']" t-as="d" t-key="d['label']">
                                <td class="modryn_strong" dir="ltr" t-out="d['label']"/>
                                <td class="modryn_sub">
                                    <span t-foreach="d['spells']" t-as="sp" t-key="sp_index"
                                          dir="ltr" class="me-2">
                                        <t t-out="sp['in']"/><t t-if="sp['out']">–<t t-out="sp['out']"/></t>
                                    </span>
                                </td>
                                <td dir="ltr" t-out="d['hours']"/>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </section>
        </t>
    </template>


    <!-- =========================== what she has been told ================== -->
    <template id="staff_notifications" name="MODRYN notifications">
        <t t-call="modryn_staff.staff_layout">
            <t t-set="active_tab" t-value="'notifications'"/>
            <h1 class="mb-2">Notifications</h1>
            <p class="modryn_sub mb-4">
                Everything the boutique has told you, newest first.
            </p>

            <p t-if="not rows" class="modryn_empty">Nothing yet.</p>

            <div t-else="" class="modryn_panel">
                <div t-foreach="rows" t-as="n"
                     t-attf-class="modryn_note_row #{'is_new' if n.id in unread_ids else ''}">
                    <div>
                        <span t-if="n.id in unread_ids" class="modryn_badge is_free">New</span>
                        <span class="modryn_strong" t-out="n.body"/>
                    </div>
                    <div class="modryn_sub">
                        <span dir="ltr" t-esc="n.create_date.strftime('%d.%m %H:%M')"/>
                        <t t-if="n.actor_name"> · <t t-out="n.actor_name"/></t>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
