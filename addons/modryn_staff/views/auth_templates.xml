<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        web.frontend_layout, NOT website.layout: this is a staff screen, so it
        gets the theme's CSS but none of the storefront's header, cart or footer.
    -->
    <template id="staff_login" name="MODRYN staff login">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="true"/>
            <t t-set="no_footer" t-value="true"/>
            <div id="wrap" dir="rtl" class="modryn_staff_auth">
                <div class="modryn_staff_auth_card">
                    <h1 class="mb-1">MODRYN</h1>
                    <p class="text-muted mb-4">Staff sign in</p>

                    <form action="/staff/login" method="post" class="text-start">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>

                        <div t-if="error" class="modryn_staff_auth_error mb-3" role="alert">
                            <t t-out="error"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="username">Username</label>
                            <input type="text" id="username" name="username" class="form-control"
                                   autocomplete="username" autofocus="autofocus"
                                   t-att-value="username"/>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="password">Password</label>
                            <input type="password" id="password" name="password" class="form-control"
                                   autocomplete="current-password"/>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
                    </form>
                </div>
            </div>
        </t>
    </template>


    <!-- ============================ her own details ======================= -->
    <template id="staff_profile" name="MODRYN my details">
        <t t-call="modryn_staff.staff_layout">
            <t t-set="active_tab" t-value="'profile'"/>
            <h1 class="mb-2">My details</h1>
            <p class="modryn_sub mb-4">
                Keep these right and the boutique can always reach you.
                Your role and permission level are set by the owner.
            </p>

            <div t-if="saved" class="modryn_panel mb-3" role="status">
                <span class="modryn_badge is_free">Saved</span>
            </div>
            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

            <form method="post" action="/staff/profile" class="modryn_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="mb-3">
                    <label class="form-label" for="name">Name</label>
                    <input type="text" id="name" name="name" class="form-control"
                           t-att-value="employee.name or ''"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="phone">Phone</label>
                    <input type="tel" id="phone" name="phone" class="form-control" dir="ltr"
                           t-att-value="employee.work_phone or ''"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="backup_phone">Backup phone</label>
                    <input type="tel" id="backup_phone" name="backup_phone"
                           class="form-control" dir="ltr"
                           t-att-value="employee.modryn_backup_phone or ''"/>
                    <div class="form-text">The number to try when the first one doesn't answer.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="city">City</label>
                    <input type="text" id="city" name="city" class="form-control"
                           t-att-value="employee.modryn_city or ''"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="street">Street and number</label>
                    <input type="text" id="street" name="street" class="form-control"
                           t-att-value="employee.modryn_street or ''"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="gender">Gender</label>
                    <select id="gender" name="gender" class="form-select">
                        <option value="">&#8212;</option>
                        <t t-foreach="genders" t-as="g">
                            <option t-att-value="g[0]"
                                    t-att-selected="'selected' if employee.modryn_gender == g[0] else None"
                                    t-out="g[1]"/>
                        </t>
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label" for="lang">Language</label>
                    <select id="lang" name="lang" class="form-select">
                        <t t-foreach="langs" t-as="l">
                            <option t-att-value="l.code"
                                    t-att-selected="'selected' if l.code == (request.env.lang or '') else None"
                                    t-out="l.name"/>
                        </t>
                    </select>
                </div>

                <!-- What she may NOT change, shown so she knows who to ask
                     rather than wondering why the field is missing. -->
                <div class="modryn_panel mb-4">
                    <div class="modryn_sub">Set by the owner</div>
                    <div>
                        <span class="modryn_strong">Role:</span>
                        <t t-out="employee.modryn_role_id.name or '&#8212;'"/>
                    </div>
                    <div t-if="employee.modryn_id_number">
                        <span class="modryn_strong">ID number:</span>
                        <span dir="ltr" t-out="employee.modryn_id_number"/>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg">Save</button>
            </form>
        </t>
    </template>

</odoo>
