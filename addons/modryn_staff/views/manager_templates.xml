<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================== the manager's own screen ====================== -->
    <template id="manager_screen" name="MODRYN manager screen">
        <t t-call="modryn_staff.staff_layout">
            <t t-set="active_tab" t-value="'boss'"/>
            <t t-set="additional_title">Manager screen</t>

            <h1 class="mb-1">Manager screen</h1>
            <p class="text-muted mb-4">The things that reach the whole team.</p>

            <!-- ========================= the doors ========================= -->
            <!-- One tile per job, and the one she picks is the only thing she
                 reads. Stacked, these were three unrelated blocks down a page,
                 so "send the team a message" meant scrolling past the whole
                 team first.
                 Links and not a script: the back button works, a tile can be
                 sent to somebody as a URL, and there is no state to lose. -->
            <div t-if="not view" class="modryn_tiles">
                <a class="modryn_tile" href="/manage/team-screen?view=announce">
                    <i class="fa fa-bullhorn" aria-hidden="true"/>
                    <span class="modryn_strong">Tell the team</span>
                    <span class="modryn_sub">A message to everybody, or to one of them.</span>
                </a>
                <a class="modryn_tile" href="/manage/team-screen?view=team">
                    <i class="fa fa-users" aria-hidden="true"/>
                    <span class="modryn_strong">The team</span>
                    <span class="modryn_sub">Who works here, and the papers on file.</span>
                </a>
                <!-- The owner's. These hours decide what a customer can book. -->
                <a t-if="is_owner" class="modryn_tile" href="/manage/team-screen?view=hours">
                    <i class="fa fa-clock-o" aria-hidden="true"/>
                    <span class="modryn_strong">Opening hours</span>
                    <span class="modryn_sub">When the boutique takes fittings, and the days it closes.</span>
                </a>
            </div>

            <a t-if="view" class="modryn_back" href="/manage/team-screen">Back</a>

            <!-- ===================== say something ===================== -->
            <section t-if="view == 'announce'" class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2>Tell the team</h2>
                </header>

                <div t-if="error == 'empty'" class="modryn_field_error mb-3" role="alert">
                    Write the message first.
                </div>
                <div t-if="error == 'nobody'" class="modryn_field_error mb-3" role="alert">
                    That only goes to you. Tick somebody else, or tick nobody to
                    tell the whole team.
                </div>

                <form action="/manage/team-screen/announce" method="post">
                    <input type="hidden" name="csrf_token"
                           t-att-value="request.csrf_token()"/>

                    <div class="mb-3">
                        <label class="form-label" for="body">The message</label>
                        <textarea id="body" name="body" rows="3" class="form-control"
                                  placeholder="The delivery is late — nobody promise Thursday."
                                  t-esc="draft"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Who reads it</label>
                        <!-- Nobody ticked means EVERYONE, said on the screen and
                             not only in the code. A separate "send to all"
                             switch would be a second way of saying the same
                             thing, and the two of them disagree eventually. -->
                        <p class="modryn_sub mb-2">
                            Tick nobody and it goes to the whole team.
                        </p>
                        <div class="modryn_piece_grid">
                            <label t-foreach="team" t-as="member" t-key="member['id']"
                                   class="modryn_piece_check">
                                <input type="checkbox" name="employee_ids"
                                       t-att-value="member['id']"
                                       t-att-checked="member['id'] in picked"/>
                                <span t-out="member['name']"/>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Send it</button>
                </form>
            </section>

            <!-- ========================= the team ========================= -->
            <section t-if="view == 'team'" class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2>The team</h2>
                    <span class="modryn_count" t-out="len(team_rows)"/>
                    <a t-if="is_owner" href="/manage/staff/new"
                       class="btn btn-sm btn-primary ms-auto">Add a team member</a>
                </header>
                <p class="modryn_sub mb-3">
                    Everything the boutique knows about her, and the papers it
                    holds. She can read her own on My details; she cannot add to
                    them or remove them.
                </p>
                <p t-if="not is_owner" class="modryn_sub mb-3">
                    Adding somebody, or changing what she may do, is the owner's.
                </p>

                <div class="modryn_cards">
                    <article t-foreach="team_rows" t-as="member" t-key="member['id']"
                             class="modryn_card modryn_team_card">
                        <div class="modryn_card_marks">
                            <span class="modryn_strong" t-out="member['name']"/>
                            <span t-if="not member['active']"
                                  class="modryn_badge is_muted">Archived</span>
                            <span t-elif="member['occupied']"
                                  class="modryn_badge is_busy">Busy</span>
                        </div>
                        <div t-if="member['role']" class="modryn_sub" t-out="member['role']"/>

                        <!-- What the Team screen showed, on the card that holds
                             her papers - so "what is her second number, and did
                             she sign the form" stops being two screens.
                             The identity number is deliberately NOT here, for
                             the reason that screen already gives: this is the
                             page left open on the counter all day. -->
                        <dl class="modryn_person">
                            <t t-if="member['phone']">
                                <dt>Phone</dt>
                                <dd dir="ltr" t-out="member['phone']"/>
                            </t>
                            <t t-if="member['backup_phone']">
                                <dt>Second phone</dt>
                                <dd dir="ltr" t-out="member['backup_phone']"/>
                            </t>
                            <t t-if="member['city'] or member['street']">
                                <dt>Address</dt>
                                <dd><t t-out="' · '.join(x for x in (member['street'], member['city']) if x)"/></dd>
                            </t>
                            <t t-if="member['level']">
                                <dt>Permission level</dt>
                                <dd t-out="member['level']"/>
                            </t>
                            <t t-if="member['login']">
                                <dt>Username</dt>
                                <dd dir="ltr" t-out="member['login']"/>
                            </t>
                            <t t-if="member['occupied_with']">
                                <dt>With</dt>
                                <dd t-out="member['occupied_with']"/>
                            </t>
                        </dl>

                        <div t-if="is_owner" class="modryn_card_actions">
                            <a t-attf-href="/manage/staff/edit/#{member['id']}"
                               class="btn btn-sm btn-outline-dark">Edit her account</a>
                        </div>

                        <div t-if="file_error and file_for == member['id']"
                             class="modryn_field_error mt-2" role="alert">
                            <t t-if="file_error == 'nofile'">Choose a file first.</t>
                            <t t-else="">That file is too large — the limit is 10 MB.</t>
                        </div>

                        <p t-if="not member['papers']" class="modryn_sub mt-2 mb-0">
                            Nothing filed yet.
                        </p>
                        <div t-else="" class="mt-2">
                            <div t-foreach="member['papers']" t-as="doc" t-key="doc['id']"
                                 class="modryn_doc_row">
                                <a t-attf-href="/manage/team-screen/paper/#{doc['id']}">
                                    <i class="fa fa-file-o" aria-hidden="true"/>
                                    <t t-out="doc['name']"/>
                                </a>
                                <span class="modryn_sub" dir="ltr" t-out="doc['at']"/>
                                <form t-attf-action="/manage/team-screen/paper/#{doc['id']}/remove"
                                      method="post" class="d-inline">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-sm btn-outline-dark">
                                        Remove
                                    </button>
                                </form>
                            </div>
                        </div>

                        <form action="/manage/team-screen/paper" method="post"
                              enctype="multipart/form-data"
                              class="d-flex gap-2 flex-wrap mt-2">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="employee_id"
                                   t-att-value="member['id']"/>
                            <input type="file" name="paper" class="form-control form-control-sm"/>
                            <button type="submit" class="btn btn-sm btn-outline-dark">
                                File it
                            </button>
                        </form>
                    </article>
                </div>
            </section>

            <!-- ==================== opening hours ==================== -->
            <!-- Lifted whole from the page it used to be. The OWNER's
                 only: these hours decide what a customer can book, and
                 the routes behind the forms refuse anybody else - the
                 tile is simply not drawn for a manager. -->
            <section t-if="view == 'hours' and is_owner" class="modryn_panel mb-4">
            <h1 class="mb-2">Opening hours</h1>
            <p class="text-muted mb-4">
                The hours the boutique takes fittings. This is exactly what the booking
                page offers — change it here and the next customer sees the new times.
                A day can have two windows if you close for the afternoon, and if
                two brides can be in at the same hour, say so — the booking page
                will offer that hour twice.
            </p>

            <div t-if="hours_error" class="modryn_field_error mb-3" role="alert" t-out="hours_error"/>

            <form action="/manage/hours/new" method="post" class="d-flex gap-2 mb-4 flex-wrap"
                  style="max-width: 640px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <select name="weekday" class="form-select w-auto">
                    <t t-foreach="weekdays" t-as="day">
                        <option t-att-value="day[0]" t-out="day[1]"/>
                    </t>
                </select>
                <!-- type="time" so the browser does the parsing and the owner
                     never has to think of half past ten as 10.5. -->
                <!-- values is what she typed on an attempt that was refused,
                     and empty on a normal visit - so one expression both
                     re-fills the form and keeps the shipped default. -->
                <input type="time" name="opens" class="form-control w-auto" dir="ltr"
                       t-att-value="hours_values.get('opens') or '10:00'"/>
                <input type="time" name="closes" class="form-control w-auto" dir="ltr"
                       t-att-value="hours_values.get('closes') or '18:00'"/>
                <!-- Spelt out, unlike the two time boxes: a bare number next to a
                     clock reads as minutes. Defaulted to one so an owner who
                     ignores it keeps the week she already had. min="1" is the
                     browser's half of the check — the route re-checks it, because
                     a hand-made POST is not obliged to obey an attribute. -->
                <label class="d-flex align-items-center gap-2 mb-0" for="capacity">
                    <span class="text-muted">How many fittings at once</span>
                    <input type="number" id="capacity" name="capacity" min="1" step="1"
                           t-att-value="hours_values.get('capacity') or '1'"
                           dir="ltr" class="form-control w-auto"
                           style="max-width: 5.5rem;"/>
                </label>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <p t-if="not hours" class="modryn_empty">
                Nothing set yet — the booking page has no times to offer. Add your first day above.
            </p>

            <table t-if="hours" class="table modryn_table align-middle" style="max-width: 640px;">
                <thead>
                    <tr><th>Day</th><th>Opens</th><th>Closes</th><th>At once</th><th/></tr>
                </thead>
                <tbody>
                    <tr t-foreach="hours" t-as="h"
                        t-attf-class="#{'modryn_archived' if not h['active'] else ''}">
                        <td t-out="h['day']"/>
                        <td dir="ltr" t-out="h['opens']"/>
                        <td dir="ltr" t-out="h['closes']"/>
                        <!-- Editable in place. Every window a boutique owns was
                             seeded at one fitting, and a window's day and start
                             time cannot be re-used, so a read-only cell here
                             would mean the number could never be corrected. -->
                        <td dir="ltr">
                            <form t-attf-action="/manage/hours/capacity/#{h['id']}" method="post"
                                  class="d-flex align-items-center gap-1">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <input type="number" name="capacity" min="1" max="20" step="1"
                                       class="form-control form-control-sm" style="width: 4.5rem"
                                       t-att-value="h['capacity']"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">Save</button>
                            </form>
                        </td>
                        <td class="text-end">
                            <form t-attf-action="/manage/hours/archive/#{h['id']}" method="post"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="h['active']">Close</t>
                                    <t t-else="">Open again</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>

            <h2 class="h4 mt-5 mb-2">Days you are closed</h2>
            <p class="text-muted mb-4">
                A holiday, a wedding, stocktaking. A closed date disappears from the
                booking page completely — no times, and no waitlist either, because
                there is nothing to queue for. Leave the second date empty to close
                a single day.
                <br/>
                To shut only part of a day — you close at 14:00 for a wedding —
                fill in the two times as well. The day still appears, offering the
                hours you are open.
            </p>

            <form action="/manage/hours/closure/new" method="post"
                  class="d-flex gap-2 mb-4 flex-wrap" style="max-width: 640px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <!-- t-att-value on all five: a rejected attempt comes back
                     through the session, and being told one date is wrong is
                     not a reason to take back the reason, the other date and
                     both times. On a normal visit values is empty and the form
                     opens blank exactly as it always did. -->
                <input type="text" name="name" class="form-control w-auto"
                       t-att-value="hours_values.get('name')"
                       placeholder="What for?"/>
                <!-- type="date" so the browser supplies the calendar and the
                     format, exactly as type="time" does for the windows above. -->
                <input type="date" name="date_from" class="form-control w-auto" dir="ltr"
                       t-att-value="hours_values.get('date_from')"/>
                <input type="date" name="date_to" class="form-control w-auto" dir="ltr"
                       t-att-value="hours_values.get('date_to')"/>
                <!-- Leave both empty for the whole day, which is what a closure
                     has always been. Fill both to shut only part of it: the day
                     still appears on /book with the hours that remain. One
                     without the other is treated as a half-typed form, not as
                     "from 14:00 until whenever". -->
                <input type="time" name="start_hour" class="form-control w-auto" dir="ltr"
                       t-att-value="hours_values.get('start_hour')"
                       aria-label="Closed from"/>
                <input type="time" name="end_hour" class="form-control w-auto" dir="ltr"
                       t-att-value="hours_values.get('end_hour')"
                       aria-label="Closed until"/>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <p t-if="not closures" class="modryn_empty">
                No closed days — the booking page offers every day above.
            </p>

            <table t-if="closures" class="table modryn_table align-middle"
                   style="max-width: 640px;">
                <thead>
                    <tr><th>Reason</th><th>Dates</th><th>Hours</th><th/></tr>
                </thead>
                <tbody>
                    <tr t-foreach="closures" t-as="c"
                        t-attf-class="#{'modryn_archived' if not c['active'] else ''}">
                        <td t-out="c['name']"/>
                        <td dir="ltr" t-out="c['when']"/>
                        <!-- Blank means the whole day. Saying "All day" in every
                             ordinary row would bury the part-day ones, which are
                             the only rows where the hours carry information. -->
                        <td dir="ltr" class="modryn_sub" t-out="c['hours']"/>
                        <td class="text-end">
                            <form t-attf-action="/manage/hours/closure/archive/#{c['id']}"
                                  method="post" class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="c['active']">Open again</t>
                                    <t t-else="">Close again</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
            </section>

            <!-- ===================== what has been said ===================== -->
            <section t-if="view == 'announce'" class="modryn_panel">
                <header class="modryn_panel_head">
                    <h2>Already sent</h2>
                    <span class="modryn_count" t-out="len(announcements)"/>
                </header>

                <p t-if="not announcements" class="modryn_empty">
                    Nothing has been sent yet.
                </p>

                <!-- A column, not the card grid the rest of the product uses.
                     What is on these cards is a SENTENCE, and a sentence in a
                     240px column is four words a line. -->
                <div class="modryn_sent_list">
                    <article t-foreach="announcements" t-as="a" t-key="a['id']"
                             class="modryn_card modryn_announcement">
                        <div class="modryn_card_marks">
                            <span t-if="a['everyone']" class="modryn_badge is_free">Everyone</span>
                            <span t-else="" class="modryn_badge is_muted" t-out="a['to']"/>
                            <span class="modryn_sub ms-auto" dir="ltr" t-out="a['at']"/>
                        </div>
                        <p class="mb-2" t-out="a['body']"/>
                        <div class="modryn_sub" t-if="a['author']" t-out="a['author']"/>
                        <!-- Unsend, not hide. It takes the message off the bells
                             it already rang - a manager who regrets an
                             announcement has not un-sent it by removing it from
                             her own list. -->
                        <form action="/manage/team-screen/unsend" method="post"
                              class="modryn_card_actions">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="announcement_id" t-att-value="a['id']"/>
                            <button type="submit" class="btn btn-sm btn-outline-dark">
                                Take it back
                            </button>
                        </form>
                    </article>
                </div>
            </section>
        </t>
    </template>

</odoo>
