<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== the shift supervisor's screen ==================== -->
    <template id="shift_supervisor" name="MODRYN shift supervisor">
        <t t-call="modryn_staff.staff_layout">
            <t t-set="active_tab" t-value="'supervisor'"/>
            <t t-set="additional_title">Shift supervisor</t>

            <div class="d-flex align-items-baseline justify-content-between mb-1">
                <h1 class="mb-0">Shift supervisor</h1>
                <span class="modryn_sub" dir="ltr" t-out="day_label"/>
            </div>
            <p class="text-muted mb-4">
                Who is on the floor, since when, and who they are with.
            </p>

            <!-- Somebody has put her hand up. ABOVE the unclaimed queue and
                 above the team, because everything else on this page can wait a
                 minute and this cannot: a stylist is standing in a fitting room
                 with a customer and a problem.
                 -->
            <section t-if="calls" class="modryn_panel modryn_super_calls mb-4">
                <header class="modryn_panel_head">
                    <h2>Someone needs help</h2>
                    <span class="modryn_count" t-out="len(calls)"/>
                </header>
                <div class="modryn_cards">
                    <div t-foreach="calls" t-as="c"
                         t-attf-class="modryn_card modryn_super_call #{'is_late' if c['escalated'] else ''}">
                        <div class="modryn_card_marks">
                            <span class="modryn_strong" t-out="c['caller']"/>
                            <span t-if="c['at']" class="modryn_badge is_muted"
                                  dir="ltr" t-out="c['at']"/>
                            <span t-if="c['state'] == 'acked'" class="modryn_badge is_free">On the way</span>
                            <span t-else="" class="modryn_badge is_busy">Waiting</span>
                        </div>
                        <!-- Where to go. The whole reason this record carries
                             context: "Dana needs help" sends a colleague across
                             a boutique asking questions. -->
                        <div t-if="c['where']" class="modryn_sub" t-out="c['where']"/>
                        <div t-if="c['note']" t-out="c['note']"/>
                        <div t-if="c['target']" class="modryn_sub">
                            <t t-out="c['target']"/>
                        </div>
                        <div t-if="c['acked_by']" class="modryn_sub" t-out="c['acked_by']"/>
                        <form action="/shift-supervisor/sos/resolve" method="post"
                              class="modryn_card_actions">
                            <input type="hidden" name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="call_id" t-att-value="c['id']"/>
                            <button type="submit" class="btn btn-sm btn-primary">Sorted</button>
                        </form>
                    </div>
                </div>
            </section>

            <!-- Work nobody has taken. First, because it is the only thing on
                 this screen that needs somebody to do something about it -
                 everything below is a record of what is already happening. -->
            <section t-if="unassigned" class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2>Waiting for somebody</h2>
                    <span class="modryn_count" t-out="unassigned_total"/>
                </header>
                <div class="modryn_cards">
                    <div t-foreach="unassigned" t-as="c" class="modryn_card">
                        <div class="modryn_strong" t-out="c['name']"/>
                        <div t-if="c['phone']" class="modryn_sub" dir="ltr" t-out="c['phone']"/>
                        <div class="modryn_card_marks">
                            <span t-if="c['kind'] == 'queue'" class="modryn_badge is_muted">Walk-in</span>
                            <span t-else="" class="modryn_badge is_muted">Booking</span>
                            <span t-if="c.get('time')" class="modryn_badge is_muted"
                                  dir="ltr" t-out="c['time']"/>
                        </div>
                    </div>
                </div>
                <p t-if="unassigned_note" class="modryn_sub mb-0" t-out="unassigned_note"/>
                <!-- Coming later with nobody on them. A number, not a list: the
                     floor board's appointments panel is where they get
                     assigned, and a second copy of it here would be a screen
                     arguing with itself. -->
                <p t-if="later_note" class="modryn_sub mb-0" t-out="later_note"/>
            </section>

            <div t-if="not rows" class="modryn_empty">Nobody on the team yet.</div>

            <div class="modryn_cards">
                <section t-foreach="rows" t-as="r"
                         t-attf-class="modryn_card modryn_super_card #{'is_on' if r['on_floor'] else ''}">
                    <div class="modryn_card_marks">
                        <span class="modryn_strong" t-out="r['name']"/>
                        <span t-if="r['on_floor']" class="modryn_badge is_free">On the floor</span>
                        <span t-else="" class="modryn_badge is_muted">Off</span>
                    </div>
                    <div t-if="r['roles']" class="modryn_sub" t-out="r['roles']"/>

                    <!-- When the rota says she should be here, next to when she
                         actually was. Both, or neither number means anything:
                         "came on at 10:14" is only late against a shift that
                         started at 10:00. -->
                    <div class="modryn_super_times">
                        <div>
                            <span class="modryn_sub d-block">Expected</span>
                            <t t-if="r['expected']">
                                <div t-foreach="r['expected']" t-as="sh">
                                    <strong dir="ltr">
                                        <t t-esc="sh['from']"/>–<t t-esc="sh['to']"/>
                                    </strong>
                                    <span class="modryn_sub" t-out="sh['name']"/>
                                </div>
                            </t>
                            <span t-else="" class="modryn_sub">Not on today's rota</span>
                        </div>
                        <div>
                            <span class="modryn_sub d-block">Actually</span>
                            <t t-if="r['spells']">
                                <!-- Already the LAST six, sliced on the server.
                                     Kept from the front, a card hid the stretch
                                     she is standing in - the "still on" line,
                                     which is the one fact this column is for. -->
                                <div t-foreach="r['spells']" t-as="sp">
                                    <strong dir="ltr" t-out="sp['in']"/>
                                    <t t-if="sp['out']">
                                        – <strong dir="ltr" t-out="sp['out']"/>
                                    </t>
                                    <span t-else="" class="modryn_sub"> — still on</span>
                                </div>
                                <!-- A day of coming and going runs to more lines
                                     than anybody reads, and the card below it is
                                     what she opened this screen for. -->
                                <div t-if="r['earlier']" class="modryn_sub" t-out="r['earlier']"/>
                            </t>
                            <span t-else="" class="modryn_sub">Has not come on today</span>
                        </div>
                    </div>

                    <div class="modryn_card_marks">
                        <span class="modryn_sub">With her now</span>
                        <span class="modryn_badge is_muted" t-out="r['count']"/>
                    </div>

                    <p t-if="not r['customers']" class="modryn_sub mb-0">Nobody right now.</p>
                    <div t-else="" class="modryn_super_clients">
                        <div t-foreach="r['customers']" t-as="c" class="modryn_super_client">
                            <div class="modryn_strong" t-out="c['name']"/>
                            <div class="modryn_card_marks">
                                <span t-if="c['kind'] == 'queue'" class="modryn_badge is_muted">Walk-in</span>
                                <span t-else="" class="modryn_badge is_muted">Booking</span>
                                <span t-if="c.get('time')" class="modryn_badge is_muted"
                                      dir="ltr" t-out="c['time']"/>
                                <span t-if="c['client_type'] == 'bride'" class="modryn_badge is_free">Bride</span>
                            </div>
                            <div t-if="c['phone']" class="modryn_sub" dir="ltr" t-out="c['phone']"/>
                            <div t-if="c['note']" class="modryn_sub" t-out="c['note']"/>
                            <div t-if="c['helpers']" class="modryn_sub">
                                <t t-esc="', '.join(c['helpers'])"/>
                            </div>

                            <!-- How the visit went. Five plain buttons and a
                                 line of text: a supervisor marks this while
                                 standing up, between two other things. -->
                            <form action="/shift-supervisor/rate" method="post"
                                  class="modryn_rate">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="kind" t-att-value="c['kind']"/>
                                <input type="hidden" name="record_id" t-att-value="c['id']"/>
                                <!-- FIRST, and that is the whole point of it.
                                     An <input> submits its form's first submit
                                     button when Enter is pressed, and that used
                                     to be the one-star button - so a supervisor
                                     typing a note and pressing Enter recorded
                                     the worst possible score without choosing
                                     it. This one carries the score already
                                     recorded, so Enter saves the words and
                                     changes nothing else. -->
                                <!-- str(), because t-att-value DROPS the
                                     attribute when the value is falsy - and an
                                     unrated visit is 0. It happens to survive
                                     that (a valueless submit posts an empty
                                     string, which parses back to 0), but this
                                     codebase has already been bitten once by
                                     the same line on the stock field, and a
                                     second copy of the pattern is an invitation
                                     to paste it somewhere it does matter. -->
                                <button type="submit" name="rating"
                                        t-att-value="str(c['rating'])"
                                        class="modryn_rate_save">Save the note</button>
                                <!-- The star's accessible name is "4 / 5", not
                                     "4 out of 5": the sentence form extracted as
                                     the msgid "{{0}} out of 5", which no
                                     translator can make sense of, and a fraction
                                     needs no words in any language. -->
                                <div class="modryn_rate_stars">
                                    <t t-foreach="[1, 2, 3, 4, 5]" t-as="n">
                                        <button type="submit" name="rating" t-att-value="n"
                                                t-attf-class="modryn_rate_star #{'is_on' if c['rating'] &gt;= n else ''}"
                                                t-attf-aria-label="#{n} / 5"
                                                t-attf-title="#{n} / 5">★</button>
                                    </t>
                                </div>
                                <input type="text" name="note" class="form-control form-control-sm"
                                       t-att-value="c['rating_note']"
                                       placeholder="Anything worth remembering?"/>
                            </form>
                        </div>
                    </div>

                    <!-- Hers, but not yet. Listed with the hour, and without a
                         rating form: there is nothing to judge about a visit
                         that has not happened. -->
                    <div t-if="r['later']" class="modryn_super_later">
                        <span class="modryn_sub">Later today</span>
                        <div t-foreach="r['later']" t-as="c" class="modryn_card_marks">
                            <span t-if="c['time']" class="modryn_badge is_muted"
                                  dir="ltr" t-out="c['time']"/>
                            <span t-else="" class="modryn_badge is_wait">Next</span>
                            <span t-out="c['name']"/>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>
