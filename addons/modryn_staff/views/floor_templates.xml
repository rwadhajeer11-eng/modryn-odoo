<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- THE chrome — every staff and owner page wears this one shell. There
         used to be two navs (this one and manage_layout's), plus three xpath
         injections racing for the same anchor, and which nav you got depended
         on the template the controller happened to pick — a manager clicking
         "Workshop" landed on the owner's links, every one a 404 for her. Now
         one template loops over the page registry (modryn_staff/nav.py),
         filtered per user by the owner's role→page matrix, and the nav is the
         same fixed thing on every page. Callers still set `active_tab`. -->
    <template id="staff_layout" name="MODRYN staff layout">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="true"/>
            <t t-set="no_footer" t-value="true"/>
            <t t-set="modryn_nav" t-value="request.env['modryn.role.page'].modryn_nav()"/>
            <!-- dir follows the user's language: staff screens are he (rtl) or
                 en (ltr) by per-user preference. -->
            <div id="wrap" t-att-dir="'ltr' if (request.env.lang or 'he_IL').startswith('en') else 'rtl'"
                 class="modryn_admin">
                <nav class="modryn_admin_nav">
                    <span class="modryn_admin_brand">MODRYN</span>
                    <!-- Icon then label, both inside the link. The icon is
                         aria-hidden because the label right next to it already
                         names the destination; announcing both would read the
                         page twice to a screen reader. On phones the label is
                         hidden by CSS and the icon carries the meaning, so the
                         label keeps a title attribute for the tooltip. -->
                    <a t-foreach="modryn_nav['staff']" t-as="entry"
                       t-att-href="entry['url']"
                       t-att-title="entry['label']"
                       t-attf-class="modryn_admin_link #{'is_active' if active_tab == entry['key'] else ''}">
                        <i t-attf-class="fa #{entry['icon']} modryn_admin_icon" aria-hidden="true"/>
                        <span class="modryn_admin_label" t-out="entry['label']"/>
                    </a>
                    <t t-call="modryn_staff.lang_toggle"/>
                    <span class="modryn_admin_who">
                        <t t-out="request.env.user.name"/>
                    </span>
                    <a href="/staff/logout" class="modryn_admin_link modryn_admin_logout">Sign out</a>
                </nav>
                <!-- The owner's second row. Renders only when the manage section
                     returned entries — i.e. for the owner, and for nobody else. -->
                <nav t-if="modryn_nav['manage']" class="modryn_admin_nav">
                    <span class="modryn_admin_brand" aria-hidden="true" style="visibility:hidden;">MODRYN</span>
                    <a t-foreach="modryn_nav['manage']" t-as="entry"
                       t-att-href="entry['url']"
                       t-att-title="entry['label']"
                       t-attf-class="modryn_admin_link #{'is_active' if active_tab == entry['key'] else ''}">
                        <i t-attf-class="fa #{entry['icon']} modryn_admin_icon" aria-hidden="true"/>
                        <span class="modryn_admin_label" t-out="entry['label']"/>
                    </a>
                </nav>
                <main class="modryn_admin_main">
                    <t t-out="0"/>
                </main>
            </div>
        </t>
    </template>

    <!-- The themed refusal. Wears the unified nav ON PURPOSE: the message that
         says "not this page" also shows exactly which pages she does have. -->
    <template id="no_access" name="MODRYN no access">
        <t t-call="modryn_staff.staff_layout">
            <div class="container py-5 text-center" style="max-width: 520px;">
                <h1 class="mb-3">This page isn't yours to open</h1>
                <p class="text-muted">
                    Your role doesn't include this page. The links above are the
                    ones that belong to you — if this page should be one of them,
                    ask the owner to grant it to your role.
                </p>
            </div>
        </t>
    </template>

    <template id="floor_page" name="MODRYN floor terminal">
        <t t-call="modryn_staff.staff_layout">
            <t t-set="active_tab" t-value="'floor'"/>
            <!-- The board is an OWL component so it can hold a live bus
                 subscription. Mounted by web's public_components interaction,
                 which scans for <owl-component name=...>. -->
            <owl-component name="modryn_staff.floor_board"/>
            <noscript>
                <p class="modryn_empty">The floor board needs JavaScript.</p>
            </noscript>
        </t>
    </template>

</odoo>
