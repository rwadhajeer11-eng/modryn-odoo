<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Odoo 19 moved group grouping off res.groups.category_id and onto a
            res.groups.privilege record (category_id now lives on the privilege).
            Using category_id here fails the whole install with
            "Invalid field 'category_id' in 'res.groups'".
        -->
        <record id="privilege_boutique" model="res.groups.privilege">
            <field name="name">Boutique</field>
            <field name="sequence">20</field>
        </record>

        <!--
            Three levels, each implying the one below it.

            CRITICAL: none of these may imply base.group_user. Odoo enforces that
            a user is portal OR internal, never both, and managers and staff are
            portal users. Implying group_user here would make every staff account
            an internal (billable) seat and break that constraint.
        -->
        <record id="group_boutique_staff" model="res.groups">
            <field name="name">Staff</field>
            <field name="privilege_id" ref="privilege_boutique"/>
            <field name="sequence">10</field>
            <field name="comment">Sees her own assignments on the floor terminal.</field>
        </record>

        <record id="group_shift_manager" model="res.groups">
            <field name="name">Shift manager</field>
            <field name="privilege_id" ref="privilege_boutique"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_boutique_staff'))]"/>
            <field name="comment">Assigns staff to customers and dispatches the walk-in queue.</field>
        </record>

        <record id="group_boutique_owner" model="res.groups">
            <field name="name">Boutique owner</field>
            <field name="privilege_id" ref="privilege_boutique"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_shift_manager'))]"/>
            <field name="comment">Adds employees, defines roles, and everything a manager can do.</field>
        </record>

    </data>
</odoo>
