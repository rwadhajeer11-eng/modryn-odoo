<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="modryn_staff.FloorBoard">
        <div class="modryn_floor" dir="rtl">

            <div t-if="state.error" class="modryn_field_error mb-3" role="alert">
                אין הרשאה להצגת המסך.
            </div>

            <div class="modryn_floor_grid">

                <!-- ============ walk-in queue ============ -->
                <section class="modryn_panel">
                    <header class="modryn_panel_head">
                        <h2>תור בכניסה</h2>
                        <span class="modryn_count"><t t-esc="waitingCount"/> ממתינות</span>
                    </header>

                    <p t-if="!state.queue.length" class="modryn_empty">אין לקוחות בתור.</p>

                    <table t-else="" class="table modryn_table align-middle">
                        <tbody>
                            <tr t-foreach="state.queue" t-as="entry" t-key="entry.id">
                                <td class="modryn_pos"><t t-esc="entry.position"/></td>
                                <td>
                                    <div class="modryn_strong"><t t-esc="entry.name"/></div>
                                    <div class="modryn_sub" dir="ltr"><t t-esc="entry.phone"/></div>
                                </td>
                                <td>
                                    <span class="modryn_badge is_muted">
                                        <t t-esc="entry.client_type === 'bride' ? 'כלה' : 'ערב'"/>
                                    </span>
                                </td>
                                <td>
                                    <span t-if="entry.state === 'waiting'" class="modryn_badge is_wait">ממתינה</span>
                                    <span t-else="" class="modryn_badge is_busy">
                                        מטפלת ב: <t t-esc="entry.employee_name"/>
                                    </span>
                                </td>
                                <td class="text-end" style="min-width: 14rem;">
                                    <t t-if="state.canAssign">
                                        <select class="form-select form-select-sm d-inline-block w-auto"
                                                t-on-change="(ev) => this.assignQueue(entry.id, ev)">
                                            <option value="">— שיוך —</option>
                                            <t t-foreach="state.staff" t-as="s" t-key="s.id">
                                                <option t-att-value="s.id"
                                                        t-att-selected="s.id === entry.employee_id ? 'selected' : undefined">
                                                    <t t-esc="s.name"/>
                                                </option>
                                            </t>
                                        </select>
                                        <button class="btn btn-sm btn-outline-dark ms-1"
                                                t-on-click="() => this.finish(entry.id)">סיום</button>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <!-- ============ today's bookings ============ -->
                <section class="modryn_panel">
                    <header class="modryn_panel_head">
                        <h2>תורים להיום</h2>
                        <span class="modryn_count"><t t-esc="state.bookings.length"/></span>
                    </header>

                    <p t-if="!state.bookings.length" class="modryn_empty">אין תורים להיום.</p>

                    <table t-else="" class="table modryn_table align-middle">
                        <tbody>
                            <tr t-foreach="state.bookings" t-as="b" t-key="b.id">
                                <td class="modryn_pos"><t t-esc="b.time"/></td>
                                <td>
                                    <div class="modryn_strong"><t t-esc="b.title"/></div>
                                    <div class="modryn_sub" dir="ltr"><t t-esc="b.phone"/></div>
                                </td>
                                <td>
                                    <t t-if="b.dress">
                                        <div class="modryn_sub">
                                            <t t-esc="b.dress"/>
                                            <t t-if="b.size"> · <t t-esc="b.size"/></t>
                                        </div>
                                    </t>
                                </td>
                                <td class="text-end" style="min-width: 12rem;">
                                    <t t-if="state.canAssign">
                                        <select class="form-select form-select-sm d-inline-block w-auto"
                                                t-on-change="(ev) => this.assignBooking(b.id, ev)">
                                            <option value="">— שיוך —</option>
                                            <t t-foreach="state.staff" t-as="s" t-key="s.id">
                                                <option t-att-value="s.id"
                                                        t-att-selected="s.id === b.employee_id ? 'selected' : undefined">
                                                    <t t-esc="s.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </t>
                                    <span t-elif="b.employee_name" class="modryn_badge is_busy">
                                        <t t-esc="b.employee_name"/>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <!-- ============ staff roster ============ -->
                <section class="modryn_panel">
                    <header class="modryn_panel_head">
                        <h2>צוות במשמרת</h2>
                        <span class="modryn_count"><t t-esc="freeCount"/> פנויות</span>
                    </header>

                    <p t-if="!state.staff.length" class="modryn_empty">אין עובדות מוגדרות.</p>

                    <div class="modryn_staff_cards">
                        <div t-foreach="state.staff" t-as="s" t-key="s.id"
                             t-attf-class="modryn_staff_card #{s.occupied ? 'is_busy' : 'is_free'}">
                            <div class="modryn_strong"><t t-esc="s.name"/></div>
                            <div class="modryn_sub"><t t-esc="s.role"/></div>
                            <!-- Text, not colour alone: status must survive a
                                 colour-blind reader and a greyscale screen. -->
                            <div class="modryn_status">
                                <t t-if="s.occupied">תפוסה</t>
                                <t t-else="">פנויה</t>
                            </div>
                            <div t-if="s.occupied and s.occupied_with" class="modryn_sub">
                                מטפלת ב: <t t-esc="s.occupied_with"/>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </div>
    </t>

</templates>
