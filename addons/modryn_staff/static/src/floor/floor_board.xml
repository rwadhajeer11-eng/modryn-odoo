<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- A customer card's people: the primary slot + helper chips. Chips are
         draggable (managers only — the hook is disabled otherwise); the primary
         slot is its own drop zone so dropping there swaps rather than adds. -->
    <t t-name="modryn_staff.CardPeople">
        <div class="modryn_card_people">
            <div class="modryn_primary_slot"
                 t-att-data-drop-target="kind" t-att-data-drop-id="card.id"
                 data-drop-primary="1">
                <span t-if="card.employee_id" class="modryn_chip is_primary"
                      t-att-data-employee="card.employee_id">
                    <t t-esc="card.employee_name"/>
                </span>
                <span t-else="" class="modryn_slot_empty">Primary</span>
            </div>
            <t t-foreach="card.helpers" t-as="h" t-key="h.id">
                <span class="modryn_chip is_helper" t-att-data-employee="h.id">
                    <t t-esc="h.name"/>
                </span>
            </t>
        </div>
    </t>

    <t t-name="modryn_staff.FloorBoard">
        <div class="modryn_floor" t-ref="root"
             t-att-class="state.dragging ? 'is_dragging' : ''">

            <div t-if="state.error" class="modryn_field_error mb-3" role="alert">
                <t t-esc="state.error"/>
            </div>

            <!-- My own call stays here rather than in the overlay: I raised it,
                 I need to see whether anyone picked it up — not be blocked by it. -->
            <div t-foreach="myOwnSos" t-as="c" t-key="c.id" class="modryn_sos_mine mb-3">
                <span>
                    <t t-if="c.state === 'acked'">Someone is on the way.</t>
                    <t t-else="">Waiting for someone to answer…</t>
                    <t t-if="c.escalated"> Passed to the managers.</t>
                </span>
                <button class="btn btn-sm btn-outline-dark"
                        t-on-click="() => this.resolveSos(c.id)">All good now</button>
            </div>

            <div class="modryn_floor_layout">
                <div class="modryn_floor_main">

                    <!-- ====== arrivals: asked to be seen, not yet in line ======
                         The gate the customer never sees. Her page says "we'll be
                         with you soon" from the moment she scans, whichever way
                         this goes. -->
                    <section t-if="state.pending.length" class="modryn_panel modryn_pending">
                        <header class="modryn_panel_head">
                            <h2>Just arrived</h2>
                            <span class="modryn_count"><t t-esc="state.pending.length"/></span>
                        </header>
                        <table class="table modryn_table align-middle">
                            <tbody>
                                <tr t-foreach="state.pending" t-as="p" t-key="p.id">
                                    <td>
                                        <div class="modryn_strong"><t t-esc="p.name"/></div>
                                        <div class="modryn_sub" dir="ltr"><t t-esc="p.phone"/></div>
                                    </td>
                                    <td>
                                        <span class="modryn_badge is_muted">
                                            <t t-esc="clientTypeLabel(p)"/>
                                        </span>
                                    </td>
                                    <td t-if="state.canAssign" class="text-end">
                                        <button class="btn btn-sm btn-primary me-2"
                                                t-on-click="() => this.acceptPending(p.id)">
                                            Add to the line
                                        </button>
                                        <button class="btn btn-sm btn-outline-dark"
                                                t-on-click="() => this.redirectPending(p.id)">
                                            Invite to book
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </section>

                    <!-- ============ walk-in queue ============ -->
                    <section class="modryn_panel">
                        <header class="modryn_panel_head">
                            <h2>Walk-in queue</h2>
                            <span class="modryn_count"><t t-esc="waitingCount"/> waiting</span>
                        </header>

                        <p t-if="!state.queue.length" class="modryn_empty">No one is waiting.</p>

                        <div class="modryn_cards">
                            <div t-foreach="state.queue" t-as="entry" t-key="entry.id"
                                 class="modryn_customer_card"
                                 data-drop-target="queue" t-att-data-drop-id="entry.id">
                                <div class="modryn_card_top">
                                    <span class="modryn_pos"><t t-esc="entry.position"/></span>
                                    <div>
                                        <div class="modryn_strong"><t t-esc="entry.name"/></div>
                                        <div class="modryn_sub" dir="ltr"><t t-esc="entry.phone"/></div>
                                    </div>
                                    <span class="modryn_badge is_muted ms-auto">
                                        <t t-esc="clientTypeLabel(entry)"/>
                                    </span>
                                    <span t-if="entry.state === 'waiting'" class="modryn_badge is_wait">Waiting</span>
                                    <span t-else="" class="modryn_badge is_busy">Being served</span>
                                </div>

                                <t t-call="modryn_staff.CardPeople">
                                    <t t-set="card" t-value="entry"/>
                                    <t t-set="kind" t-value="'queue'"/>
                                </t>

                                <div class="modryn_card_actions">
                                    <select class="form-select form-select-sm w-auto"
                                            t-att-value="entry.room_id or ''"
                                            t-on-change="(ev) => this.setRoom('queue', entry.id, ev)">
                                        <option value="">— No room —</option>
                                        <t t-foreach="state.rooms" t-as="r" t-key="r.id">
                                            <option t-att-value="r.id"
                                                    t-att-selected="r.id === entry.room_id"><t t-esc="r.name"/></option>
                                        </t>
                                    </select>
                                    <button class="btn btn-sm btn-outline-danger"
                                            t-on-click="() => this.openSos('queue', entry.id)">
                                        Call for help
                                    </button>
                                </div>
                                <div t-if="state.canAssign" class="modryn_card_actions">
                                    <!-- Click fallback: dragging is faster, but a
                                         keyboard or a stubborn tablet still works. -->
                                    <select class="form-select form-select-sm w-auto"
                                            t-on-change="(ev) => this.assignFromSelect('queue', entry.id, ev)">
                                        <option value="">— Assign —</option>
                                        <t t-foreach="state.staff" t-as="s" t-key="s.id">
                                            <option t-att-value="s.id"><t t-esc="s.name"/></option>
                                        </t>
                                    </select>
                                    <button class="btn btn-sm btn-primary"
                                            t-on-click="() => this.finish(entry.id)">Done</button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ============ today's appointments ============ -->
                    <section class="modryn_panel">
                        <header class="modryn_panel_head">
                            <h2>Today's appointments</h2>
                            <span class="modryn_count"><t t-esc="state.bookings.length"/></span>
                        </header>

                        <p t-if="!state.bookings.length" class="modryn_empty">No appointments today.</p>

                        <div class="modryn_cards">
                            <div t-foreach="state.bookings" t-as="b" t-key="b.id"
                                 class="modryn_customer_card"
                                 data-drop-target="booking" t-att-data-drop-id="b.id">
                                <div class="modryn_card_top">
                                    <span class="modryn_pos"><t t-esc="b.time"/></span>
                                    <div>
                                        <div class="modryn_strong"><t t-esc="b.title"/></div>
                                        <div class="modryn_sub" dir="ltr"><t t-esc="b.phone"/></div>
                                        <div t-if="b.dress" class="modryn_sub">
                                            <t t-esc="b.dress"/><t t-if="b.size"> · <t t-esc="b.size"/></t>
                                        </div>
                                    </div>
                                </div>

                                <t t-call="modryn_staff.CardPeople">
                                    <t t-set="card" t-value="b"/>
                                    <t t-set="kind" t-value="'booking'"/>
                                </t>

                                <div class="modryn_card_actions">
                                    <select class="form-select form-select-sm w-auto"
                                            t-att-value="b.room_id or ''"
                                            t-on-change="(ev) => this.setRoom('booking', b.id, ev)">
                                        <option value="">— No room —</option>
                                        <t t-foreach="state.rooms" t-as="r" t-key="r.id">
                                            <option t-att-value="r.id"
                                                    t-att-selected="r.id === b.room_id"><t t-esc="r.name"/></option>
                                        </t>
                                    </select>
                                    <button class="btn btn-sm btn-outline-danger"
                                            t-on-click="() => this.openSos('booking', b.id)">
                                        Call for help
                                    </button>
                                </div>
                                <div t-if="state.canAssign" class="modryn_card_actions">
                                    <select class="form-select form-select-sm w-auto"
                                            t-on-change="(ev) => this.assignFromSelect('booking', b.id, ev)">
                                        <option value="">— Assign —</option>
                                        <t t-foreach="state.staff" t-as="s" t-key="s.id">
                                            <option t-att-value="s.id"><t t-esc="s.name"/></option>
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- ============ my alterations (seamstress self-view) ============ -->
                    <section t-if="state.myTasks.length" class="modryn_panel">
                        <header class="modryn_panel_head">
                            <h2>My alterations</h2>
                            <span class="modryn_count"><t t-esc="state.myTasks.length"/></span>
                        </header>
                        <table class="table modryn_table align-middle">
                            <tbody>
                                <tr t-foreach="state.myTasks" t-as="task" t-key="task.id">
                                    <td>
                                        <div class="modryn_strong"><t t-esc="task.customer"/></div>
                                        <div t-if="task.dress" class="modryn_sub">
                                            <t t-esc="task.dress"/><t t-if="task.size"> · <t t-esc="task.size"/></t>
                                        </div>
                                    </td>
                                    <td>
                                        <span t-foreach="task.pieces" t-as="p" t-key="p"
                                              class="modryn_badge is_muted me-1"><t t-esc="p"/></span>
                                        <div t-if="task.note" class="modryn_sub"><t t-esc="task.note"/></div>
                                    </td>
                                    <td>
                                        <span t-attf-class="modryn_badge #{task.overdue ? 'is_busy' : 'is_muted'}">
                                            <t t-esc="task.due"/>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button t-if="task.state === 'intake'"
                                                class="btn btn-sm btn-primary"
                                                t-on-click="() => this.advanceTask(task.id, 'in_progress')">
                                            Start
                                        </button>
                                        <button t-if="task.state === 'in_progress'"
                                                class="btn btn-sm btn-primary"
                                                t-on-click="() => this.advanceTask(task.id, 'ready')">
                                            Ready
                                        </button>
                                        <span t-if="task.state === 'ready'" class="modryn_badge is_free">
                                            Ready
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </section>
                </div>

                <!-- ============ the bench: who is on shift, live ============ -->
                <aside class="modryn_bench" data-drop-target="bench">
                    <header class="modryn_panel_head">
                        <h2>Team on shift</h2>
                        <span class="modryn_count"><t t-esc="freeCount"/> available</span>
                    </header>
                    <p t-if="!state.staff.length" class="modryn_empty">No team members have been set up yet.</p>
                    <div class="modryn_bench_list">
                        <div t-foreach="state.staff" t-as="s" t-key="s.id"
                             t-attf-class="modryn_bench_row #{s.occupied ? 'is_busy' : 'is_free'}">
                            <span class="modryn_chip" t-att-data-employee="s.id">
                                <t t-esc="s.name"/>
                            </span>
                            <div class="modryn_bench_meta">
                                <span class="modryn_sub" t-esc="s.role"/>
                                <!-- Text, not colour alone: status must survive a
                                     colour-blind reader and a greyscale screen. -->
                                <span class="modryn_status">
                                    <t t-if="s.occupied">Busy</t>
                                    <t t-else="">Available</t>
                                </span>
                                <span t-if="s.occupied and s.occupied_with" class="modryn_sub">
                                    · <t t-esc="s.occupied_with"/>
                                </span>
                            </div>
                        </div>
                    </div>
                    <p t-if="state.canAssign" class="modryn_sub mt-2 mb-0">
                        Drag a name onto a customer to assign her.
                    </p>
                </aside>
            </div>

            <!-- ============ someone needs help, right now ============
                 Full-screen and unmissable on purpose. A toast in the corner is
                 exactly what a woman holding a dress with both hands misses. -->
            <div t-if="incomingSos.length" class="modryn_sos_overlay" role="alert">
                <div class="modryn_sos_card">
                    <t t-set="c" t-value="incomingSos[0]"/>
                    <p class="modryn_sos_kicker">
                        <t t-if="c.escalated">No one answered</t>
                        <t t-else="">Someone needs help</t>
                    </p>
                    <h2 class="modryn_sos_who"><t t-esc="c.caller_name"/></h2>
                    <p t-if="c.where" class="modryn_sos_where"><t t-esc="c.where"/></p>
                    <p t-if="c.note" class="modryn_sos_note"><t t-esc="c.note"/></p>
                    <div class="modryn_sos_actions">
                        <button t-if="c.state === 'open'" class="btn btn-primary btn-lg"
                                t-on-click="() => this.ackSos(c.id)">On my way</button>
                        <button t-else="" class="btn btn-primary btn-lg" disabled="disabled">
                            On the way
                        </button>
                        <button class="btn btn-outline-dark btn-lg"
                                t-on-click="() => this.resolveSos(c.id)">Handled</button>
                    </div>
                    <p t-if="incomingSos.length > 1" class="modryn_sub mt-3">
                        <t t-esc="incomingSos.length - 1"/> more waiting.
                    </p>
                </div>
            </div>

            <!-- ============ compose a call for help ============ -->
            <div t-if="state.sosForm" class="modryn_modal_backdrop" t-on-click.self="closeSos">
                <div class="modryn_modal" role="dialog" aria-modal="true">
                    <h2 class="mb-3">Who do you need?</h2>
                    <div class="mb-3">
                        <select class="form-select" t-model="state.sosForm.target_id">
                            <option value="">Any manager</option>
                            <t t-foreach="colleagues" t-as="s" t-key="s.id">
                                <option t-att-value="s.id">
                                    <t t-esc="s.name"/><t t-if="s.occupied"> (busy)</t>
                                </option>
                            </t>
                        </select>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control" t-model="state.sosForm.note"
                               placeholder="What do you need? (optional)"/>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-danger" t-on-click="sendSos">Call for help</button>
                        <button class="btn btn-outline-dark" t-on-click="closeSos">Cancel</button>
                    </div>
                </div>
            </div>

            <!-- ============ finish modal: fitting done -> alteration task ============ -->
            <div t-if="state.finish" class="modryn_modal_backdrop" t-on-click.self="closeFinish">
                <div class="modryn_modal" role="dialog" aria-modal="true">
                    <h2 class="mb-1">Alterations for <t t-esc="state.finish.customer"/>?</h2>
                    <p class="modryn_sub mb-3">
                        If the gown needs work, open a task for the workshop. Otherwise just skip.
                    </p>

                    <div class="mb-3">
                        <label class="form-label">Dress</label>
                        <select class="form-select" t-model="state.finish.form.variant_id">
                            <option value="">— Choose a dress —</option>
                            <t t-foreach="state.finish.variants" t-as="v" t-key="v.id">
                                <option t-att-value="v.id"><t t-esc="v.label"/></option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Pieces to alter</label>
                        <div class="modryn_piece_grid">
                            <label t-foreach="state.atelier.pieces" t-as="p" t-key="p.id"
                                   class="modryn_piece_check">
                                <input type="checkbox"
                                       t-on-change="(ev) => this.togglePiece(p.id, ev)"/>
                                <span t-esc="p.name"/>
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Instructions</label>
                        <textarea class="form-control" rows="2" t-model="state.finish.form.note"/>
                    </div>

                    <div class="modryn_modal_row mb-4">
                        <div>
                            <label class="form-label">Seamstress</label>
                            <select class="form-select" t-model="state.finish.form.seamstress_id">
                                <option value="">— Later —</option>
                                <t t-foreach="seamstresses" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id"><t t-esc="s.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Due</label>
                            <input type="date" class="form-control" t-model="state.finish.form.due_date"/>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" t-on-click="createTask">Create task</button>
                        <button class="btn btn-link" t-on-click="closeFinish">Skip</button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
