"                    <span class=\"modryn_strong\">Opening hours</span>\n"
"                    <span class=\"modryn_sub\">When the boutique takes fittings, and the days it closes.</span>"
msgstr ""
"<i class=\"fa fa-clock-o\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">ساعات الفتح</span>\n"
"                    <span class=\"modryn_sub\">إمتى البوتيك بياخد قياسات، والأيام الي بيسكّر فيها.</span>"

#. module: modryn_staff
#: model_terms:ir.ui.view,arch_db:modryn_staff.manager_screen
msgid ""
"<i class=\"fa fa-building\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">Fitting rooms</span>\n"
"                    <span class=\"modryn_sub\">The rooms a customer can be shown into.</span>"
msgstr ""
"<i class=\"fa fa-building\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">غرف القياس</span>\n"
"                    <span class=\"modryn_sub\">الغرف الي بتقدري تدخّلي فيها زبونة.</span>"

