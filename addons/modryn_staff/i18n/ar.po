"<i class=\"fa fa-archive\" aria-hidden=\"true\"/>\n"
"                        مَن غادرت"

#. module: modryn_staff
#: model_terms:ir.ui.view,arch_db:modryn_staff.manager_screen
msgid ""
"<i class=\"fa fa-arrow-left\" aria-hidden=\"true\"/>\n"
"                        Back to the team"
msgstr ""
"<i class=\"fa fa-arrow-left\" aria-hidden=\"true\"/>\n"
"                        رجوع للطاقم"

#. module: modryn_staff
#: model_terms:ir.ui.view,arch_db:modryn_staff.manager_screen
msgid ""
"<i class=\"fa fa-clock-o\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">Hours worked</span>\n"
"                    <span class=\"modryn_sub\">Who was on the floor, month by month — and fix it when the button was missed.</span>"
msgstr ""
"<i class=\"fa fa-clock-o\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">ساعات العمل</span>\n"
"                    <span class=\"modryn_sub\">مَن كانت على الأرض، شهرًا بشهر — وتصحيحها إذا لم يُضغط الزر.</span>"

