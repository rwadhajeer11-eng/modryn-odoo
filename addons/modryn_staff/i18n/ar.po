#. module: modryn_staff
#: model_terms:ir.ui.view,arch_db:modryn_staff.manager_screen
msgid ""
"<i class=\"fa fa-bullhorn\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">Tell the team</span>\n"
"                    <span class=\"modryn_sub\">A message to everybody, or to one of them.</span>"
msgstr ""
"<i class=\"fa fa-bullhorn\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">رسالة للطاقم</span>\n"
"                    <span class=\"modryn_sub\">رسالة للكل، أو لوحدة منهن.</span>"

#. module: modryn_staff
#: model_terms:ir.ui.view,arch_db:modryn_staff.staff_profile
msgid ""
"<i class=\"fa fa-clock-o\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">My hours</span>\n"
"                    <span class=\"modryn_sub\">\n"
"                        How long you were on the floor, day by day.\n"
"                    </span>"
msgstr ""
"<i class=\"fa fa-clock-o\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">ساعاتي</span>\n"
"                    <span class=\"modryn_sub\">\n"
"                        قدّيش كنتِ بالوردية، يوم بيوم.\n"
"                    </span>"

#. module: modryn_staff
#: model_terms:ir.ui.view,arch_db:modryn_staff.staff_profile
msgid ""
"<i class=\"fa fa-user\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">My details</span>\n"
"                    <span class=\"modryn_sub\">\n"
"                        Your name, your phone, your language — and the papers the\n"
"                        boutique holds for you.\n"
"                    </span>"
msgstr ""
"<i class=\"fa fa-user\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">تفاصيلي</span>\n"
"                    <span class=\"modryn_sub\">\n"
"                        اسمك، تلفونك ولغتك — والأوراق الي البوتيك حافظها\n"
"                        إلك.\n"
"                    </span>"

#. module: modryn_staff
#: model_terms:ir.ui.view,arch_db:modryn_staff.manager_screen
msgid ""
"<i class=\"fa fa-users\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">The team</span>\n"
"                    <span class=\"modryn_sub\">Who works here, and the papers on file.</span>"
msgstr ""
"<i class=\"fa fa-users\" aria-hidden=\"true\"/>\n"
"                    <span class=\"modryn_strong\">الطاقم</span>\n"
"                    <span class=\"modryn_sub\">مين بتشتغل هون، والأوراق بالملفّ.</span>"

#. module: modryn_staff
