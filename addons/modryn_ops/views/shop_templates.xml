<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Sold out, storefront side.

        modryn_sold_out was computed from the rail count and read by exactly one
        screen: the owner's. A bride could browse, and book a fitting for, a
        dress the boutique had none of in any size - which costs her a trip and
        the boutique an appointment slot, and neither of them finds out until she
        is standing in the room.

        These live in modryn_ops and NOT in modryn_theme with the shop's other
        overrides, even though that is where they would read most naturally. The
        field is defined here, and modryn_theme cannot depend on modryn_ops:
        modryn_ops -> modryn_portal -> modryn_theme already, so the arrow the
        other way is a cycle and the registry refuses to build. modryn_ops
        reaches website_sale through that same chain, so inheriting its
        templates from here works without adding any dependency at all.
    -->

    <!-- The shop grid tile. Both touch points are overridden for the same
         reason the price is: Odoo renders the tile and the detail page from
         different templates, and a badge on only one of them is a promise the
         other quietly breaks. -->
    <template id="products_item_sold_out"
              inherit_id="website_sale.products_item"
              name="MODRYN: sold out on the grid tile">
        <xpath expr="//div[hasclass('product_price')]" position="before">
            <div t-if="product.modryn_sold_out" class="modryn_sold_out_badge">
                <span>Sold out</span>
            </div>
        </xpath>
    </template>

    <template id="product_sold_out"
              inherit_id="website_sale.product_price"
              name="MODRYN: sold out on the product page">
        <xpath expr="//div[@name='product_price']" position="before">
            <div t-if="product.modryn_sold_out" class="modryn_sold_out_note mb-2">
                <span class="modryn_sold_out_badge"><span>Sold out</span></span>
                <!-- Not a dead end. This one has gone, and the boutique would
                     still rather she came in - a bridal shop sells the fitting,
                     not the rail. -->
                <div class="mt-1">
                    This one has gone. Come and see us — we will find you
                    something like it.
                </div>
            </div>
        </xpath>
    </template>

    <!--
        ONE FILTER, ONE BUTTON.

        Odoo's collection applies itself as you touch it: the size boxes
        auto-submit on change and the price slider navigates the moment it is
        released. Choosing a kind, then a size, then a price was three page
        loads, and the page jumped under her hand twice on the way. Nothing
        applies now until she presses the button, and then all of it does.

        WHAT KIND OF THING is asked first because it is the first question a
        bride has - "show me the evening dresses" - and Odoo's shop could not
        ask it at all: its filters know about product attributes and price and
        nothing else. The words come from the boutique's own list under
        שמלות ואקססוריז - סוגים, so one shop offers נסיכה and מרמייד and the
        next offers עדינה and צנועה.

        THE PRICE IS TWO PLAIN BOXES, not Odoo's slider - see the record that
        switches that off. A slider that applies itself on release cannot live
        inside a form that waits for a button.

        js_attributes is REMOVED from the form's class. That class is what
        Odoo's own handler binds the auto-submit to; leaving it and adding a
        button would give her both behaviours at once.

        Priority 30: this arch is only correct after website_sale's own
        products_attributes has put the attribute block in, and views are
        applied in priority order.
    -->
    <template id="products_kind_filter"
              inherit_id="website_sale.product_attribute_filters_form"
              priority="30"
              name="MODRYN: one filter with one button">

        <xpath expr="//form" position="attributes">
            <attribute name="t-attf-class">modryn_filter_form {{('accordion accordion-flush d-flex flex-column ' + ('border-bottom' if attributes else '')) if isMobile else 'position-relative mb-2'}}</attribute>
            <!-- The kind and the price are read off the query string, so the
                 form has to drop them or her old choice would ride along
                 beside the new one. -->
            <attribute name="t-att-action">keep(attribute_values=0, tags=0, kind=0, min_price=0, max_price=0)</attribute>
        </xpath>

        <xpath expr="//t[@t-set='visible_attributes']" position="before">
            <div t-if="modryn_kinds" class="nav-item mb-3 modryn_kind_filter">
                <h6 class="mb-3"><b class="d-none d-lg-block">Kind</b></h6>
                <div t-foreach="modryn_kinds" t-as="kind" class="form-check">
                    <input type="checkbox" name="kind" t-att-value="kind.id"
                           t-attf-id="modryn_kind_#{kind.id}"
                           class="form-check-input"
                           t-att-checked="'checked' if kind.id in modryn_kind_ids else None"/>
                    <label class="form-check-label" t-attf-for="modryn_kind_#{kind.id}"
                           t-out="kind.name"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//form" position="inside">
            <div class="nav-item mb-3 modryn_price_filter">
                <h6 class="mb-3"><b class="d-none d-lg-block">Price</b></h6>
                <div class="d-flex align-items-center gap-2">
                    <input type="number" name="min_price" min="0" step="1" dir="ltr"
                           class="form-control form-control-sm"
                           t-att-value="request.params.get('min_price') or ''"
                           placeholder="From"/>
                    <span class="text-muted">–</span>
                    <input type="number" name="max_price" min="0" step="1" dir="ltr"
                           class="form-control form-control-sm"
                           t-att-value="request.params.get('max_price') or ''"
                           placeholder="To"/>
                </div>
            </div>

            <!-- The one press. Big and in the boutique's own gold, because it
                 is the only thing on this rail that does anything. -->
            <button type="submit" class="btn btn-primary w-100 modryn_filter_go">
                Show these
            </button>
        </xpath>
    </template>

    <!--
        The search box above the collection, off.

        A bridal rail is thirty dresses on one page. Typing into a box is how
        you find something in a catalogue of thousands; here it is a box that
        finds nothing she could not already see, and it sat above the grid
        taking the eye first. The filters are the thing that helps.

        active="False" is the switch Odoo's own editor uses for this block, so
        this is that switch and not a rule painted over it.
    -->
    <record id="website_sale.search" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!--
        The magnifier in the header, off.

        The box above the collection went first; this is the same box in the
        header, on every page of the site. A bridal rail is thirty dresses and
        the filters find them; a search icon beside the heart is one more thing
        for a bride to wonder about and nothing she needs.

        active="False" is the switch Odoo's own editor uses for this block.
    -->
    <record id="website.header_search_box" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!--
        And Odoo's price slider, off with it. The filter is one form with one
        button now, and a slider that navigates the moment it is released
        cannot be part of that: it would apply itself while she was still
        choosing. Two plain boxes in the form say the same thing and wait.
    -->
    <record id="website_sale.filter_products_price" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

</odoo>
