<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The till. One form, one save: a sale is finished at a counter with
         somebody waiting, and a draft that fills up line by line leaves
         half-written receipts in the database for somebody to clean up. -->
    <template id="sell_screen" name="MODRYN sell">
        <t t-call="modryn_staff.staff_layout">
            <t t-set="active_tab" t-value="'sell'"/>

            <!-- TWO MODES, ONE COUNTER. Selling and renting happen at the
                 same desk, to the same customer, and the only real difference
                 is that a rental is not finished when the money is taken. Two
                 pages would have meant two copies of "who is buying".

                 Plain links, so both are addressable and the back button
                 works — and neither form exists in the page until the server
                 sent it, which is what stops the wrong one being posted. -->
            <div class="modryn_till_modes mb-3">
                <a href="/sell"
                   t-attf-class="btn btn-sm #{'btn-primary' if mode != 'rent' else 'btn-outline-dark'}">Sell</a>
                <a href="/sell?mode=rent"
                   t-attf-class="btn btn-sm #{'btn-primary' if mode == 'rent' else 'btn-outline-dark'}">Rent out</a>
            </div>

            <t t-if="mode != 'rent'">
            <h1 class="mb-1">Sell</h1>
            <p class="modryn_sub mb-4">
                What she is buying, what it comes to, and anything taken off.
            </p>

            <div t-if="saved" class="modryn_panel p-3 mb-4 modryn_sold_ok">
                <div class="modryn_strong">
                    Sold to <t t-out="saved.customer_name"/>
                </div>
                <div class="modryn_sub" t-out="saved_line"/>
            </div>

            <p t-if="error" class="modryn_error mb-3" t-out="error"/>

            <form action="/sell" method="post" class="modryn_sell">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <!-- ============================ who ============================ -->
                <section class="modryn_panel mb-4">
                    <header class="modryn_panel_head"><h2>Who is buying</h2></header>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="customer_name">Full name</label>
                            <input type="text" id="customer_name" name="customer_name"
                                   class="form-control" required="required"
                                   t-att-value="values.get('customer_name')"/>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="customer_phone">Phone</label>
                            <input type="tel" id="customer_phone" name="customer_phone"
                                   class="form-control" dir="ltr" autocomplete="off"
                                   t-att-value="values.get('customer_phone')"/>
                        </div>
                    </div>
                </section>

                <!-- =========================== what ============================ -->
                <section class="modryn_panel mb-4 modryn_sell_pick">
                    <header class="modryn_panel_head"><h2>What she is buying</h2></header>

                    <label class="form-label" for="sell_query">
                        Find it by name, kind, serial number or barcode
                    </label>
                    <input type="text" id="sell_query" class="form-control modryn_sell_query"
                           autocomplete="off" placeholder="Two letters or numbers is enough"/>
                    <p class="modryn_sub mt-1">
                        A scanner works here too — scan, and it goes straight on the list.
                    </p>
                    <div class="modryn_sell_results mt-2"/>

                    <!-- The rail, for the search box to read. Rendered by the
                         server because the catalogue is the server's, and
                         re-read on every page load because dresses sell. -->
                    <div class="d-none">
                        <span t-foreach="rail" t-as="v" t-key="v['id']"
                              class="modryn_sell_row"
                              t-att-data-variant="v['id']"
                              t-att-data-label="v['label']"
                              t-att-data-name="v['name']"
                              t-att-data-serial="v['serial']"
                              t-att-data-kind="v['kind']"
                              t-att-data-barcode="v['barcode']"
                              t-att-data-price="v['price']"/>
                    </div>

                    <!-- Anything not on the rail: a veil from the box under the
                         counter, a hire charge, a repair. A boutique sells
                         those and inventing a catalogue row for each one is how
                         a catalogue stops meaning anything. -->
                    <div class="row g-2 align-items-end mt-3 modryn_sell_free">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="free_label">Something else</label>
                            <input type="text" id="free_label" class="form-control modryn_free_label"
                                   autocomplete="off" placeholder="A veil, a hire, a repair"/>
                        </div>
                        <div class="col-8 col-md-4">
                            <label class="form-label" for="free_price">Price (₪)</label>
                            <input type="number" id="free_price" class="form-control modryn_free_price"
                                   min="0" step="1" dir="ltr"/>
                        </div>
                        <div class="col-4 col-md-2">
                            <button type="button" class="btn btn-outline-dark w-100 modryn_free_add">
                                Add
                            </button>
                        </div>
                    </div>

                    <!-- The basket. Rows are built by the screen; each carries
                         its own hidden inputs, so one submit posts the lot. -->
                    <table class="table modryn_table mt-3 modryn_sell_lines">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th style="width: 9rem;">Price (₪)</th>
                                <th style="width: 4rem;"/>
                            </tr>
                        </thead>
                        <tbody class="modryn_sell_body"/>
                        <tfoot>
                            <tr>
                                <th>Total</th>
                                <th dir="ltr" class="modryn_sell_total">0</th>
                                <th/>
                            </tr>
                        </tfoot>
                    </table>
                    <p class="modryn_empty modryn_sell_none">Nothing on the list yet.</p>
                </section>

                <!-- ========================= discount ========================== -->
                <section class="modryn_panel mb-4">
                    <header class="modryn_panel_head"><h2>Discount</h2></header>
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="discount_kind">Kind</label>
                            <select id="discount_kind" name="discount_kind" class="form-select">
                                <option value="none">No discount</option>
                                <option value="percent">Percent off</option>
                                <option value="amount">Amount off</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="discount_value">How much</label>
                            <input type="number" id="discount_value" name="discount_value"
                                   class="form-control" min="0" step="1" dir="ltr"
                                   t-att-value="values.get('discount_value')"/>
                        </div>
                        <!-- The boutique's OWN codes, by name, or nothing at
                             all. It was a blank text box, and a blank text box
                             on this screen could only ever be refused: the
                             words it accepts are invented on a screen the woman
                             at the counter cannot open, so she had no way to
                             know one existed. A shop that has made no codes
                             does not get the box. -->
                        <div t-if="discount_codes" class="col-12 col-md-3">
                            <label class="form-label" for="discount_code">Code</label>
                            <select id="discount_code" name="discount_code"
                                    class="form-select" dir="ltr">
                                <option value="">&#8212;</option>
                                <option t-foreach="discount_codes" t-as="rule"
                                        t-att-value="rule['code']"
                                        t-att-selected="'selected' if values.get('discount_code') == rule['code'] else None">
                                    <t t-out="rule['code']"/> &#8212; <t t-out="rule['takes_off']"/>
                                </option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label" for="discount_reason">Why</label>
                            <input type="text" id="discount_reason" name="discount_reason"
                                   class="form-control"
                                   placeholder="The sister of a bride we dressed"
                                   t-att-value="values.get('discount_reason')"/>
                        </div>
                    </div>
                    <p class="modryn_sub mt-2 mb-0">
                        A discount shows on the owner's screen with the reason
                        beside it. Pick a code and it decides both — you do not
                        need the two boxes beside it.
                    </p>
                </section>

                <!-- ======================== alteration ========================= -->
                <section class="modryn_panel mb-4">
                    <header class="modryn_panel_head"><h2>Alteration</h2></header>
                    <div class="form-check mb-3">
                        <input type="checkbox" id="altered" name="altered"
                               class="form-check-input" value="1"
                               t-att-checked="'checked' if values.get('altered') else None"/>
                        <label class="form-check-label" for="altered">
                            Something was altered
                        </label>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-7">
                            <label class="form-label" for="alteration_note">What was altered</label>
                            <input type="text" id="alteration_note" name="alteration_note"
                                   class="form-control"
                                   t-att-value="values.get('alteration_note')"/>
                        </div>
                        <div class="col-12 col-md-5">
                            <label class="form-label" for="alteration_by_id">Who altered it</label>
                            <select id="alteration_by_id" name="alteration_by_id" class="form-select">
                                <option value="">— nobody yet —</option>
                                <option t-foreach="staff" t-as="w" t-key="w.id"
                                        t-att-value="w.id" t-out="w.name"/>
                            </select>
                        </div>
                    </div>
                </section>

                <button type="submit" class="btn btn-dark">Record the sale</button>
            </form>
            </t>

            <!-- ============================ rent out ======================= -->
            <t t-else="">
            <h1 class="mb-1">Rent out</h1>
            <p class="modryn_sub mb-4">
                Which gown went out, what it is worth, what she paid to borrow
                it, and when the wedding is. The wedding date is what the shop
                counts from — a gown is late ten days after it, not ten days
                after she collected it.
            </p>

            <div t-if="rented" class="modryn_panel p-3 mb-4 modryn_sold_ok">
                <div class="modryn_strong">
                    <t t-out="rented.dress_label"/> went out to
                    <t t-out="rented.customer_name"/>
                </div>
                <div class="modryn_sub">
                    The wedding is
                    <span dir="ltr" t-esc="rented.wedding_date.strftime('%d.%m.%Y')"/>
                </div>
            </div>

            <p t-if="error" class="modryn_error mb-3" t-out="error"/>

            <form action="/sell/rent" method="post" class="modryn_rent_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <section class="modryn_panel mb-4">
                    <header class="modryn_panel_head"><h2>Who is renting</h2></header>
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="rent_name">Full name</label>
                            <input type="text" id="rent_name" name="customer_name"
                                   class="form-control" required="required"
                                   t-att-value="values.get('customer_name')"/>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="rent_phone">Phone</label>
                            <input type="tel" id="rent_phone" name="customer_phone"
                                   class="form-control" dir="ltr"
                                   t-att-value="values.get('customer_phone')"/>
                        </div>
                    </div>
                </section>

                <section class="modryn_panel mb-4">
                    <header class="modryn_panel_head"><h2>Which gown</h2></header>
                    <div class="row g-3">
                        <!-- Picked off the rail, and the ticket price and the
                             kind come with it — two boxes the counter would
                             otherwise be looking up with somebody waiting. A
                             gown that is not on the rail is typed instead, so
                             a borrowed sample is never a reason not to record
                             a rental. -->
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="rent_variant">From the rail</label>
                            <select id="rent_variant" name="variant_id" class="form-select">
                                <option value="">&#8212;</option>
                                <option t-foreach="rail" t-as="v" t-key="v['id']"
                                        t-att-value="v['id']" t-out="v['label']"/>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="rent_label">Or write it</label>
                            <input type="text" id="rent_label" name="dress_label"
                                   class="form-control"
                                   placeholder="A gown that is not on the rail"
                                   t-att-value="values.get('dress_label')"/>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="rent_kind">Kind</label>
                            <input type="text" id="rent_kind" name="dress_kind"
                                   class="form-control"
                                   t-att-value="values.get('dress_kind')"/>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label" for="rent_retail">What it is worth (₪)</label>
                            <input type="number" id="rent_retail" name="retail_price"
                                   min="0" step="1" dir="ltr" class="form-control"
                                   t-att-value="values.get('retail_price')"/>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label" for="rent_price">What she paid to borrow it (₪)</label>
                            <input type="number" id="rent_price" name="rental_price"
                                   min="0" step="1" dir="ltr" class="form-control"
                                   t-att-value="values.get('rental_price')"/>
                        </div>
                    </div>
                </section>

                <section class="modryn_panel mb-4">
                    <header class="modryn_panel_head"><h2>When</h2></header>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="rent_taken">Taken on</label>
                            <input type="date" id="rent_taken" name="taken_at"
                                   class="form-control" dir="ltr"
                                   t-att-value="values.get('taken_at')"/>
                            <div class="form-text">Today, unless you say otherwise.</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="rent_wedding">The wedding</label>
                            <input type="date" id="rent_wedding" name="wedding_date"
                                   class="form-control" dir="ltr" required="required"
                                   t-att-value="values.get('wedding_date')"/>
                            <div class="form-text">The shop counts from this day.</div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label" for="rent_note">Anything to remember</label>
                            <input type="text" id="rent_note" name="note"
                                   class="form-control" t-att-value="values.get('note')"/>
                        </div>
                    </div>
                </section>

                <button type="submit" class="btn btn-dark">Record the rental</button>
            </form>
            </t>
        </t>
    </template>

</odoo>
