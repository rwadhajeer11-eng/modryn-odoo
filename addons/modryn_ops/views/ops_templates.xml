<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The nav links live in modryn_staff/nav.py now — registered from
         controllers/reports.py, tasks.py and audit.py, rendered by the one
         unified staff_layout. The two xpath-injection templates that used to
         live here raced modryn_roster's for the same anchor, and their order
         was decided by module load rather than by anything declared. -->

    <!-- ========================== owner: checklists ========================== -->
    <template id="manage_checklists" name="Checklists">
        <t t-call="modryn_staff.manage_layout">
            <h1 class="mb-1">Checklists</h1>
            <p class="modryn_sub mb-4">
                The opening and closing routine, as data. Every morning the floor board
                materialises today's list; anyone on shift ticks the items off.
            </p>

            <div t-if="error" class="modryn_field_error mb-3" role="alert">
                <t t-esc="error"/>
            </div>

            <form action="/manage/checklists/new" method="post" class="d-flex gap-2 mb-4 flex-wrap">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="text" name="name" class="form-control w-auto" required="required"
                       placeholder="e.g. Steam the window gowns"/>
                <select name="kind" class="form-select w-auto">
                    <option value="opening">Opening</option>
                    <option value="closing">Closing</option>
                </select>
                <input type="time" name="due_time" class="form-control w-auto" value="11:00"/>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <p t-if="not templates" class="modryn_empty">
                No checklist items yet. Add the first one above.
            </p>

            <table t-if="templates" class="table modryn_table align-middle">
                <thead>
                    <tr><th>Item</th><th>When</th><th>Due</th><th></th></tr>
                </thead>
                <tbody>
                    <tr t-foreach="templates" t-as="tpl">
                        <!-- THE ROW BECOMES THE FORM. Editing in place rather
                             than on a page of its own: this table is four
                             columns wide and the thing she is fixing is a time
                             she typed wrong, so taking her somewhere else to
                             fix it is three screens for one number. -->
                        <t t-if="tpl in editing">
                            <td colspan="4">
                                <form t-attf-action="/manage/checklists/edit/#{tpl.id}"
                                      method="post" class="d-flex gap-2 flex-wrap align-items-center">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <input type="text" name="name" class="form-control w-auto"
                                           required="required" t-att-value="tpl.name"/>
                                    <select name="kind" class="form-select w-auto">
                                        <option value="opening"
                                                t-att-selected="'selected' if tpl.kind == 'opening' else None">Opening</option>
                                        <option value="closing"
                                                t-att-selected="'selected' if tpl.kind == 'closing' else None">Closing</option>
                                    </select>
                                    <input type="time" name="due_time" class="form-control w-auto"
                                           t-att-value="'%02d:%02d' % (int(tpl.due_hour), int(round((tpl.due_hour - int(tpl.due_hour)) * 60)) % 60)"/>
                                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                    <a href="/manage/checklists" class="btn btn-sm btn-outline-dark">Cancel</a>
                                </form>
                                <p class="modryn_sub mb-0 mt-1">
                                    Today's list keeps the old wording — the
                                    change starts tomorrow morning.
                                </p>
                            </td>
                        </t>
                        <t t-else="">
                        <td>
                            <span t-attf-class="#{'' if tpl.active else 'text-muted'}"><t t-esc="tpl.name"/></span>
                            <div t-if="tpl in confirming" class="modryn_field_error mt-2">
                                <div>Delete this item? It goes for good. What
                                has already been ticked off stays.</div>
                            </div>
                        </td>
                        <td>
                            <span class="modryn_badge is_muted">
                                <t t-if="tpl.kind == 'opening'">Opening</t>
                                <t t-else="">Closing</t>
                            </span>
                        </td>
                        <td class="modryn_sub">
                            <t t-esc="'%02d:%02d' % (int(tpl.due_hour), int(round((tpl.due_hour - int(tpl.due_hour)) * 60)) % 60)"/>
                        </td>
                        <td class="text-end">
                            <t t-if="tpl in confirming">
                                <form t-attf-action="/manage/checklists/delete/#{tpl.id}"
                                      method="post" class="d-inline me-1">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-sm btn-danger">Yes, delete</button>
                                </form>
                                <a href="/manage/checklists" class="btn btn-sm btn-outline-dark">Keep it</a>
                            </t>
                            <t t-else="">
                                <a t-attf-href="/manage/checklists?edit=#{tpl.id}"
                                   class="btn btn-sm btn-outline-dark me-1">Edit</a>
                                <form t-attf-action="/manage/checklists/archive/#{tpl.id}" method="post" class="d-inline">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-sm btn-outline-dark">
                                        <t t-if="tpl.active">Archive</t>
                                        <t t-else="">Restore</t>
                                    </button>
                                </form>
                                <a t-attf-href="/manage/checklists?confirm=#{tpl.id}"
                                   class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                            </t>
                        </td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

    <!-- ============================== reports ==============================
         Rendered in the STAFF shell, not the owner shell: shift managers are
         the daily readers, and staff_layout already gates its links by role. -->
    <template id="manage_reports" name="Reports">
        <t t-call="modryn_staff.staff_layout">
            <div class="d-flex align-items-baseline justify-content-between mb-1 flex-wrap gap-2">
                <h1 class="mb-0">Reports</h1>
                <form action="/manage/reports" method="get" class="d-flex gap-2 align-items-center">
                    <input type="date" name="from" class="form-control form-control-sm w-auto"
                           t-att-value="date_from"/>
                    <span class="modryn_sub">–</span>
                    <input type="date" name="to" class="form-control form-control-sm w-auto"
                           t-att-value="date_to"/>
                    <button type="submit" class="btn btn-sm btn-outline-dark">Show</button>
                </form>
            </div>
            <p class="modryn_sub mb-4">
                Made entirely of recorded outcomes — the "to close" badge on the floor board
                is what keeps these numbers honest.
            </p>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="modryn_panel p-3">
                        <div class="modryn_sub">Conversion</div>
                        <div class="modryn_strong fs-3"><t t-esc="stats['conversion']"/>%</div>
                        <div class="modryn_sub"><t t-esc="stats['sold']"/> sold / <t t-esc="stats['sold'] + stats['not_sold']"/> completed</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="modryn_panel p-3">
                        <div class="modryn_sub">Contact conversion</div>
                        <div class="modryn_strong fs-3"><t t-esc="stats['contact_conversion']"/>%</div>
                        <div class="modryn_sub">unique brides who bought</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="modryn_panel p-3">
                        <div class="modryn_sub">Revenue (₪)</div>
                        <div class="modryn_strong fs-3"><t t-esc="'{:,}'.format(int(stats['revenue']))"/></div>
                        <div class="modryn_sub">avg sale ₪<t t-esc="'{:,}'.format(stats['atv'])"/></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="modryn_panel p-3">
                        <div class="modryn_sub">No-shows</div>
                        <div class="modryn_strong fs-3"><t t-esc="stats['no_show_rate']"/>%</div>
                        <div class="modryn_sub"><t t-esc="stats['no_show']"/> of <t t-esc="stats['closed']"/> closed</div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="modryn_panel p-3">
                        <div class="modryn_sub">Follow-ups done</div>
                        <div class="modryn_strong fs-4"><t t-esc="stats['followups_done']"/>/<t t-esc="stats['followups_total']"/></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="modryn_panel p-3">
                        <div class="modryn_sub">Checklist items done</div>
                        <!-- A COUNT, not a fraction. "0/6" invited the boutique
                             to read six as a target it had missed, when six is
                             only how many items happen to be on the list today
                             - add a seventh and yesterday's figure changes. -->
                        <div class="modryn_strong fs-4" t-esc="stats['checklist_done']"/>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="modryn_panel p-3">
                        <div class="modryn_sub">Feedback texts sent</div>
                        <!-- Same: how many went out, full stop. It read
                             "0/16 of not-sold fittings", which is a ratio
                             against a number that moves for its own reasons. -->
                        <div class="modryn_strong fs-4" t-esc="stats['feedback_sent']"/>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="modryn_panel p-3">
                        <div class="modryn_sub">Cancelled · still to close</div>
                        <div class="modryn_strong fs-4"><t t-esc="stats['cancelled']"/> · <t t-esc="stats['unclosed']"/></div>
                    </div>
                </div>
            </div>

            <!-- ================= gowns off the rail ================= -->
            <!-- Counted in GOWNS, not appointments. A walk-in has no
                 appointment at all, so until the walk-in half of the outcome
                 shipped every dress a bride carried out without booking first
                 was invisible to every number above this. -->
            <div class="d-flex align-items-baseline justify-content-between mb-2 flex-wrap gap-2">
                <h2 class="mb-0">Gowns sold</h2>
                <span class="modryn_sub">
                    <strong class="modryn_strong" t-out="gown_total['count']"/>
                    <t t-out="' · '"/>
                    <strong class="modryn_strong" t-out="'{:,}'.format(gown_total['value'])"/> ₪
                </span>
            </div>
            <p class="modryn_sub mb-3">
                What the gowns are priced at in the catalogue, not what was taken
                at the till.
            </p>

            <p t-if="not gown_days" class="modryn_empty">
                No gown has left the rail in this range yet.
            </p>
            <table t-if="gown_days" class="table modryn_table align-middle">
                <thead>
                    <tr>
                        <th>Day</th><th>Gowns</th><th>Price (₪)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="gown_days" t-as="d">
                        <td>
                            <!-- Open the day to see what left it. A disclosure
                                 the browser draws itself: no script to lose, it
                                 works from the keyboard, and it prints open. -->
                            <details>
                                <summary class="modryn_strong" dir="ltr" t-out="d['label']"/>
                                <ul class="modryn_gown_list">
                                    <li t-foreach="d['gowns']" t-as="g">
                                        <span class="modryn_strong" t-out="g['name']"/>
                                        <span t-if="g['size']" class="modryn_badge is_muted"
                                              t-out="g['size']"/>
                                        <span t-if="g['serial']" class="modryn_sub" dir="ltr"
                                              t-out="g['serial']"/>
                                        <span class="modryn_sub" dir="ltr">
                                            <t t-out="'{:,}'.format(g['price'])"/> ₪
                                        </span>
                                        <span t-if="g['kind'] == 'walkin'"
                                              class="modryn_badge is_muted">Walk-in</span>
                                    </li>
                                </ul>
                            </details>
                        </td>
                        <td class="modryn_strong" t-out="d['count']"/>
                        <td t-out="'{:,}'.format(d['value'])"/>
                    </tr>
                </tbody>
            </table>

            <!-- THE MONTHS ALREADY GONE. The tiles above are this month and
                 turn over with it, which is what the boutique wanted - and it
                 left nowhere for last month to be. Nothing on the page said the
                 shop had a September at all; the only way to reach it was to
                 know the two date fields existed and type into them.
                 <details> and not a script: the back button works, one month
                 can be sent to somebody as a link, and there is no state to
                 lose. -->
            <section t-if="months" class="mt-4">
                <h2 class="mb-2">Month by month</h2>
                <p class="text-muted mb-3">
                    Every month the boutique has traded. The figures at the top
                    of this page are the month you are in now.
                </p>
                <details t-foreach="months" t-as="m" t-key="m['key']"
                         class="modryn_panel mb-2">
                    <summary style="cursor:pointer;" class="d-flex gap-3 flex-wrap align-items-baseline">
                        <span class="modryn_strong" dir="ltr" t-out="m['label']"/>
                        <span class="modryn_sub">
                            <t t-out="m['stats']['sold']"/> sold
                        </span>
                        <span class="modryn_sub">
                            Conversion <span dir="ltr"><t t-out="m['stats']['conversion']"/>%</span>
                        </span>
                        <span class="modryn_sub" dir="ltr">
                            <!-- Same formatting as the tile above: revenue is a
                                 float, and printing it raw gave "163400.0" on a
                                 line that sits under "163,400". -->
                            ₪<t t-esc="'{:,}'.format(int(m['stats']['revenue']))"/>
                        </span>
                    </summary>

                    <div class="row g-2 mt-2">
                        <div class="col-6 col-md-3">
                            <div class="modryn_sub">Conversion</div>
                            <div class="modryn_strong fs-5">
                                <t t-out="m['stats']['conversion']"/>%
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="modryn_sub">Contact conversion</div>
                            <div class="modryn_strong fs-5">
                                <t t-out="m['stats']['contact_conversion']"/>%
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="modryn_sub">Revenue (₪)</div>
                            <div class="modryn_strong fs-5"
                                 t-esc="'{:,}'.format(int(m['stats']['revenue']))"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="modryn_sub">No-shows</div>
                            <div class="modryn_strong fs-5">
                                <t t-out="m['stats']['no_show_rate']"/>%
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="modryn_sub">Sold</div>
                            <div class="modryn_strong fs-5" t-out="m['stats']['sold']"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="modryn_sub">Not sold</div>
                            <div class="modryn_strong fs-5" t-out="m['stats']['not_sold']"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="modryn_sub">Average sale (₪)</div>
                            <div class="modryn_strong fs-5"
                                 t-out="m['stats']['atv']"/>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="modryn_sub">Feedback texts sent</div>
                            <div class="modryn_strong fs-5"
                                 t-out="m['stats']['feedback_sent']"/>
                        </div>
                    </div>

                    <!-- Into the date fields at the top, so the whole page -
                         the gowns table and the by-stylist breakdown - can be
                         read for that month too. -->
                    <a class="btn btn-sm btn-outline-dark mt-3"
                       t-attf-href="/manage/reports?from=#{m['first']}&amp;to=#{m['last']}">
                        Open this month in full
                    </a>
                </details>
            </section>

            <h2 class="mb-2 mt-4">By stylist</h2>
            <p t-if="not stylists" class="modryn_empty">
                No closed appointments with an assigned stylist in this range yet.
            </p>
            <table t-if="stylists" class="table modryn_table align-middle">
                <thead>
                    <tr>
                        <th>Stylist</th><th>Closed</th><th>Sold</th><th>No-shows</th>
                        <th>Conversion</th><th>Revenue (₪)</th><th>Avg sale (₪)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="stylists" t-as="s">
                        <td class="modryn_strong"><t t-esc="s['name']"/></td>
                        <td><t t-esc="s['closed']"/></td>
                        <td><t t-esc="s['sold']"/></td>
                        <td><t t-esc="s['no_show']"/></td>
                        <td><t t-esc="s['conversion']"/>%</td>
                        <td><t t-esc="'{:,}'.format(s['revenue'])"/></td>
                        <td><t t-esc="'{:,}'.format(s['atv'])"/></td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

    <!-- ============================ audit trail ============================ -->
    <template id="manage_audit" name="Audit trail">
        <t t-call="modryn_staff.manage_layout">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h1 class="mb-0">Audit trail</h1>
                <span class="modryn_sub"><t t-esc="total"/> entries</span>
            </div>

            <p t-if="not rows" class="modryn_empty">Nothing has been changed yet.</p>

            <table t-if="rows" class="table modryn_table align-middle">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Who</th>
                        <th>What</th>
                        <th>Change</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="rows" t-as="r">
                        <!-- dir="ltr" on the timestamp: it is a date and a
                             time, and inside Hebrew prose the bidi algorithm
                             puts the clock before the calendar. -->
                        <td class="modryn_sub" dir="ltr"><t t-esc="r['when']"/></td>
                        <td><t t-esc="r['actor']"/></td>
                        <td><t t-esc="r['label']"/></td>
                        <!-- The arrow means "became", so it has to point the way
                             the reader is going. In Hebrew and Arabic that is
                             right to left, and a hardcoded → says the change ran
                             backwards - the new value turning into the old one.
                             The cell mirrors as a whole and the glyph follows
                             the language. -->
                        <td>
                            <span class="modryn_sub"><t t-esc="r['old'] or '—'"/></span>
                            <span class="modryn_sub modryn_becomes" aria-hidden="true"/>
                            <span class="modryn_strong"><t t-esc="r['new'] or '—'"/></span>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div t-if="has_prev or has_next" class="d-flex gap-2">
                <a t-if="has_prev" t-attf-href="/manage/audit?page=#{page - 1}"
                   class="btn btn-sm btn-outline-dark">Newer</a>
                <a t-if="has_next" t-attf-href="/manage/audit?page=#{page + 1}"
                   class="btn btn-sm btn-outline-dark">Older</a>
            </div>
        </t>
    </template>

</odoo>
