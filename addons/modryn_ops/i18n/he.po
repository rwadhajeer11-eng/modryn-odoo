msgid ""
"Thank you for visiting %(boutique)s! We'd love to hear how it went — just "
"reply to this message."
msgstr ""
"תודה שביקרת ב%(boutique)s! נשמח לשמוע איך היה — פשוט השיבי להודעה הזו."

#. module: modryn_ops
#. odoo-python
#: code:addons/modryn_ops/models/calendar_event.py:0
