msgstr "MODRYN: סגירת היום"

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid ""
"Make yourself at home — feel free to browse while you wait.\n"
"                            We'll text you when we're ready."
msgstr ""
"הרגישי בבית — הסתובבי והתרשמי בזמן ההמתנה. נעדכן אותך בהודעה כשנהיה מוכנות."

#. module: modryn_queue_poc
#. odoo-javascript
#: code:addons/modryn_queue_poc/static/src/queue_board/queue_board.xml:0
#: model:ir.model.fields,field_description:modryn_queue_poc.field_modryn_queue_entry__name
msgid "Name"
msgstr "שם"

#. module: modryn_queue_poc
#. odoo-javascript
#: code:addons/modryn_queue_poc/static/src/queue_board/queue_board.xml:0
msgid "No one is waiting right now."
msgstr "אין לקוחות בתור כרגע."

#. module: modryn_queue_poc
#: model:ir.model.fields.selection,name:modryn_queue_poc.selection__modryn_queue_entry__state__pending
msgid "Pending"
msgstr "ממתינה לאישור"

#. module: modryn_queue_poc
#. odoo-javascript
#: code:addons/modryn_queue_poc/static/src/queue_board/queue_board.xml:0
#: model:ir.model.fields,field_description:modryn_queue_poc.field_modryn_queue_entry__phone
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.checkin_form
msgid "Phone"
msgstr "טלפון"

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "Please come to the desk."
msgstr "נא לגשת לדלפק."

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/controllers/main.py:0
msgid "Please enter a valid phone number"
msgstr "יש להזין מספר טלפון תקין"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/controllers/main.py:0
msgid "Please enter your full name"
msgstr "נא למלא שם מלא"

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "Prefer a scheduled visit?"
msgstr "מעדיפה לקבוע תור מראש?"

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.queue_sign
msgid "Scan the code to join the queue"
msgstr "סרקי את הקוד כדי להצטרף לתור"

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.checkin_form
msgid "Send me a code"
msgstr "שלחו לי קוד"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/controllers/main.py:0
msgid "Something went wrong."
msgstr "משהו השתבש."

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.verify_form
msgid "Start again"
msgstr "התחלה מחדש"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/controllers/main.py:0
msgid "Start again to get a new code."
msgstr "יש להתחיל מחדש כדי לקבל קוד חדש."

#. module: modryn_queue_poc
#. odoo-javascript
#: code:addons/modryn_queue_poc/static/src/queue_board/queue_board.xml:0
msgid "Status"
msgstr "סטטוס"

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "Thank you for visiting"
msgstr "תודה שביקרת"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/controllers/main.py:0
msgid "That code has expired. Start again to get a new one."
msgstr "תוקף הקוד פג. יש להתחיל מחדש כדי לקבל קוד חדש."

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/controllers/main.py:0
msgid "That code is not right."
msgstr "הקוד אינו נכון."

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "Today is a busy day"
msgstr "היום יום עמוס"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/controllers/main.py:0
msgid "Too many codes sent to that number. Try again in an hour."
msgstr "נשלחו יותר מדי קודים למספר הזה. אפשר לנסות שוב בעוד שעה."

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/controllers/main.py:0
msgid "Too many wrong codes. Start again to get a new one."
msgstr "יותר מדי קודים שגויים. יש להתחיל מחדש כדי לקבל קוד חדש."

#. module: modryn_queue_poc
#. odoo-javascript
#: code:addons/modryn_queue_poc/static/src/queue_board/queue_board.xml:0
msgid "Type"
msgstr "סוג"

#. module: modryn_queue_poc
#. odoo-javascript
#: code:addons/modryn_queue_poc/static/src/queue_board/queue_board.xml:0
#: model:ir.model.fields.selection,name:modryn_queue_poc.selection__modryn_queue_entry__state__waiting
msgid "Waiting"
msgstr "ממתינה"

#. module: modryn_queue_poc
#. odoo-javascript
#: code:addons/modryn_queue_poc/static/src/queue_board/queue_board.xml:0
msgid "Waiting now:"
msgstr "ממתינות:"

#. module: modryn_queue_poc
#. odoo-javascript
#: code:addons/modryn_queue_poc/static/src/queue_board/queue_board.xml:0
#: model:ir.actions.client,name:modryn_queue_poc.action_queue_board
#: model:ir.ui.menu,name:modryn_queue_poc.menu_modryn_queue_board
msgid "Walk-in queue"
msgstr "תור בכניסה"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/controllers/main.py:0
msgid "We couldn't send the code. Check the number and try again."
msgstr "לא הצלחנו לשלוח את הקוד. כדאי לבדוק את המספר ולנסות שוב."

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "We hope to see you again soon."
msgstr "נשמח לראותך שוב בקרוב."

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.verify_form
msgid "We sent a 6-digit code to"
msgstr "שלחנו קוד בן 6 ספרות אל"

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid ""
"We'd love to give you our full attention — book a fitting\n"
"                            and the boutique is yours."
msgstr "נשמח להקדיש לך את מלוא תשומת הלב — קבעי מדידה והבוטיק כולו שלך."

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "We'll be with you in a moment."
msgstr "נהיה איתך עוד רגע."

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "We'll be with you soon"
msgstr "נהיה איתך בקרוב"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/models/queue_entry.py:0
msgid "We're fully booked today. Book a fitting with us here: %(link)s"
msgstr "היום אנחנו מלאים. אפשר לקבוע תור כאן: %(link)s"

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "We're ready for you"
msgstr "אנחנו מוכנים בשבילך"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/models/queue_entry.py:0
msgid "We're ready for you — %(stylist)s is waiting."
msgstr "אנחנו מוכנים בשבילך — %(stylist)s מחכה לך."

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/models/queue_entry.py:0
msgid "We're ready for you — please come to the desk."
msgstr "אנחנו מוכנים בשבילך — נא לגשת לדלפק."

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.checkin_form
msgid "Welcome"
msgstr "ברוכה הבאה"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/models/queue_entry.py:0
msgid ""
"You're in the queue — and you're next. We'll be with you in a moment. Your "
"ticket: %(link)s"
msgstr "את בתור — ואת הבאה בתור. נהיה איתך עוד רגע. הכרטיס שלך: %(link)s"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/models/queue_entry.py:0
msgid ""
"You're in the queue. We'll text you when you're next. Your ticket: %(link)s"
msgstr "את בתור. נעדכן אותך בהודעה כשיגיע תורך. הכרטיס שלך: %(link)s"

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "You're next"
msgstr "את הבאה בתור"

#. module: modryn_queue_poc
#. odoo-python
#: code:addons/modryn_queue_poc/models/queue_entry.py:0
msgid "You're next — we'll be with you in a moment."
msgstr "את הבאה בתור — נהיה איתך עוד רגע."

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "is waiting for you."
msgstr "מחכה לך."

#. module: modryn_queue_poc
#: model_terms:ir.ui.view,arch_db:modryn_queue_poc.ticket
msgid "This number is already in the line — this is your place."
msgstr "המספר הזה כבר בתור — זה המקום שלך."
