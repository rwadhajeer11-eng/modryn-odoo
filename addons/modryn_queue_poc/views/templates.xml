<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Walk-in check-in: the QR target, and the floor terminal's own door.
         Three fields, nothing else — and then a code, because until she proves
         she holds the number this form was a way to read a stranger's ticket.

         The shell is chosen by the controller: website.layout for a bride with
         a phone, modryn_staff.staff_layout for a staff member at the desk, who
         gets the real nav and a way back to /floor. staff_layout opens its own
         `<div id="wrap">`, so ours stands down rather than duplicate the id. -->
    <template id="checkin_form" name="MODRYN walk-in check-in">
        <t t-call="{{ layout }}">
            <div t-att-id="not staff and 'wrap'" t-att-class="not staff and 'oe_structure'">
                <div class="container py-5" style="max-width: 520px;">
                    <h1 class="mb-4">Welcome</h1>

                    <form action="/queue/checkin/submit" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="mb-3">
                            <label class="form-label" for="name">Full name</label>
                            <input type="text" id="name" name="name" class="form-control"
                                   t-att-value="values.get('name', '')"/>
                            <div t-if="errors.get('name')" class="text-danger small mt-1"
                                 t-out="errors['name']"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="phone">Phone</label>
                            <input type="tel" id="phone" name="phone" class="form-control" dir="ltr"
                                   placeholder="050-1234567" autocomplete="tel"
                                   t-att-value="values.get('phone', '')"/>
                            <!-- This error was set in the controller and never rendered:
                                 a bad number came back as a blank form with no reason. -->
                            <div t-if="errors.get('phone')" class="text-danger small mt-1"
                                 t-out="errors['phone']"/>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" for="client_type">Client type</label>
                            <select id="client_type" name="client_type" class="form-select">
                                <option value="bride"
                                        t-att-selected="'selected' if values.get('client_type') == 'bride' else None">Bride</option>
                                <option value="evening"
                                        t-att-selected="'selected' if values.get('client_type') == 'evening' else None">Evening</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">Send me a code</button>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- The code. Nothing has been created yet at this point — abandoning here
         leaves no row, which is the whole reason the step sits before the
         ticket rather than after it. -->
    <template id="verify_form" name="MODRYN walk-in verification">
        <t t-call="{{ layout }}">
            <div t-att-id="not staff and 'wrap'" t-att-class="not staff and 'oe_structure'">
                <div class="container py-5" style="max-width: 520px;">
                    <h1 class="mb-2">Enter your code</h1>
                    <p class="text-muted mb-4">
                        We sent a 6-digit code to <span dir="ltr" t-out="phone"/>.
                    </p>

                    <div t-if="demo_code" class="alert alert-info" role="status">
                        Demo mode — your code is <b dir="ltr" t-out="demo_code"/>
                    </div>

                    <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

                    <form action="/queue/verify" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="mb-4">
                            <label class="form-label" for="code">Code</label>
                            <!-- inputmode numeric so phones show a keypad; one-time-code
                                 lets iOS and Android offer the SMS autofill. -->
                            <input type="text" id="code" name="code" class="form-control"
                                   dir="ltr" inputmode="numeric" autocomplete="one-time-code"
                                   maxlength="6" autofocus="autofocus"/>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">Join the queue</button>
                    </form>

                    <!-- "Start again", not the portal's "Use a different number": every
                         error on this page ends in "start again to get a new code", and a
                         link offering something else is the only way back. It returns to
                         the check-in form, where the number can be kept or changed. -->
                    <p class="text-muted small mt-3 mb-0">
                        <a href="/queue/checkin">Start again</a>
                    </p>
                </div>
            </div>
        </t>
    </template>

    <!-- Her private ticket. Three warm states, no numbers, no mechanics:
         a premium boutique keeps its line invisible. -->
    <template id="ticket" name="MODRYN walk-in ticket">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5 text-center" style="max-width: 520px;"
                     t-att-data-refresh="'1' if entry.state in ('pending','waiting','called') else None">

                    <!-- One-shot: only when she just re-verified a number that
                         already holds a place, and only while that place is
                         live. Warm, not scolding — she did nothing wrong. -->
                    <div t-if="already and entry.state in ('pending', 'waiting', 'called')"
                         class="alert alert-info" role="status">
                        This number is already in the line — this is your place.
                    </div>

                    <t t-if="entry.state == 'called'">
                        <h1 class="mb-3">We're ready for you</h1>
                        <p class="text-muted">
                            <t t-if="stylist"><t t-out="stylist"/> is waiting for you.</t>
                            <t t-else="">Please come to the desk.</t>
                        </p>
                    </t>

                    <t t-elif="is_next">
                        <h1 class="mb-3">You're next</h1>
                        <p class="text-muted">We'll be with you in a moment.</p>
                    </t>

                    <t t-elif="entry.state in ('pending', 'waiting')">
                        <h1 class="mb-3">We'll be with you soon</h1>
                        <p class="text-muted">
                            Make yourself at home — feel free to browse while you wait.
                            We'll text you when we're ready.
                        </p>
                    </t>

                    <t t-elif="entry.state == 'done'">
                        <h1 class="mb-3">Thank you for visiting</h1>
                        <p class="text-muted">We hope to see you again soon.</p>
                    </t>

                    <t t-else="">
                        <!-- redirected or expired: the same warm exit either way.
                             She is never told she was held or turned away. -->
                        <h1 class="mb-3">Today is a busy day</h1>
                        <p class="text-muted mb-4">
                            We'd love to give you our full attention — book a fitting
                            and the boutique is yours.
                        </p>
                        <a t-att-href="book_url" class="btn btn-primary btn-lg">Book a fitting</a>
                    </t>

                    <div t-if="entry.state in ('pending', 'waiting')" class="mt-4">
                        <a t-att-href="book_url" class="btn btn-link">
                            Prefer a scheduled visit?
                        </a>
                    </div>

                    <!-- She is holding her phone, not watching a dashboard: a
                         plain reload every 15s is enough to move her through the
                         three states, and costs no websocket on a public page.
                         Only while the ticket is live — a finished page must not
                         keep polling in her pocket. -->
                    <script t-if="entry.state in ('pending', 'waiting')" type="text/javascript">
                        setTimeout(function () { window.location.reload(); }, 15000);
                    </script>
                </div>
            </div>
        </t>
    </template>

    <!-- The lounge sign. Print it, frame it, done. -->
    <template id="queue_sign" name="MODRYN queue QR sign">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5 text-center" style="max-width: 520px;">
                    <h1 class="mb-2">Join the queue</h1>
                    <p class="text-muted mb-4">Scan the code to join the queue</p>
                    <!-- Trailing slash after /barcode is required: without it the
                         request falls through to the <barcode_type>/<value> form
                         and 500s. Rendering also needs reportlab's raster backend
                         (rlPyCairo), which is NOT in odoo/requirements.txt. -->
                    <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=600&amp;height=600' % checkin_url"
                         alt="QR" style="width:280px; height:280px;"/>
                </div>
            </div>
        </t>
    </template>

</odoo>
