<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="modryn_queue_poc.QueueBoard">
        <div class="o_modryn_queue_board p-4" dir="rtl">
            <h2 class="mb-1">תור בכניסה</h2>
            <p class="text-muted mb-4">
                ממתינות: <t t-esc="waiting.length"/>
            </p>

            <div t-if="!state.entries.length" class="text-muted">
                אין לקוחות בתור כרגע.
            </div>

            <table t-else="" class="table align-middle">
                <thead>
                    <tr>
                        <th style="width:4rem;">#</th>
                        <th>שם</th>
                        <th>טלפון</th>
                        <th>סוג</th>
                        <th>סטטוס</th>
                        <th style="width:14rem;"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="state.entries" t-as="entry" t-key="entry.id">
                        <td t-esc="entry_index + 1"/>
                        <td t-esc="entry.name"/>
                        <td dir="ltr" t-esc="entry.phone"/>
                        <td t-esc="entry.client_type === 'bride' ? 'כלה' : 'ערב'"/>
                        <td>
                            <span t-if="entry.state === 'waiting'" class="badge text-bg-warning">
                                ממתינה
                            </span>
                            <span t-else="" class="badge text-bg-success">נקראה</span>
                        </td>
                        <td>
                            <button t-if="entry.state === 'waiting'"
                                    class="btn btn-sm btn-primary me-2"
                                    t-on-click="() => this.call(entry)">
                                קריאה
                            </button>
                            <button class="btn btn-sm btn-secondary"
                                    t-on-click="() => this.done(entry)">
                                סיום
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>

</templates>
