<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reuses modryn_staff's admin shell so the workshop looks like the rest of
         the staff tooling rather than a bolted-on page. -->
    <template id="dashboard" name="Atelier dashboard">
        <t t-call="modryn_staff.manage_layout">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h1 class="mb-0">Workshop</h1>
                <a href="/manage/pieces" class="btn btn-outline-dark btn-sm">Garment pieces</a>
            </div>

            <!-- Who is carrying what. Open work only — a delivered gown is not a load. -->
            <section class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2>Workload</h2>
                </header>
                <p t-if="not board['load']" class="modryn_empty">No staff to show.</p>
                <div t-else="" class="modryn_staff_cards">
                    <div t-foreach="board['load']" t-as="row"
                         t-attf-class="modryn_staff_card #{'is_busy' if row['overdue'] else 'is_free'}">
                        <div class="modryn_strong" t-out="row['name']"/>
                        <div class="modryn_sub" t-out="row['role']"/>
                        <div class="modryn_status">
                            <t t-out="row['open']"/> open
                        </div>
                        <div t-if="row['overdue']" class="modryn_sub" style="color:#A03232;">
                            <t t-out="row['overdue']"/> overdue
                        </div>
                    </div>
                </div>
            </section>

            <!-- The queue: open work nobody holds yet, in the exact order the
                 auto-assigner hands it out — what the manager sees here IS what
                 the next free seamstress gets. -->
            <section class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2>Queue</h2>
                    <span class="modryn_count" t-out="len(board['queue'])"/>
                </header>
                <p t-if="not board['queue']" class="modryn_empty">
                    Nothing waiting — every open task has hands on it.
                </p>
                <table t-else="" class="table modryn_table align-middle">
                    <tbody>
                        <tr t-foreach="board['queue']" t-as="task">
                            <td style="width: 1%;">
                                <span t-if="task['priority'] == '2'" class="modryn_badge is_busy">High</span>
                                <span t-elif="task['priority'] == '0'" class="modryn_badge is_muted">Low</span>
                                <span t-else="" class="modryn_badge is_free">Normal</span>
                            </td>
                            <td>
                                <div class="modryn_strong" t-out="task['customer']"/>
                                <div class="modryn_sub" dir="ltr" t-out="task['phone']"/>
                            </td>
                            <td>
                                <div t-if="task['dress']" class="modryn_sub">
                                    <t t-out="task['dress']"/>
                                    <t t-if="task['size']"> · <t t-out="task['size']"/></t>
                                </div>
                                <div class="modryn_sub">
                                    <t t-foreach="task['pieces']" t-as="p">
                                        <span class="modryn_badge is_muted me-1" t-out="p"/>
                                    </t>
                                </div>
                            </td>
                            <td>
                                <span t-if="task['due']"
                                      t-attf-class="modryn_badge #{'is_busy' if task['overdue'] else 'is_muted'}">
                                    <t t-out="task['due']"/>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <!-- One panel per state: the workshop reads left to right as work moves. -->
            <section t-foreach="board['states']" t-as="st" class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2 t-out="st[1]"/>
                    <span class="modryn_count" t-out="len(board['by_state'][st[0]])"/>
                </header>

                <p t-if="not board['by_state'][st[0]]" class="modryn_empty">Nothing here.</p>

                <table t-else="" class="table modryn_table align-middle">
                    <tbody>
                        <tr t-foreach="board['by_state'][st[0]]" t-as="task">
                            <td style="width: 1%;">
                                <span t-if="task['priority'] == '2'" class="modryn_badge is_busy">High</span>
                                <span t-elif="task['priority'] == '0'" class="modryn_badge is_muted">Low</span>
                            </td>
                            <td>
                                <div class="modryn_strong" t-out="task['customer']"/>
                                <div class="modryn_sub" dir="ltr" t-out="task['phone']"/>
                            </td>
                            <td>
                                <div t-if="task['dress']" class="modryn_sub">
                                    <t t-out="task['dress']"/>
                                    <t t-if="task['size']"> · <t t-out="task['size']"/></t>
                                </div>
                                <div class="modryn_sub">
                                    <t t-foreach="task['pieces']" t-as="p">
                                        <span class="modryn_badge is_muted me-1" t-out="p"/>
                                    </t>
                                </div>
                            </td>
                            <td>
                                <div t-if="task['note']" class="modryn_sub" t-out="task['note']"/>
                            </td>
                            <td>
                                <span t-if="task['seamstress']" t-out="task['seamstress']"/>
                                <span t-else="" class="modryn_sub">Unassigned</span>
                            </td>
                            <td>
                                <span t-if="task['due']"
                                      t-attf-class="modryn_badge #{'is_busy' if task['overdue'] else 'is_muted'}">
                                    <t t-out="task['due']"/>
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </t>
    </template>

    <!-- Owner-maintained garment pieces — same shape as the roles page. -->
    <template id="manage_pieces" name="Garment pieces">
        <t t-call="modryn_staff.manage_layout">
            <h1 class="mb-2">Garment pieces</h1>
            <p class="text-muted mb-4">
                The parts of a garment your workshop alters. Add whatever this boutique needs.
            </p>

            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

            <form action="/manage/pieces/new" method="post" class="d-flex gap-2 mb-4"
                  style="max-width: 480px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="text" name="name" class="form-control" placeholder="New piece"/>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <table class="table modryn_table align-middle" style="max-width: 480px;">
                <tbody>
                    <tr t-foreach="pieces" t-as="piece"
                        t-attf-class="#{'modryn_archived' if not piece.active else ''}">
                        <td t-out="piece.name"/>
                        <td class="text-end">
                            <form t-attf-action="/manage/pieces/archive/#{piece.id}" method="post"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="piece.active">Archive</t>
                                    <t t-else="">Restore</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

</odoo>
