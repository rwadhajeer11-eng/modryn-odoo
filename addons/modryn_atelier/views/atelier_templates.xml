<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reuses modryn_staff's admin shell so the workshop looks like the rest of
         the staff tooling rather than a bolted-on page. -->
    <template id="dashboard" name="Atelier dashboard">
        <t t-call="modryn_staff.manage_layout">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h1 class="mb-0">Workshop</h1>
                <a href="/manage/pieces" class="btn btn-outline-dark btn-sm">Garment pieces</a>
            </div>

            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

            <!-- The dashboard's own creation door. Native details/summary — no JS.
                 Open to any staff member: a seamstress must be able to write down
                 a garment that arrives in her hands. /atelier/task/new re-checks the group
                 server-side, because hiding a panel is not a permission. -->
            <section class="modryn_panel mb-4">
                <details t-att-open="'open' if error else None">
                    <summary class="modryn_panel_head" style="cursor:pointer;">
                        <h2 class="d-inline">New task</h2>
                    </summary>
                    <form action="/atelier/task/new" method="post" class="mt-3"
                          style="max-width: 680px;">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="task_customer">Customer name</label>
                                <input type="text" id="task_customer" name="customer_name"
                                       class="form-control" required="required"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="task_phone">Phone</label>
                                <input type="tel" id="task_phone" name="customer_phone"
                                       class="form-control" dir="ltr"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="task_variant">Dress</label>
                                <select id="task_variant" name="variant_id" class="form-select">
                                    <option value="">—</option>
                                    <t t-foreach="variants" t-as="v">
                                        <option t-att-value="v.id">
                                            <t t-out="v.product_tmpl_id.name"/><t t-if="v.product_template_attribute_value_ids"> · <t t-out="v.product_template_attribute_value_ids[:1].name"/></t>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <!-- Managers only. Handing work to somebody else is a
                                 manager's act; a seamstress adding a garment gets
                                 it assigned to herself. The server enforces that
                                 in task_create() regardless of what is posted —
                                 this t-if only stops the form offering her a
                                 choice it would then quietly overrule. -->
                            <div t-if="is_manager" class="col-md-6">
                                <label class="form-label" for="task_seamstress">Seamstress</label>
                                <select id="task_seamstress" name="seamstress_id" class="form-select">
                                    <option value="">Auto-assign</option>
                                    <t t-foreach="seamstresses" t-as="s">
                                        <option t-att-value="s.id" t-out="s.name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-12">
                                <span class="form-label d-block">Pieces</span>
                                <div class="d-flex flex-wrap gap-3">
                                    <div t-foreach="pieces" t-as="p" class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="piece_ids" t-att-value="p.id"
                                               t-attf-id="task_piece_#{p.id}"/>
                                        <label class="form-check-label" t-attf-for="task_piece_#{p.id}"
                                               t-out="p.name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="task_priority">Priority</label>
                                <select id="task_priority" name="priority" class="form-select">
                                    <option value="0">Low</option>
                                    <option value="1" selected="selected">Normal</option>
                                    <option value="2">High</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="task_due">Due date</label>
                                <input type="date" id="task_due" name="due_date"
                                       class="form-control" required="required"/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="task_note">Note</label>
                                <input type="text" id="task_note" name="note" class="form-control"/>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Create task</button>
                            </div>
                        </div>
                    </form>
                </details>
            </section>

            <!-- Who is carrying what. Open work only — a delivered gown is not a load. -->
            <section class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2>Workload</h2>
                </header>
                <p t-if="not board['load']" class="modryn_empty">No staff to show.</p>
                <div t-else="" class="modryn_staff_cards">
                    <!-- Each card is a way IN. The column said somebody had
                         nine open jobs and stopped; nine WHICH jobs is the next
                         question anybody asks, and the only way to answer it
                         was to read all four panels looking for her name. -->
                    <a t-foreach="board['load']" t-as="row" t-key="row['id']"
                       t-attf-href="/atelier?who=#{row['id']}"
                       t-attf-class="modryn_staff_card #{'is_busy' if row['overdue'] else 'is_free'} #{'is_on' if board.get('only') and board['only'].id == row['id'] else ''}">
                        <div class="modryn_strong" t-out="row['name']"/>
                        <div class="modryn_sub" t-out="row['role']"/>
                        <div class="modryn_status">
                            <t t-out="row['open']"/> open
                        </div>
                        <div t-if="row['overdue']" class="modryn_sub" style="color:#A03232;">
                            <t t-out="row['overdue']"/> overdue
                        </div>
                    </a>
                </div>
                <!-- The way back out. Drawn only while a filter is on, and
                     inside the workload block, which is never filtered - a
                     filter that hides the control that applied it is a trap. -->
                <a t-if="board.get('only')" href="/atelier"
                   class="btn btn-sm btn-link mt-2">Show the whole workshop</a>
            </section>

            <!-- The queue: open work nobody holds yet, in the exact order the
                 auto-assigner hands it out — what the manager sees here IS what
                 the next free seamstress gets. -->
            <section class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2>Queue</h2>
                    <span class="modryn_count" t-out="len(board['queue'])"/>
                </header>
                <p t-if="not board['queue']" class="modryn_empty">
                    Nothing waiting — every open task has hands on it.
                </p>
                <table t-else="" class="table modryn_table align-middle">
                    <tbody>
                        <tr t-foreach="board['queue']" t-as="task">
                            <td style="width: 1%;">
                                <span t-if="task['priority'] == '2'" class="modryn_badge is_busy">High</span>
                                <span t-elif="task['priority'] == '0'" class="modryn_badge is_muted">Low</span>
                                <span t-else="" class="modryn_badge is_free">Normal</span>
                            </td>
                            <td>
                                <div class="modryn_strong" t-out="task['customer']"/>
                                <div class="modryn_sub" dir="ltr" t-out="task['phone']"/>
                            </td>
                            <td>
                                <div t-if="task['dress']" class="modryn_sub">
                                    <t t-out="task['dress']"/>
                                    <t t-if="task['size']"> · <t t-out="task['size']"/></t>
                                </div>
                                <div class="modryn_sub">
                                    <t t-foreach="task['pieces']" t-as="p">
                                        <span class="modryn_badge is_muted me-1" t-out="p"/>
                                    </t>
                                </div>
                            </td>
                            <td>
                                <span t-if="task['due']"
                                      t-attf-class="modryn_badge #{'is_busy' if task['overdue'] else 'is_muted'}">
                                    <t t-out="task['due']"/>
                                </span>

                                <!-- Nothing in the queue is being worked yet, so
                                     the only move that means anything here is
                                     somebody picking it up. The four state
                                     panels below carry the full set. -->
                                <form action="/atelier/task/move" method="post"
                                      class="d-inline">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="task_id" t-att-value="task['id']"/>
                                    <input type="hidden" name="target" value="in_progress"/>
                                    <button type="submit" class="btn btn-sm btn-primary">I'm on it</button>
                                </form>
                            </td>
                            <td t-if="is_manager" class="text-end">
                                <form action="/atelier/assign" method="post"
                                      class="d-inline-flex gap-1 align-items-center">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="task_id" t-att-value="task['id']"/>
                                    <select name="seamstress_id" class="form-select form-select-sm"
                                            style="width:auto;">
                                        <option value="">Unassigned</option>
                                        <t t-foreach="seamstresses" t-as="s">
                                            <option t-att-value="s.id" t-out="s.name"/>
                                        </t>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-dark">Assign</button>
                                </form>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <!-- One panel per state: the workshop reads left to right as work moves. -->
            <section t-foreach="board['states']" t-as="st" class="modryn_panel mb-4">
                <header class="modryn_panel_head">
                    <h2 t-out="st[1]"/>
                    <span class="modryn_count" t-out="len(board['by_state'][st[0]])"/>
                </header>

                <p t-if="not board['by_state'][st[0]]" class="modryn_empty">Nothing here.</p>

                <table t-else="" class="table modryn_table align-middle">
                    <tbody>
                        <!-- The id is what the routes redirect back to. Every
                             control here is a plain form, so the browser
                             reloads, and a reload lands at the top of a board
                             several screens long - the row she pressed on gone
                             from view, and the press reading as having done
                             nothing at all. -->
                        <tr t-foreach="board['by_state'][st[0]]" t-as="task"
                            t-attf-id="task-#{task['id']}">
                            <td style="width: 1%;">
                                <span t-if="task['priority'] == '2'" class="modryn_badge is_busy">High</span>
                                <span t-elif="task['priority'] == '0'" class="modryn_badge is_muted">Low</span>
                            </td>
                            <td>
                                <div class="modryn_strong" t-out="task['customer']"/>
                                <div class="modryn_sub" dir="ltr" t-out="task['phone']"/>
                            </td>
                            <td>
                                <div t-if="task['dress']" class="modryn_sub">
                                    <t t-out="task['dress']"/>
                                    <t t-if="task['size']"> · <t t-out="task['size']"/></t>
                                </div>
                                <div class="modryn_sub">
                                    <t t-foreach="task['pieces']" t-as="p">
                                        <span class="modryn_badge is_muted me-1" t-out="p"/>
                                    </t>
                                </div>
                            </td>
                            <td>
                                <!-- The instructions and the deadline, both
                                     EDITABLE. They used to be write-once: set
                                     when the task was made and unreachable
                                     afterwards without the Odoo back office. A
                                     date the workshop cannot move stops being
                                     true the first time a bride changes her
                                     fitting. -->
                                <form t-if="st[0] != 'delivered'"
                                      action="/atelier/task/edit" method="post"
                                      class="modryn_task_edit">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="task_id" t-att-value="task['id']"/>
                                    <textarea name="note" rows="2" class="form-control form-control-sm"
                                              placeholder="What needs doing"
                                              t-out="task['note']"/>
                                    <div class="d-flex gap-1 align-items-center mt-1">
                                        <input type="date" name="due_date" dir="ltr"
                                               class="form-control form-control-sm"
                                               t-att-value="task['due_iso']"/>
                                        <button type="submit" class="btn btn-sm btn-outline-dark">Save</button>
                                    </div>
                                </form>
                                <div t-else="" class="modryn_sub" t-out="task['note']"/>
                            </td>
                            <td>
                                <!-- Managers reassign inline; delivered work is settled
                                     history and stays read-only. -->
                                <form t-if="is_manager and st[0] != 'delivered'"
                                      action="/atelier/assign" method="post"
                                      class="d-inline-flex gap-1 align-items-center">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="task_id" t-att-value="task['id']"/>
                                    <select name="seamstress_id" class="form-select form-select-sm"
                                            style="width:auto;">
                                        <option value="">Unassigned</option>
                                        <t t-foreach="seamstresses" t-as="s">
                                            <option t-att-value="s.id"
                                                    t-att-selected="'selected' if task['seamstress_id'] == s.id else None"
                                                    t-out="s.name"/>
                                        </t>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-dark">Save</button>
                                </form>
                                <t t-else="">
                                    <span t-if="task['seamstress']" t-out="task['seamstress']"/>
                                    <span t-else="" class="modryn_sub">Unassigned</span>
                                </t>
                            </td>
                            <td>
                                <span t-if="task['due']"
                                      t-attf-class="modryn_badge #{'is_busy' if task['overdue'] else 'is_muted'}">
                                    <t t-out="task['due']"/>
                                </span>

                                <!-- WHERE THE WORK GOES NEXT. /atelier/advance
                                     has existed for a long time and nothing on
                                     this page ever called it: four state panels
                                     and no way to move a task between them. A
                                     seamstress who picked a dress off the rail
                                     had to go and find a manager.
                                     Every open state is offered, not just the
                                     next one, because moving among them is free
                                     in both directions in the model - which is
                                     what makes a mis-tap repairable by pressing
                                     the one she meant. -->
                                <div t-if="st[0] != 'delivered'" class="modryn_task_moves">
                                    <form t-foreach="board['states']" t-as="to"
                                          t-if="to[0] != st[0]"
                                          action="/atelier/task/move" method="post"
                                          class="d-inline">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="task_id" t-att-value="task['id']"/>
                                        <input type="hidden" name="target" t-att-value="to[0]"/>
                                        <button type="submit"
                                                t-attf-class="btn btn-sm #{'btn-primary' if to[0] == 'in_progress' and st[0] == 'intake' else 'btn-link'}">
                                            <t t-if="to[0] == 'in_progress' and st[0] == 'intake'">I'm on it</t>
                                            <t t-else="" t-out="to[1]"/>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </t>
    </template>

    <!-- Owner-maintained garment pieces — same shape as the roles page. -->
    <template id="manage_pieces" name="Garment pieces">
        <t t-call="modryn_staff.manage_layout">
            <h1 class="mb-2">Garment pieces</h1>
            <p class="text-muted mb-4">
                The parts of a garment your workshop alters. Add whatever this boutique needs.
            </p>

            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

            <form action="/manage/pieces/new" method="post" class="d-flex gap-2 mb-4"
                  style="max-width: 480px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="text" name="name" class="form-control" placeholder="New piece"/>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <table class="table modryn_table align-middle" style="max-width: 480px;">
                <tbody>
                    <tr t-foreach="pieces" t-as="piece"
                        t-attf-class="#{'modryn_archived' if not piece.active else ''}">
                        <td t-out="piece.name"/>
                        <td class="text-end">
                            <form t-attf-action="/manage/pieces/archive/#{piece.id}" method="post"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="piece.active">Archive</t>
                                    <t t-else="">Restore</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

</odoo>
