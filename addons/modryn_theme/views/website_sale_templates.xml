<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Price visibility, storefront side.

        Two touch points because Odoo renders the price twice from different
        templates: the shop grid tile and the product detail page. Both swap the
        number for "Price on request" rather than hiding the row, so the layout
        does not collapse and the client is told why.
    -->

    <!-- Shop grid tile -->
    <template id="products_item_price_visibility"
              inherit_id="website_sale.products_item"
              name="MODRYN: hide price on grid tile">
        <xpath expr="//div[hasclass('product_price')]" position="before">
            <div t-if="not product.modryn_price_visible"
                 class="product_price modryn_price_tbd text-muted">
                <span>Price on request</span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('product_price')][last()]" position="attributes">
            <attribute name="t-if">product.modryn_price_visible</attribute>
        </xpath>
    </template>

    <!-- Product detail page -->
    <template id="product_price_visibility"
              inherit_id="website_sale.product_price"
              name="MODRYN: hide price on product page">
        <xpath expr="//div[@name='product_price']" position="before">
            <div t-if="not product.modryn_price_visible"
                 class="modryn_price_tbd h5 mb-0 text-muted">
                <span>Price on request</span>
            </div>
        </xpath>
        <xpath expr="//div[@name='product_price']" position="attributes">
            <attribute name="t-if">product.modryn_price_visible</attribute>
        </xpath>
    </template>

    <!--
        The stock empty shop is "No product defined" and a dead end. A boutique
        whose catalog is not published yet still takes appointments — say so.
        The xpath targets the empty-state container (both its no-product and
        no-results branches render inside it).
    -->
    <template id="shop_empty_book_cta"
              inherit_id="website_sale.products"
              name="MODRYN: empty shop books a consultation">
        <xpath expr="//div[hasclass('mt128')][hasclass('mb256')]" position="inside">
            <div class="mt-4">
                <a href="/book" class="btn btn-primary">Book a consultation</a>
            </div>
        </xpath>
    </template>

    <!--
        THE BUYING HALF OF THE SHOP, CLOSED.

        modryn.scss has hidden the grid tile's "add to cart" since the theme was
        written and says in its own comment that a display-level removal is not
        the fix. It also never covered the product page, the header, or the cart
        page itself. Signed out, on a dress at eleven thousand shekels, a
        customer was offered: Add to cart, Add to compare, a wishlist, a cart in
        the header, and from it Order - Address - Payment. No payment provider
        is configured, so what that offered was a checkout that fails at the
        last step, which is worse than no checkout at all.

        t-if="False" on the wrapper rather than CSS: a rule in a stylesheet is
        undone by the next stylesheet, and a bride with a reader or a slow
        connection could still reach a button that was only painted away.

        `active="False"` is not used here - these are primary templates that the
        page t-calls, and a deactivated one is a different kind of surprise.
        Emptying them keeps the call site working and says what is intended.
    -->
    <template id="product_no_cart"
              inherit_id="website_sale.cta_wrapper"
              name="MODRYN: no cart, no compare, no wishlist">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>

    <template id="header_no_cart"
              inherit_id="website_sale.header_cart_link"
              name="MODRYN: no cart in the header">
        <!-- Odoo's own switch for this line, set to false rather than a class
             added on top of it: show_cart is what the markup already asks. -->
        <xpath expr="//t[@t-set='show_cart']" position="after">
            <t t-set="show_cart" t-value="False"/>
        </xpath>
    </template>

    <!--
        Odoo's product page carries a small print block that read, under an
        11,000 shekel gown: "Terms and Conditions / 30-day money-back guarantee
        / Shipping: 2-3 Business Days". In English, on a Hebrew page, about a
        dress that is fitted over months and never posted to anybody.

        A money-back guarantee is a promise about money. Leaving it there
        because it is Odoo's default and not ours is not a defence - it is on
        the boutique's page over the boutique's name.

        `active="False"` is right for this one where it was wrong for the cart:
        this is one of Odoo's OPTIONAL page blocks, switched on and off in the
        website editor by exactly this flag, and turning it off is what that
        switch does. Nothing t-calls it expecting content.
    -->
    <record id="website_sale.product_terms_and_conditions" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!--
        THE GRID TILE'S BUYING CHROME, removed rather than painted over.

        modryn.scss hides .o_wsale_product_btn, and the sweep found what a
        stylesheet cannot reach: "Add to Cart", "Compare" and "Handle your
        wishlist from the menu icon" are still IN the page, still read out by a
        screen reader, still found by the browser's own find-on-page, and still
        in English on a Hebrew screen. The comment in that stylesheet has said
        since it was written that a display-level removal is not the fix.
    -->
    <template id="products_item_no_buying"
              inherit_id="website_sale.products_item"
              priority="45"
              name="MODRYN: no buying chrome on the tile">
        <!-- A LITERAL class here, unlike the grid wrapper next door, so
             hasclass is the right test - and the div is inside products_item
             itself, lines 7 to 226 of Odoo's product_tile_templates.xml. -->
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="replace"/>
    </template>

</odoo>
