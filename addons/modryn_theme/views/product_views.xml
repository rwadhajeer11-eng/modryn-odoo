<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Backend: the owner-facing switch, next to the price it governs. -->
    <record id="product_template_form_view_modryn" model="ir.ui.view">
        <field name="name">product.template.form.modryn</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="after">
                <field name="modryn_price_visible"/>
            </field>
        </field>
    </record>

</odoo>
