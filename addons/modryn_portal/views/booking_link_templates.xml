<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The page a reminder SMS points at. One screen, two buttons, no login. -->
    <template id="booking_link" name="Manage your appointment">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5" style="max-width: 520px;">

                    <t t-if="done == 'confirmed'">
                        <h1 class="mb-3">Thank you — see you then</h1>
                        <p class="text-muted mb-4">Your appointment is confirmed.</p>
                    </t>
                    <t t-elif="done == 'cancelled'">
                        <h1 class="mb-3">Your appointment is cancelled</h1>
                        <p class="text-muted mb-4">
                            We hope to see you another time.
                            <a href="/book">Book a new fitting</a>.
                        </p>
                    </t>
                    <t t-else="">
                        <h1 class="mb-3">Your appointment</h1>
                    </t>

                    <div class="p-4 mb-4" style="background:#F6F0E6; border-radius:8px;">
                        <div class="mb-2"><strong>Date:</strong> <t t-out="date"/></div>
                        <div class="mb-2"><strong>Time:</strong> <t t-out="time"/></div>
                        <div t-if="dress" class="mb-2">
                            <strong>Dress:</strong> <t t-out="dress"/>
                            <t t-if="size"> · <t t-out="size"/></t>
                        </div>
                        <div t-if="cancelled" class="text-muted">Cancelled</div>
                    </div>

                    <!-- Buttons only while there is still something to decide. -->
                    <t t-if="not cancelled and not past and not done">
                        <div t-if="terms" class="p-3 mb-4 text-muted small"
                             style="background:#FFFFFF; border:1px solid #E4DACA; border-radius:8px;"
                             t-out="terms"/>
                        <div class="d-flex gap-2">
                            <form t-attf-action="/b/#{token}/confirm" method="post" class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-primary btn-lg">
                                    I'll be there
                                </button>
                            </form>
                            <form t-attf-action="/b/#{token}/cancel" method="post" class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-link">Cancel it</button>
                            </form>
                        </div>
                    </t>

                    <!-- Outside the decide-buttons block on purpose. Once she has
                         tapped "I'll be there" that block is gone, and the page
                         still has one useful thing left to offer.
                         Cancelled is INSIDE this branch, not excluded from it:
                         the .ics carries STATUS:CANCELLED under the same UID, so
                         the tap that added the fitting now retracts it. Hiding
                         the button on a cancelled booking would leave the wrong
                         appointment in her calendar with no way to remove it —
                         she cancelled through this very page.
                         Two <a> elements rather than one with a t-if inside: an
                         <a> starts its own translation unit, so branching within
                         it would fold the markup into the msgid. -->
                    <div t-if="not past" class="mt-4">
                        <a t-if="cancelled" t-attf-href="/b/#{token}/ics"
                           class="btn btn-outline-dark">Remove from calendar</a>
                        <a t-else="" t-attf-href="/b/#{token}/ics"
                           class="btn btn-outline-dark">Add to calendar</a>
                    </div>

                    <p t-if="past and not done" class="text-muted">
                        This appointment has already passed.
                    </p>
                </div>
            </div>
        </t>
    </template>

    <!-- Lives here rather than in modryn_booking: modryn_portal depends on
         modryn_booking, and the reverse is the load cycle documented in
         models/calendar_event.py. -->
    <template id="booking_confirmed_ics"
              inherit_id="modryn_booking.booking_confirmed"
              name="MODRYN: add the booking to a calendar">
        <xpath expr="//a[@href='/shop']" position="before">
            <!-- me-2, not mr-2: Bootstrap's logical margins flip under the RTL
                 storefront. `event` is the record in this context, so the token
                 is one call away. -->
            <a t-attf-href="/b/#{event._modryn_token()}/ics"
               class="btn btn-outline-dark me-2">Add to calendar</a>
        </xpath>
    </template>

</odoo>
