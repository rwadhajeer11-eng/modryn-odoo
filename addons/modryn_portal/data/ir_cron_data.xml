<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Login codes are short-lived secrets; keeping them forever is a
             liability with no upside. Crons are per-database, so every tenant
             prunes its own. -->
        <record id="ir_cron_gc_otp_codes" model="ir.cron">
            <field name="name">MODRYN: purge expired login codes</field>
            <field name="model_id" ref="model_modryn_otp_code"/>
            <field name="state">code</field>
            <field name="code">model._gc_codes()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Every 15 minutes, claiming a 30-minute window: a restart or a slow
             run can never skip an appointment, and the reminded-at stamp stops
             the deliberate overlap from texting anyone twice. -->
        <record id="ir_cron_booking_reminders" model="ir.cron">
            <field name="name">MODRYN: send 24h fitting reminders</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="state">code</field>
            <field name="code">model._modryn_send_reminders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- An unclaimed offer must not hold a slot hostage: after the window
             it lapses and the next person in line is texted. -->
        <record id="ir_cron_expire_offers" model="ir.cron">
            <field name="name">MODRYN: pass on unclaimed waitlist offers</field>
            <field name="model_id" ref="model_modryn_day_waitlist"/>
            <field name="state">code</field>
            <field name="code">model._modryn_expire_offers()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
