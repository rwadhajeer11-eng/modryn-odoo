#: model_terms:ir.ui.view,arch_db:modryn_portal.login
msgid "Enter your phone number and we will text you a code."
msgstr "הזיני את מספר הטלפון שלך ונשלח לך קוד בהודעה."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_form
msgid "I accept the boutique's cancellation and no-show terms"
msgstr "אני מאשרת את תנאי הביטול ואי-ההגעה של הבוטיק"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "I'll be there"
msgstr "אגיע"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.waitlist_joined
msgid "If a place opens up on"
msgstr "אם יתפנה מקום בתאריך"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.cancel_confirm
msgid "Keep my appointment"
msgstr "להשאיר את התור"

#. module: modryn_portal
#: model:ir.actions.server,name:modryn_portal.ir_cron_gc_otp_codes_ir_actions_server
