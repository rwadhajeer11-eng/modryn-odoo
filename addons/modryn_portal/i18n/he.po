msgstr "תוקף הקוד פג. נא לבקש קוד חדש."

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/portal.py:0
msgid "That code is not correct."
msgstr "הקוד אינו נכון."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_form
msgid "That day has filled up again."
msgstr "היום הזה שוב מלא."

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/portal.py:0
msgid "That does not look like a valid phone number."
msgstr "מספר הטלפון אינו תקין."

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/waitlist.py:0
#: model:ir.model.constraint,message:modryn_portal.constraint_calendar_event_modryn_one_live_booking_per_slot
