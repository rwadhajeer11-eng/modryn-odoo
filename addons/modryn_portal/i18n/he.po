#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/models/otp.py:0
msgid "%(code)s is your MODRYN code. It expires in %(minutes)s minutes."
msgstr "%(code)s הוא קוד הכניסה שלך ל-MODRYN. הקוד תקף %(minutes)s דקות."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.waitlist_joined
msgid ", we'll text you first."
msgstr ", נעדכן אותך ראשונה."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "<strong>Date:</strong>"
msgstr "<strong>תאריך:</strong>"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "<strong>Dress:</strong>"
msgstr "<strong>שמלה:</strong>"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "<strong>Time:</strong>"
msgstr "<strong>שעה:</strong>"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_form
msgid "A place has opened up"
msgstr "התפנה מקום"

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/models/day_waitlist.py:0
msgid ""
"A place has opened up on %(date)s. It's yours for the next %(hours)s hours: "
"%(link)s"
msgstr ""
"התפנה מקום בתאריך %(date)s. הוא שמור לך ל-%(hours)s השעות הקרובות: %(link)s"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.waitlist_joined
msgid "Back to booking"
msgstr "חזרה לקביעת תור"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.bookings
msgid "Book a fitting"
msgstr "קביעת תור למדידה"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "Book a new fitting"
msgstr "לקביעת תור חדש"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.bookings
msgid "Cancel"
msgstr "ביטול"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "Cancel it"
msgstr "ביטול התור"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.cancel_confirm
msgid "Cancel this appointment?"
msgstr "לבטל את התור?"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
#: model_terms:ir.ui.view,arch_db:modryn_portal.bookings
msgid "Cancelled"
msgstr "בוטל"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.verify
msgid "Code"
msgstr "קוד"

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/waitlist.py:0
msgid "Consultation: %s"
msgstr "פגישת ייעוץ: %s"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.verify
msgid "Continue"
msgstr "המשך"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.verify
msgid "Enter your code"
msgstr "הזיני את הקוד"

