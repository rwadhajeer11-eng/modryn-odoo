msgstr "MODRYN: ניקוי קודי כניסה שפגו"

#. module: modryn_portal
#: model:ir.actions.server,name:modryn_portal.ir_cron_booking_reminders_ir_actions_server
msgid "MODRYN: send 24h fitting reminders"
msgstr "MODRYN: שליחת תזכורות 24 שעות מראש"

#. module: modryn_portal
#: model:website.menu,name:modryn_portal.menu_my_appointments
#: model_terms:ir.ui.view,arch_db:modryn_portal.bookings
#: model_terms:ir.ui.view,arch_db:modryn_portal.login
msgid "My appointments"
msgstr "התורים שלי"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.bookings
msgid "Past"
msgstr "תורים קודמים"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.login
msgid "Phone number"
msgstr "מספר טלפון"

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/waitlist.py:0
msgid "Please accept the cancellation terms"
msgstr "יש לאשר את תנאי הביטול"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.waitlist_joined
msgid "Please check your phone number and try again."
msgstr "בדקי את מספר הטלפון ונסי שוב."

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/waitlist.py:0
msgid "Please choose a time"
msgstr "יש לבחור שעה"

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/portal.py:0
msgid "Please request a code first."
msgstr "יש לבקש קוד תחילה."

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/models/booking_comms.py:0
msgid ""
"Reminder: your fitting at %(boutique)s is tomorrow, %(date)s at %(time)s. "
"Confirm or cancel: %(link)s"
msgstr ""
"תזכורת: התור שלך ב%(boutique)s מחר, %(date)s בשעה %(time)s. לאישור או ביטול:"
" %(link)s"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_expired
msgid "See available days"
msgstr "לימים הפנויים"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_form
msgid "See other days"
msgstr "לימים אחרים"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.login
msgid "Send me a code"
msgstr "שליחת קוד"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.bookings
msgid "Sign out"
msgstr "יציאה"

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/portal.py:0
msgid "Something went wrong."
msgstr "משהו השתבש."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_form
msgid "Take this place"
msgstr "אני רוצה את המקום הזה"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "Thank you — see you then"
msgstr "תודה — נתראה"

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/portal.py:0
