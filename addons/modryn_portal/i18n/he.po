msgstr "השעה הזו נתפסה הרגע, בחרי שעה אחרת"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_expired
msgid "The place went to the next person waiting — but there are other days."
msgstr "המקום עבר לממתינה הבאה — אבל יש ימים נוספים."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "This appointment has already passed."
msgstr "התור כבר עבר."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_expired
msgid "This offer has passed"
msgstr "ההצעה כבר לא בתוקף"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_form
msgid "Time"
msgstr "שעה"

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/portal.py:0
msgid "Too many attempts. Please request a new code."
msgstr "יותר מדי ניסיונות. נא לבקש קוד חדש."

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/portal.py:0
msgid "Too many codes requested. Please try again in an hour."
msgstr "נשלחו יותר מדי קודים. נא לנסות שוב בעוד שעה."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.bookings
msgid "Upcoming"
msgstr "תורים קרובים"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.verify
msgid "Use a different number"
msgstr "שימוש במספר אחר"

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/controllers/portal.py:0
msgid "We could not send the code. Please try again shortly."
msgstr "לא הצלחנו לשלוח את הקוד. נא לנסות שוב בקרוב."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.waitlist_joined
