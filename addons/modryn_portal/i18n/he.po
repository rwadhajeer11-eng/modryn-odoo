msgstr "לא הצלחנו להוסיף אותך"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "We hope to see you another time."
msgstr "נשמח לראותך בפעם אחרת."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.verify
msgid "We sent a 6-digit code to"
msgstr "שלחנו קוד בן 6 ספרות אל"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.cancel_confirm
msgid "Yes, cancel it"
msgstr "כן, לבטל"

#. module: modryn_portal
#: model:ir.model.constraint,message:modryn_portal.constraint_modryn_day_waitlist_phone_day_uniq
msgid "You are already on the waitlist for that day."
msgstr "את כבר ברשימת ההמתנה ליום הזה."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.bookings
msgid "You have no upcoming appointments."
msgstr "אין לך תורים קרובים."

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.waitlist_joined
msgid "You're on the list"
msgstr "את ברשימה"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "Your appointment"
msgstr "התור שלך"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "Your appointment is cancelled"
msgstr "התור בוטל"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.booking_link
msgid "Your appointment is confirmed."
msgstr "התור אושר."

#. module: modryn_portal
#. odoo-python
#: code:addons/modryn_portal/models/booking_comms.py:0
msgid ""
"Your fitting at %(boutique)s is booked for %(date)s at %(time)s. Manage your"
" appointment: %(link)s"
msgstr ""
"התור שלך ב%(boutique)s נקבע ל-%(date)s בשעה %(time)s. לניהול התור: %(link)s"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.bookings
msgid "· size"
msgstr "· מידה"

#. module: modryn_portal
#: model_terms:ir.ui.view,arch_db:modryn_portal.claim_form
msgid "— it's yours if you'd like it."
msgstr "— הוא שלך אם תרצי."
