<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The Shifts nav link lives in modryn_staff/nav.py now — registered from
         controllers/roster.py, rendered by the one unified staff_layout. -->

    <!-- ================= next week's rota ================= -->
    <template id="roster_page" name="Roster">
        <t t-call="modryn_staff.staff_layout">
            <t t-set="active_tab" t-value="'roster'"/>
            <div class="d-flex align-items-baseline justify-content-between mb-1">
                <h1 class="mb-0">Work schedule</h1>
                <span class="modryn_sub">
                    <t t-esc="week_start.strftime('%d.%m')"/>–<t t-esc="week_end.strftime('%d.%m.%Y')"/>
                </span>
            </div>
            <p class="modryn_sub mb-4">
                <t t-if="is_manager">
                    Tick who is working. A shift turns amber when it is short of the roles it needs.
                </t>
                <t t-else="">
                    Press every shift you can work. Then write us a note and send it.
                </t>
            </p>

            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>
            <!-- Gold, never red. A completed action painted in danger colours
                 was once read by a manager as a rejection; the lesson is
                 recorded in floor.scss and this is the next place it applies. -->
            <div t-if="warning" class="modryn_panel mb-3" role="status">
                <span class="modryn_badge is_busy">Saved</span>
                <span t-out="warning"/>
            </div>

            <div class="modryn_roster_nav mb-3">
                <a t-attf-href="/roster?week=#{week_offset - 1}"
                   t-if="week_offset &gt; -1" class="btn btn-sm btn-outline-dark">Previous week</a>
                <a t-attf-href="/roster?week=#{week_offset + 1}"
                   t-if="week_offset &lt; 1" class="btn btn-sm btn-outline-dark">Following week</a>
            </div>

            <!-- The deadline, stated. A window that only greys a button out is
                 not a deadline anyone can plan around; she has to be able to see
                 when it shuts before she decides to come back later.
                 These times are the boutique's wall clock now — they used to be
                 printed straight out of UTC, three hours early all summer. -->
            <div t-attf-class="modryn_panel mb-3 #{'' if window_open else 'modryn_archived'}">
                <t t-if="window_open">
                    <span class="modryn_badge is_free">Open</span>
                    Submissions close
                    <strong dir="ltr" t-esc="window_closes.strftime('%d.%m %H:%M')"/>
                </t>
                <t t-else="">
                    <span class="modryn_badge is_muted">Closed</span>
                    This week opens
                    <strong dir="ltr" t-esc="window_opens.strftime('%d.%m %H:%M')"/>
                    and closes
                    <strong dir="ltr" t-esc="window_closes.strftime('%d.%m %H:%M')"/>
                </t>
            </div>

            <!-- Manager: when the team may answer. Plain forms, no JS — which is
                 also what keeps them safe outside .modryn_roster_grid, where the
                 delegated listener never reaches. -->
            <details t-if="is_manager" class="modryn_panel mb-3">
                <summary style="cursor:pointer;">
                    <span class="modryn_strong">When can the team answer?</span>
                </summary>

                <p class="modryn_sub mt-2 mb-2">
                    Counting from the Monday of the week before — the week they
                    are answering for starts on the Sunday at the end.
                </p>

                <form action="/roster/window/rule" method="post"
                      class="d-flex gap-2 flex-wrap align-items-end mb-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="week" t-att-value="week_offset"/>
                    <div>
                        <label class="form-label mb-0" for="open_weekday">Opens</label>
                        <select id="open_weekday" name="open_weekday" class="form-select form-select-sm">
                            <t t-foreach="window_days" t-as="wd">
                                <option t-att-value="wd[0]"
                                        t-att-selected="'selected' if wd[0] == window_rule['open_weekday'] else None"
                                        t-out="wd[1]"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-0" for="open_time">at</label>
                        <input id="open_time" type="time" name="open_time" dir="ltr"
                               class="form-control form-control-sm"
                               t-att-value="window_rule['open_time']"/>
                    </div>
                    <div>
                        <label class="form-label mb-0" for="close_weekday">Closes</label>
                        <select id="close_weekday" name="close_weekday" class="form-select form-select-sm">
                            <t t-foreach="window_days" t-as="wd">
                                <option t-att-value="wd[0]"
                                        t-att-selected="'selected' if wd[0] == window_rule['close_weekday'] else None"
                                        t-out="wd[1]"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-0" for="close_time">at</label>
                        <input id="close_time" type="time" name="close_time" dir="ltr"
                               class="form-control form-control-sm"
                               t-att-value="window_rule['close_time']"/>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Save for every week</button>
                </form>

                <!-- The escape hatch. A holiday, a team away day. -->
                <form action="/roster/window/week" method="post"
                      class="d-flex gap-2 flex-wrap align-items-end">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="week" t-att-value="week_offset"/>
                    <div>
                        <label class="form-label mb-0" for="opens_date">Just this week, from</label>
                        <input id="opens_date" type="date" name="opens_date" dir="ltr"
                               class="form-control form-control-sm"/>
                    </div>
                    <div>
                        <input type="time" name="opens_time" dir="ltr"
                               class="form-control form-control-sm" aria-label="Opening time"/>
                    </div>
                    <div>
                        <label class="form-label mb-0" for="closes_date">until</label>
                        <input id="closes_date" type="date" name="closes_date" dir="ltr"
                               class="form-control form-control-sm"/>
                    </div>
                    <div>
                        <input type="time" name="closes_time" dir="ltr"
                               class="form-control form-control-sm" aria-label="Closing time"/>
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-dark">Use these times</button>
                    <button t-if="window_overridden" type="submit" name="clear" value="1"
                            class="btn btn-sm btn-link">Back to the usual</button>
                </form>
            </details>

            <!-- ============ the week, as one table ============
                 INSIDE .modryn_roster_grid on purpose: roster.js binds ONE
                 delegated click listener on this container, so anything
                 rendered outside it looks perfectly fine and does nothing at
                 all when pressed. Twenty-one cells, one listener. -->
            <div class="modryn_roster_grid"
                 t-att-data-week="week_offset"
                 t-att-data-manager="'1' if is_manager else '0'">

                <div class="modryn_avail_scroll">
                    <table class="modryn_avail_table">
                        <thead>
                            <tr>
                                <th><span class="visually-hidden">Shift</span></th>
                                <th t-foreach="days" t-as="d" scope="col">
                                    <span class="modryn_avail_day" t-out="d['weekday']"/>
                                    <span class="modryn_avail_date" dir="ltr" t-out="d['label']"/>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="shift_rows" t-as="row">
                                <th scope="row" t-out="row[1]"/>
                                <td t-foreach="days" t-as="d">
                                    <t t-set="cell" t-value="d['cells'][row_index]"/>
                                    <!-- The label changes with the state, not
                                         just the colour: one man in twelve
                                         cannot tell this gold from this grey,
                                         and a printed rota has no colour at
                                         all. -->
                                    <button type="button"
                                            t-attf-class="modryn_avail_cell #{'is_on' if cell['mine'] else ''}"
                                            t-att-data-day="cell['day']"
                                            t-att-data-type="cell['shift_type']"
                                            t-att-data-slot="cell['slot_ids'][0] if cell['slot_ids'] else None"
                                            t-att-disabled="None if window_open else 'disabled'"
                                            t-attf-aria-label="#{row[1]} #{d['weekday']} #{d['label']}"
                                            t-att-aria-pressed="'true' if cell['mine'] else 'false'">
                                        <t t-if="cell['mine']">
                                            <i class="fa fa-check" aria-hidden="true"/>
                                            <span class="visually-hidden">I can work this</span>
                                        </t>
                                        <t t-else="">
                                            <span class="visually-hidden">Not available</span>
                                        </t>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Her answer for the week: the note, and the act of sending
                     it. Under the table, because that is the order the work
                     happens in — press everything you can work, then say
                     anything else, then send. Separate from the cells on
                     purpose: those are a draft she can change her mind about,
                     this is the moment she tells the manager to build on them. -->
                <div t-if="me and not is_manager" class="modryn_avail_send">
                    <div>
                        <label class="form-label" for="modryn_week_note">
                            Anything we should know?
                        </label>
                        <textarea id="modryn_week_note" class="form-control" rows="2"
                                  t-att-disabled="None if window_open else 'disabled'"
                                  t-out="my_note"/>
                    </div>
                    <div>
                        <button type="button" id="modryn_send_week" class="btn btn-primary"
                                t-att-disabled="None if window_open else 'disabled'">
                            Send my week
                        </button>
                        <span t-if="my_submitted_at" class="modryn_sub ms-2">
                            Sent <span dir="ltr" t-esc="my_submitted_at.strftime('%d.%m %H:%M')"/>
                        </span>
                        <span t-else="" class="modryn_sub ms-2">Not sent yet</span>
                    </div>
                </div>

                <!-- The manager's side: the real shifts, and who offered them.
                     Still one card per SHIFT and not per cell, because this is
                     where she fills a rota — a card carries hours, coverage
                     targets and the people, none of which fit in a 44px box. -->
                <div t-if="is_manager" class="modryn_shift_cards mt-4">
                    <t t-foreach="slots" t-as="slot">
                        <div t-attf-class="modryn_shift_card #{'is_short' if slot['short_total'] else ''} #{'is_published' if slot['published'] else ''}"
                             t-att-data-slot="slot['id']">
                            <div class="modryn_shift_head">
                                <span class="modryn_strong"><t t-esc="slot['name']"/></span>
                                <span class="modryn_sub" dir="ltr">
                                    <t t-esc="slot['day_label']"/> · <t t-esc="slot['hours']"/>
                                </span>
                            </div>

                            <div class="modryn_shift_cover">
                                <t t-if="slot['shortages']">
                                    <t t-foreach="slot['shortages']" t-as="s">
                                        <span t-attf-class="modryn_badge #{'is_busy' if s['short'] else 'is_free'}">
                                            <t t-esc="s['role']"/>
                                            <t t-esc="s['have']"/>/<t t-esc="s['required']"/>
                                        </span>
                                    </t>
                                </t>
                                <span t-else="" class="modryn_sub">No targets set</span>
                            </div>

                            <div t-if="slot['working']" class="modryn_shift_people">
                                <t t-foreach="slot['working']" t-as="w">
                                    <span class="modryn_chip is_primary"><t t-esc="w['name']"/></span>
                                </t>
                            </div>
                            <p t-else="" class="modryn_sub mb-0">Nobody rostered yet</p>

                            <div t-if="not slot['published']" class="modryn_shift_assign">
                                <p class="modryn_sub mb-1">
                                    <t t-if="slot['available']">Offered this shift:</t>
                                    <t t-else="">Nobody has offered yet</t>
                                </p>
                                <t t-foreach="slot['available']" t-as="a">
                                    <label class="modryn_piece_check">
                                        <input type="checkbox" class="modryn_assign_box"
                                               t-att-data-slot="slot['id']"
                                               t-att-data-employee="a['id']"
                                               t-att-checked="'checked' if any(w['id'] == a['id'] for w in slot['working']) else None"/>
                                        <span>
                                            <t t-esc="a['name']"/>
                                            <t t-if="a['role']"> · <t t-esc="a['role']"/></t>
                                        </span>
                                    </label>
                                </t>
                            </div>
                            <p t-else="" class="modryn_sub mb-0">Published</p>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Who has answered, and what she said. One box each, because the
                 note belongs to the WEEK and not to any shift — reading it off
                 a card would mean repeating it on every cell she pressed.
                 A person with no row here has not looked yet, which is a
                 different thing from a person who can work nothing, and the
                 manager has to be able to tell them apart before she chases
                 anyone. -->
            <section t-if="is_manager" class="modryn_panel mt-4">
                <h2 class="h5 mb-3">Answers for this week</h2>
                <p t-if="not submissions" class="modryn_empty mb-0">
                    Nobody has sent their week yet.
                </p>
                <div t-foreach="submissions" t-as="sub" class="mb-3">
                    <span class="modryn_strong" t-out="sub['name']"/>
                    <span t-if="sub['submitted_at']" class="modryn_badge is_free ms-2">
                        Sent <span dir="ltr" t-esc="sub['submitted_at'].strftime('%d.%m %H:%M')"/>
                    </span>
                    <span t-else="" class="modryn_badge is_muted ms-2">Started, not sent</span>
                    <div t-if="sub['note']" class="modryn_sub" t-out="sub['note']"/>
                </div>
            </section>

            <div t-if="is_manager" class="mt-4">
                <button type="button" class="btn btn-primary" id="modryn_publish_week">
                    Publish this week
                </button>
                <span class="modryn_sub ms-2">
                    Once published, the team can see it and availability stops changing.
                </span>
            </div>
        </t>
    </template>

    <!-- ================= owner: the shifts this boutique runs ================= -->
    <template id="manage_shifts" name="Shifts">
        <t t-call="modryn_staff.manage_layout">
            <h1 class="mb-2">Shifts</h1>
            <p class="text-muted mb-4">
                The shifts this boutique actually runs, and how many of each role each one needs.
            </p>

            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>

            <form action="/manage/shifts/new" method="post" class="d-flex gap-2 mb-4 flex-wrap"
                  style="max-width: 720px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="text" name="name" class="form-control" style="max-width: 200px;"
                       placeholder="Shift name"/>
                <select name="weekday" class="form-select" style="max-width: 150px;">
                    <option value="6">Sunday</option>
                    <option value="0">Monday</option>
                    <option value="1">Tuesday</option>
                    <option value="2">Wednesday</option>
                    <option value="3">Thursday</option>
                    <option value="4">Friday</option>
                    <option value="5">Saturday</option>
                </select>
                <select name="shift_type" class="form-select" style="max-width: 150px;"
                        aria-label="Part of the day">
                    <t t-foreach="shift_types" t-as="stype">
                        <option t-att-value="stype[0]" t-out="stype[1]"/>
                    </t>
                </select>
                <input type="number" name="start_hour" class="form-control" style="max-width: 100px;"
                       step="0.5" min="0" max="24" value="10"/>
                <input type="number" name="end_hour" class="form-control" style="max-width: 100px;"
                       step="0.5" min="0" max="24" value="18"/>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <table class="table modryn_table align-middle" style="max-width: 720px;">
                <tbody>
                    <tr t-foreach="templates" t-as="tpl"
                        t-attf-class="#{'modryn_archived' if not tpl.active else ''}">
                        <td>
                            <!-- Inline edit: the list IS the form. Until this
                                 existed, fixing a typo in a shift name meant
                                 archiving the row and typing a new one, which
                                 orphaned its coverage targets and left a dead
                                 row in the list for good.
                                 The day options come from the field's own
                                 selection (weekday_selection()), so they cannot
                                 drift from what the model will accept. -->
                            <form t-attf-action="/manage/shifts/edit/#{tpl.id}" method="post"
                                  class="d-flex gap-1 align-items-center flex-wrap">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <input type="text" name="name" t-att-value="tpl.name"
                                       class="form-control form-control-sm"
                                       style="max-width: 170px;"/>
                                <select name="weekday" class="form-select form-select-sm w-auto">
                                    <t t-foreach="weekdays" t-as="wd">
                                        <option t-att-value="wd[0]"
                                                t-att-selected="'selected' if wd[0] == tpl.weekday else None"
                                                t-out="wd[1]"/>
                                    </t>
                                </select>
                                <select name="shift_type" class="form-select form-select-sm w-auto"
                                        aria-label="Part of the day">
                                    <t t-foreach="shift_types" t-as="stype">
                                        <option t-att-value="stype[0]"
                                                t-att-selected="'selected' if tpl.shift_type == stype[0] else None"
                                                t-out="stype[1]"/>
                                    </t>
                                </select>
                                <input type="number" name="start_hour" step="0.5" min="0" max="24"
                                       t-att-value="tpl.start_hour"
                                       class="form-control form-control-sm" style="max-width: 82px;"/>
                                <input type="number" name="end_hour" step="0.5" min="0" max="24"
                                       t-att-value="tpl.end_hour"
                                       class="form-control form-control-sm" style="max-width: 82px;"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">Save</button>
                            </form>
                            <div class="modryn_sub" t-out="tpl._label()"/>
                        </td>
                        <td>
                            <!-- Targets, one role at a time. Zero removes it. -->
                            <form action="/manage/shifts/target" method="post"
                                  class="d-flex gap-1 align-items-center">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="template_id" t-att-value="tpl.id"/>
                                <select name="role_id" class="form-select form-select-sm w-auto">
                                    <t t-foreach="roles" t-as="role">
                                        <option t-att-value="role.id" t-out="role.name"/>
                                    </t>
                                </select>
                                <input type="number" name="required" min="0" value="1"
                                       class="form-control form-control-sm" style="max-width: 72px;"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">Set</button>
                            </form>
                            <div class="modryn_sub mt-1">
                                <t t-if="tpl.target_ids">
                                    <t t-foreach="tpl.target_ids" t-as="t">
                                        <span class="modryn_badge is_muted">
                                            <t t-out="t.role_id.name"/> ×<t t-out="t.required"/>
                                        </span>
                                    </t>
                                </t>
                                <t t-else="">No targets yet</t>
                            </div>
                        </td>
                        <td class="text-end">
                            <form t-attf-action="/manage/shifts/archive/#{tpl.id}" method="post"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="tpl.active">Archive</t>
                                    <t t-else="">Restore</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

</odoo>
