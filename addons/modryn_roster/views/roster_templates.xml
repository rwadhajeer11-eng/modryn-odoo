<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The Shifts nav link lives in modryn_staff/nav.py now — registered from
         controllers/roster.py, rendered by the one unified staff_layout. -->

    <!-- ================= next week's rota ================= -->
    <template id="roster_page" name="Roster">
        <t t-call="modryn_staff.staff_layout">
            <t t-set="active_tab" t-value="'roster'"/>
            <div class="d-flex align-items-baseline justify-content-between mb-1">
                <h1 class="mb-0">Work schedule</h1>
                <!-- dir="ltr", or the bidi algorithm reads the range
                     right-to-left with the rest of the Hebrew and prints the
                     week as "05.09.2026-30.08" - the end date first, which is
                     not a typo anybody spots, it is a week that looks wrong.
                     Every other date pair on these pages already carries it. -->
                <span class="modryn_sub" dir="ltr">
                    <t t-esc="week_start.strftime('%d.%m')"/>–<t t-esc="week_end.strftime('%d.%m.%Y')"/>
                </span>
            </div>
            <p class="modryn_sub mb-4">
                <t t-if="is_manager">
                    Tick who is working. A shift turns amber when it is short of the roles it needs.
                </t>
                <!-- An instruction she cannot follow is worse than no
                     instruction. "Press every shift you can work" over a
                     twenty-one-cell grid that refuses every press is the whole
                     reason this page was reported as broken. -->
                <t t-elif="can_edit">
                    Press every shift you can work. Then write us a note and send it.
                </t>
                <t t-else="">
                    This week is closed for answers. You can see what you offered,
                    but it can no longer be changed here.
                </t>
            </p>

            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>
            <!-- Gold, never red. A completed action painted in danger colours
                 was once read by a manager as a rejection; the lesson is
                 recorded in floor.scss and this is the next place it applies. -->
            <div t-if="warning" class="modryn_panel mb-3" role="status">
                <span class="modryn_badge is_busy">Saved</span>
                <span t-out="warning"/>
            </div>

            <div class="modryn_roster_nav mb-3">
                <a t-attf-href="/roster?week=#{week_offset - 1}"
                   t-if="week_offset &gt; -1" class="btn btn-sm btn-outline-dark">Previous week</a>
                <a t-attf-href="/roster?week=#{week_offset + 1}"
                   t-if="week_offset &lt; 1" class="btn btn-sm btn-outline-dark">Following week</a>
            </div>

            <!-- The deadline, stated. A window that only greys a button out is
                 not a deadline anyone can plan around; she has to be able to see
                 when it shuts before she decides to come back later.
                 These times are the boutique's wall clock now — they used to be
                 printed straight out of UTC, three hours early all summer. -->
            <div t-attf-class="modryn_panel mb-3 #{'' if can_edit else 'modryn_archived'}">
                <t t-if="can_edit">
                    <span class="modryn_badge is_free">Open</span>
                    Submissions close
                    <strong dir="ltr" t-esc="window_closes.strftime('%d.%m %H:%M')"/>
                </t>
                <!-- THREE reasons a week is shut, and each one is a different
                     sentence. They used to share the one "closed" line, which
                     told a woman looking at a rota she is already working that
                     it "opens Thursday" - true of the window, and nonsense
                     about the week in front of her. -->
                <t t-elif="lock_reason == 'current'">
                    <span class="modryn_badge is_muted">This week</span>
                    You are working this week already, so there is nothing left to
                    answer for it. Use <strong>Following week</strong> to fill in the
                    week being planned.
                </t>
                <!-- A shut door with nowhere to go is the complaint this
                     whole page was reported under. Every locked state now names
                     the week she CAN answer for, because "you cannot do this
                     here" without "here is where you can" is the same dead end
                     the blank refusal was. -->
                <t t-elif="lock_reason == 'published'">
                    <span class="modryn_badge is_muted">Published</span>
                    The schedule for this week is out, so it can no longer be
                    changed here — ask your manager. What you offered is below.
                    Use <strong>Following week</strong> to answer for the next one.
                </t>
                <t t-elif="lock_reason == 'passed'">
                    <span class="modryn_badge is_muted">Closed</span>
                    Answers for this week closed
                    <strong dir="ltr" t-esc="window_closes.strftime('%d.%m %H:%M')"/>.
                    What you offered is below, and it stands as it is.
                </t>
                <t t-else="">
                    <span class="modryn_badge is_muted">Not open yet</span>
                    This week opens
                    <strong dir="ltr" t-esc="window_opens.strftime('%d.%m %H:%M')"/>
                    and closes
                    <strong dir="ltr" t-esc="window_closes.strftime('%d.%m %H:%M')"/>
                </t>
            </div>

            <!-- Her own answer, in words, whenever the grid is locked. Locked
                 means she cannot CHANGE it; it was never supposed to mean she
                 cannot read it, and a grey grid of ticks is not something
                 anybody reads off a phone. -->
            <div t-if="me and not is_manager and not can_edit" class="modryn_panel mb-3">
                <div class="modryn_strong mb-1">What you offered</div>
                <t t-if="my_picks">
                    <div t-foreach="my_picks" t-as="p" class="modryn_sub">
                        <span t-out="p['weekday']"/>
                        <span dir="ltr" t-out="p['label']"/> —
                        <span t-out="', '.join(p['parts'])"/>
                    </div>
                </t>
                <div t-else="" class="modryn_sub">Nothing this week.</div>
            </div>

            <!-- The manager's window controls used to sit here, behind a
                 fold: a standing rule, and an override for one week. They are on
                 משמרות now, beside the rota they actually govern - this screen
                 is the one every woman on the floor opens, and two audiences on
                 one page made the manager's half the half nobody could find.
                 The deadline BANNER above stays: that is not a control, it is
                 the thing she has to meet. -->


            <!-- ============ the week, as one table ============
                 INSIDE .modryn_roster_grid on purpose: roster.js binds ONE
                 delegated click listener on this container, so anything
                 rendered outside it looks perfectly fine and does nothing at
                 all when pressed. Twenty-one cells, one listener. -->
            <div t-attf-class="modryn_roster_grid #{'' if can_edit else 'is_locked'}"
                 t-att-data-week="week_offset"
                 t-att-data-can-edit="'1' if can_edit else '0'"
                 t-att-data-manager="'1' if is_manager else '0'">

                <div class="modryn_avail_scroll">
                    <table class="modryn_avail_table">
                        <thead>
                            <tr>
                                <th><span class="visually-hidden">Shift</span></th>
                                <th t-foreach="days" t-as="d" scope="col">
                                    <span class="modryn_avail_day" t-out="d['weekday']"/>
                                    <span class="modryn_avail_date" dir="ltr" t-out="d['label']"/>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="shift_rows" t-as="row">
                                <th scope="row" t-out="row[1]"/>
                                <td t-foreach="days" t-as="d">
                                    <t t-set="cell" t-value="d['cells'][row_index]"/>
                                    <!-- The label changes with the state, not
                                         just the colour: one man in twelve
                                         cannot tell this gold from this grey,
                                         and a printed rota has no colour at
                                         all. -->
                                    <button type="button"
                                            t-attf-class="modryn_avail_cell #{'is_on' if cell['mine'] else ''}"
                                            t-att-data-day="cell['day']"
                                            t-att-data-type="cell['shift_type']"
                                            t-att-data-slot="cell['slot_ids'][0] if cell['slot_ids'] else None"
                                            t-att-disabled="None if can_edit else 'disabled'"
                                            t-attf-aria-label="#{row[1]} #{d['weekday']} #{d['label']}"
                                            t-att-aria-pressed="'true' if cell['mine'] else 'false'">
                                        <t t-if="cell['mine']">
                                            <i class="fa fa-check" aria-hidden="true"/>
                                            <span class="visually-hidden">I can work this</span>
                                        </t>
                                        <t t-else="">
                                            <span class="visually-hidden">Not available</span>
                                        </t>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Her answer for the week: the note, and the act of sending
                     it. Under the table, because that is the order the work
                     happens in — press everything you can work, then say
                     anything else, then send. Separate from the cells on
                     purpose: those are a draft she can change her mind about,
                     this is the moment she tells the manager to build on them. -->
                <div t-if="me and not is_manager" class="modryn_avail_send">
                    <div>
                        <label class="form-label" for="modryn_week_note">
                            Anything we should know?
                        </label>
                        <textarea id="modryn_week_note" class="form-control" rows="2"
                                  t-att-disabled="None if can_edit else 'disabled'"
                                  t-out="my_note"/>
                    </div>
                    <div>
                        <button type="button" id="modryn_send_week" class="btn btn-primary"
                                t-att-disabled="None if can_edit else 'disabled'">
                            Send my week
                        </button>
                        <span t-if="my_submitted_at" class="modryn_sub ms-2">
                            Sent <span dir="ltr" t-esc="my_submitted_at.strftime('%d.%m %H:%M')"/>
                        </span>
                        <span t-else="" class="modryn_sub ms-2">Not sent yet</span>
                    </div>
                </div>

                <!-- The manager's shift cards used to sit here: the week's
                     real shifts, their coverage targets, and a tick per person
                     to roster her. משמרות draws all of it - the same week, the
                     same targets, the same people, and clicking a name there
                     rosters her exactly as ticking her here did.
                     Deleted rather than moved, because two screens doing one
                     job is how they start disagreeing, and this pair could:
                     a manager could roster a woman from either one. -->
            </div>

            <!-- The answers panel moved to משמרות, which is where the rota is
                 actually stood: "who has sent their week" is the question a
                 manager asks in the same breath as filling it in, and it was
                 the one thing here she could not get on that screen. -->

            <!-- Publishing lives on משמרות, which has the same button and the
                 same sentence beside it. Two publish buttons for one week is one
                 too many even while they agree. The "already published" notice
                 went with it - that is the same block in its other state. -->

        </t>
    </template>

    <!-- ================= owner: the shifts this boutique runs ================= -->
    <!-- ============ standing next week, on the shifts screen ============ -->
    <!-- Here and not only on /roster because the two jobs are different: that
         page is where a saleswoman answers for her own week, this is where
         somebody builds one out of everybody's answers. The forms and presses
         go to the SAME routes - there is one rota. -->
    <template id="manage_week_planner" name="MODRYN week planner">
        <section t-if="is_manager" class="modryn_panel mb-4 modryn_planner">
            <header class="modryn_panel_head">
                <h2>Next week's rota</h2>
                <span t-if="week_published" class="modryn_badge is_free">Published</span>
                <span t-elif="window_open_now" class="modryn_badge is_wait">Open for answers</span>
                <span t-else="" class="modryn_badge is_muted">Closed</span>
            </header>
            <!-- The date on its own. "Week of <date>." split around the t-out
                 and extracted as the bare fragment "Week of", which a
                 translator cannot put in her own word order. The heading above
                 already says what week this is. -->
            <p class="modryn_sub" dir="ltr" t-out="week_start.strftime('%d.%m.%Y')"/>

            <!-- WHEN the team may answer, both halves of it. These moved off
                 סידור עבודה, which is the screen every woman on the floor opens
                 to answer - the controls governing WHETHER she may answer
                 belong beside the rota, not behind a fold on her page.
                 Labelled apart on purpose. From two screens away these were the
                 easiest pair in the product to confuse: one sets every week
                 from now on, the other sets this week and nothing else. -->
            <t t-if="window_settable">
                <h3 class="h6 mb-1">When the team may answer</h3>
                <p class="modryn_sub mb-2">
                    The rule holds every week. The dates under it change this
                    week only — for a holiday, or a day the team is away.
                </p>
                <form action="/roster/window/rule" method="post"
                      class="d-flex gap-2 flex-wrap align-items-end mb-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="week" t-att-value="str(week_offset)"/>
                    <div>
                        <label class="form-label mb-0" for="open_weekday">Opens</label>
                        <select id="open_weekday" name="open_weekday" class="form-select form-select-sm">
                            <t t-foreach="window_days" t-as="wd">
                                <option t-att-value="wd[0]"
                                        t-att-selected="'selected' if wd[0] == window_rule['open_weekday'] else None"
                                        t-out="wd[1]"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-0" for="open_time">at</label>
                        <input id="open_time" type="time" name="open_time" dir="ltr"
                               class="form-control form-control-sm"
                               t-att-value="window_rule['open_time']"/>
                    </div>
                    <div>
                        <label class="form-label mb-0" for="close_weekday">Closes</label>
                        <select id="close_weekday" name="close_weekday" class="form-select form-select-sm">
                            <t t-foreach="window_days" t-as="wd">
                                <option t-att-value="wd[0]"
                                        t-att-selected="'selected' if wd[0] == window_rule['close_weekday'] else None"
                                        t-out="wd[1]"/>
                            </t>
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-0" for="close_time">at</label>
                        <input id="close_time" type="time" name="close_time" dir="ltr"
                               class="form-control form-control-sm"
                               t-att-value="window_rule['close_time']"/>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Save for every week</button>
                </form>
            </t>
            <p t-else="" class="modryn_sub mb-3">
                This week is already being worked, so there is nothing left to
                answer for it. Move to the week being planned to set when
                submissions open.
            </p>

            <form action="/roster/window/week" method="post"
                  class="modryn_planner_window">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="week" t-att-value="str(week_offset)"/>
                <div>
                    <label class="form-label">Answers open</label>
                    <div class="d-flex gap-1">
                        <input type="date" name="opens_date" class="form-control form-control-sm"
                               t-att-value="window_opens.strftime('%Y-%m-%d') if window_opens else ''"/>
                        <input type="time" name="opens_time" class="form-control form-control-sm"
                               t-att-value="window_opens.strftime('%H:%M') if window_opens else ''"/>
                    </div>
                </div>
                <div>
                    <label class="form-label">and close</label>
                    <div class="d-flex gap-1">
                        <input type="date" name="closes_date" class="form-control form-control-sm"
                               t-att-value="window_closes.strftime('%Y-%m-%d') if window_closes else ''"/>
                        <input type="time" name="closes_time" class="form-control form-control-sm"
                               t-att-value="window_closes.strftime('%H:%M') if window_closes else ''"/>
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-end">
                    <button type="submit" class="btn btn-sm btn-outline-dark">Set</button>
                    <button type="submit" name="clear" value="1"
                            class="btn btn-sm btn-link">Clear</button>
                </div>
            </form>

            <div class="modryn_planner_grid">
                <div t-foreach="week_days" t-as="day" t-key="day['date']"
                     class="modryn_planner_day">
                    <div class="modryn_strong" t-out="day['label']"/>
                    <p t-if="not day['slots']" class="modryn_sub mb-0">No shift.</p>
                    <div t-foreach="day['slots']" t-as="slot" t-key="slot['id']"
                         class="modryn_planner_cell">
                        <div class="modryn_sub">
                            <t t-out="slot['name']"/>
                            <span dir="ltr" t-out="slot['hours']"/>
                        </div>
                        <!-- WHAT THIS SHIFT NEEDS, from the targets table
                             further down this same page. Without it a manager
                             filling the week is guessing: she can see who
                             offered and who is on, and nothing tells her that
                             Wednesday wants two saleswomen and a seamstress.
                             Gold while a role is still short, quiet once it is
                             covered, so the eye finds the holes. -->
                        <div t-if="slot['shortages']" class="modryn_planner_need">
                            <span t-foreach="slot['shortages']" t-as="need" t-key="need['role']"
                                  t-attf-class="modryn_badge #{'is_wait' if need['short'] else 'is_free'}">
                                <t t-out="need['have']"/>/<t t-out="need['required']"/>
                                <t t-out="need['role']"/>
                            </span>
                        </div>
                        <!-- ON the shift. Pressing one takes her off again: a
                             manager who mis-taps has to be able to undo it
                             without going anywhere else. -->
                        <div t-if="slot['working']" class="modryn_planner_on">
                            <button t-foreach="slot['working']" t-as="w" t-key="w['id']"
                                    type="button"
                                    class="modryn_badge is_free modryn_planner_pick"
                                    t-att-data-slot="str(slot['id'])"
                                    t-att-data-employee="str(w['id'])"
                                    data-working="0"
                                    t-out="w['name']"/>
                        </div>
                        <!-- OFFERED it and not on it yet. These are the women
                             who said they could work this shift, which is the
                             question a planner is asking. -->
                        <div t-if="slot['available']" class="modryn_planner_free">
                            <button t-foreach="slot['available']" t-as="a" t-key="a['id']"
                                    type="button"
                                    class="modryn_badge is_muted modryn_planner_pick"
                                    t-att-data-slot="str(slot['id'])"
                                    t-att-data-employee="str(a['id'])"
                                    data-working="1"
                                    t-out="a['name']"/>
                        </div>
                        <div t-if="not slot['working'] and not slot['available']"
                             class="modryn_sub">Nobody offered.</div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center mt-3">
                <button type="button" class="btn btn-primary modryn_planner_publish"
                        t-att-data-week="str(week_offset)"
                        t-att-disabled="'disabled' if week_published else None">
                    Publish the week
                </button>
                <span class="modryn_sub">
                    Everybody gets told, whether or not they are on it.
                </span>
            </div>
        </section>
    </template>

    <template id="manage_shifts" name="Shifts">
        <t t-call="modryn_staff.manage_layout">
            <h1 class="mb-2">Shifts</h1>
            <!-- ABOVE the owner-only block, which is where this used to live.
                 The window routes redirect here now and a MANAGER may set the
                 window, so an error buried inside `t-if="is_owner"` is an error
                 the one person who caused it cannot see - she would read a
                 refused save as a save. -->
            <div t-if="error" class="modryn_field_error mb-3" role="alert" t-out="error"/>
            <!-- Same shape as the roster page's, because it is the same message
                 arriving from the same routes - which redirect here now. -->
            <div t-if="warning" class="modryn_panel mb-3" role="status">
                <span class="modryn_badge is_busy">Saved</span>
                <span t-out="warning"/>
            </div>
            <t t-call="modryn_roster.manage_week_planner"/>

            <!-- Who has answered, and what she said. One box each, because the
                 note belongs to the WEEK and not to any shift — reading it off
                 a card would mean repeating it on every cell she pressed.
                 A person with no row here has not looked yet, which is a
                 different thing from a person who can work nothing, and the
                 manager has to be able to tell them apart before she chases
                 anyone. -->
            <section t-if="is_manager" class="modryn_panel mt-4">
                <h2 class="h5 mb-3">Answers for this week</h2>
                <p t-if="not submissions" class="modryn_empty mb-0">
                    Nobody has sent their week yet.
                </p>
                <div t-foreach="submissions" t-as="sub" class="mb-3">
                    <span class="modryn_strong" t-out="sub['name']"/>
                    <span t-if="sub['submitted_at']" class="modryn_badge is_free ms-2">
                        Sent <span dir="ltr" t-esc="sub['submitted_at'].strftime('%d.%m %H:%M')"/>
                    </span>
                    <span t-else="" class="modryn_badge is_muted ms-2">Started, not sent</span>
                    <div t-if="sub['note']" class="modryn_sub" t-out="sub['note']"/>
                </div>
            </section>

            <!-- Everything below defines what shifts EXIST, which stays the
                 owner's. A manager stands next week out of the shifts the
                 boutique runs; inventing one is a decision about the business,
                 and the routes refuse her anyway - this is so the page does not
                 offer her buttons that 404. -->
            <t t-if="is_owner">
            <p class="text-muted mb-4">
                The shifts this boutique actually runs, and how many of each role each one needs.
            </p>

            <form action="/manage/shifts/new" method="post" class="d-flex gap-2 mb-4 flex-wrap"
                  style="max-width: 720px;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="text" name="name" class="form-control" style="max-width: 200px;"
                       placeholder="Shift name"/>
                <select name="weekday" class="form-select" style="max-width: 150px;">
                    <option value="6">Sunday</option>
                    <option value="0">Monday</option>
                    <option value="1">Tuesday</option>
                    <option value="2">Wednesday</option>
                    <option value="3">Thursday</option>
                    <option value="4">Friday</option>
                    <option value="5">Saturday</option>
                </select>
                <select name="shift_type" class="form-select" style="max-width: 150px;"
                        aria-label="Part of the day">
                    <t t-foreach="shift_types" t-as="stype">
                        <option t-att-value="stype[0]" t-out="stype[1]"/>
                    </t>
                </select>
                <input type="number" name="start_hour" class="form-control" style="max-width: 100px;"
                       step="0.5" min="0" max="24" value="10"/>
                <input type="number" name="end_hour" class="form-control" style="max-width: 100px;"
                       step="0.5" min="0" max="24" value="18"/>
                <button type="submit" class="btn btn-primary">Add</button>
            </form>

            <table class="table modryn_table align-middle" style="max-width: 720px;">
                <tbody>
                    <tr t-foreach="templates" t-as="tpl"
                        t-attf-class="#{'modryn_archived' if not tpl.active else ''}">
                        <td>
                            <!-- Inline edit: the list IS the form. Until this
                                 existed, fixing a typo in a shift name meant
                                 archiving the row and typing a new one, which
                                 orphaned its coverage targets and left a dead
                                 row in the list for good.
                                 The day options come from the field's own
                                 selection (weekday_selection()), so they cannot
                                 drift from what the model will accept. -->
                            <form t-attf-action="/manage/shifts/edit/#{tpl.id}" method="post"
                                  class="d-flex gap-1 align-items-center flex-wrap">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <input type="text" name="name" t-att-value="tpl.name"
                                       class="form-control form-control-sm"
                                       style="max-width: 170px;"/>
                                <select name="weekday" class="form-select form-select-sm w-auto">
                                    <t t-foreach="weekdays" t-as="wd">
                                        <option t-att-value="wd[0]"
                                                t-att-selected="'selected' if wd[0] == tpl.weekday else None"
                                                t-out="wd[1]"/>
                                    </t>
                                </select>
                                <select name="shift_type" class="form-select form-select-sm w-auto"
                                        aria-label="Part of the day">
                                    <t t-foreach="shift_types" t-as="stype">
                                        <option t-att-value="stype[0]"
                                                t-att-selected="'selected' if tpl.shift_type == stype[0] else None"
                                                t-out="stype[1]"/>
                                    </t>
                                </select>
                                <input type="number" name="start_hour" step="0.5" min="0" max="24"
                                       t-att-value="tpl.start_hour"
                                       class="form-control form-control-sm" style="max-width: 82px;"/>
                                <input type="number" name="end_hour" step="0.5" min="0" max="24"
                                       t-att-value="tpl.end_hour"
                                       class="form-control form-control-sm" style="max-width: 82px;"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">Save</button>
                            </form>
                            <div class="modryn_sub" t-out="tpl._label()"/>
                        </td>
                        <td>
                            <!-- Targets, one role at a time. Zero removes it. -->
                            <form action="/manage/shifts/target" method="post"
                                  class="d-flex gap-1 align-items-center">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="template_id" t-att-value="tpl.id"/>
                                <select name="role_id" class="form-select form-select-sm w-auto">
                                    <t t-foreach="roles" t-as="role">
                                        <option t-att-value="role.id" t-out="role.name"/>
                                    </t>
                                </select>
                                <input type="number" name="required" min="0" value="1"
                                       class="form-control form-control-sm" style="max-width: 72px;"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">Set</button>
                            </form>
                            <div class="modryn_sub mt-1">
                                <t t-if="tpl.target_ids">
                                    <t t-foreach="tpl.target_ids" t-as="t">
                                        <span class="modryn_badge is_muted">
                                            <t t-out="t.role_id.name"/> ×<t t-out="t.required"/>
                                        </span>
                                    </t>
                                </t>
                                <t t-else="">No targets yet</t>
                            </div>
                        </td>
                        <td class="text-end">
                            <form t-attf-action="/manage/shifts/archive/#{tpl.id}" method="post"
                                  class="d-inline">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-sm btn-outline-dark">
                                    <t t-if="tpl.active">Archive</t>
                                    <t t-else="">Restore</t>
                                </button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
            </t>
        </t>
    </template>

</odoo>
