<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The language picker, shared by both platform screens. -->
    <template id="platform_lang_picker" name="MODRYN platform language">
        <form action="/platform/lang" method="post" class="d-inline ms-3">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input type="hidden" name="redirect" t-att-value="request.httprequest.path"/>
            <i class="fa fa-globe text-muted" aria-hidden="true"/>
            <select name="lang" class="border-0 bg-transparent small"
                    aria-label="Language" onchange="this.form.submit()">
                <t t-foreach="request.env['res.lang'].sudo().search([])" t-as="l">
                    <option t-att-value="l.code"
                            t-att-selected="'selected' if l.code == (request.env.lang or '') else None"
                            t-out="l.name"/>
                </t>
            </select>
            <!-- The button is not decoration: see the docstring above. -->
            <button type="submit" class="btn btn-link p-0 small text-muted"
                    aria-label="Apply language">
                <i class="fa fa-check" aria-hidden="true"/>
            </button>
        </form>
    </template>

    <!-- MODRYN's own screen. Wears web.frontend_layout directly rather than
         modryn_staff's shell: this module never depends on modryn_staff and is
         never installed beside it, because that shell's navbar links to /floor
         and /atelier — pages that do not exist in a platform database. -->
    <template id="boutique_register" name="MODRYN boutique register">
        <t t-call="modryn_platform.platform_shell">
            <t t-set="here" t-value="'boutiques'"/>
            <div>
                <h1>Boutiques</h1>
                <p class="modryn_plat_lead">
                    Every shop that subscribes to MODRYN. This is the platform's own
                    register — it is not read out of any boutique's database, and no
                    boutique can see it.
                </p>

                <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>

                <!-- Add. Native details/summary, no JS: this page is a register
                     somebody fills in occasionally, not an application. -->
                <details class="mb-4" t-att-open="'open' if error else None">
                    <summary style="cursor:pointer;"><h2 class="h5 d-inline">Add a boutique</h2></summary>
                    <form action="/platform/boutiques/new" method="post" class="row g-2 mt-2">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="col-md-2">
                            <label class="form-label" for="p_code">Number</label>
                            <input id="p_code" type="text" name="code" class="form-control"
                                   dir="ltr" inputmode="numeric" pattern="[0-9]{4}"
                                   maxlength="4" placeholder="0042"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="p_name">Name</label>
                            <input id="p_name" type="text" name="name" class="form-control"/>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="p_city">City</label>
                            <input id="p_city" type="text" name="city" class="form-control"/>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="p_street">Street</label>
                            <input id="p_street" type="text" name="street" class="form-control"/>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="p_slug">Subdomain</label>
                            <input id="p_slug" type="text" name="slug" class="form-control"
                                   dir="ltr" placeholder="bella"/>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="p_type">Subscription</label>
                            <select id="p_type" name="subscription_type_id" class="form-select">
                                <option value="">—</option>
                                <t t-foreach="types" t-as="ty">
                                    <option t-att-value="ty.id" t-out="ty.name"/>
                                </t>
                            </select>
                        </div>

                        <!-- AS MANY PARTNERS AS THE SHOP HAS. Two blank pairs
                             are served, and the button adds another, and
                             another. Blank rows are dropped server-side, so a
                             one-owner shop costs no clicks either.

                             The button is hidden until rows.js shows it: with
                             the script gone the two rows still save, and nobody
                             is left pressing something that does nothing. -->
                        <div class="col-12" data-modryn-rows="partners">
                            <hr class="my-2"/>
                            <label class="form-label">Partners</label>
                            <div data-modryn-stack="1">
                                <div t-foreach="[1, 2]" t-as="n"
                                     class="row g-2 mb-2" data-modryn-row="1">
                                    <div class="col-7">
                                        <input type="text" name="partner_name"
                                               class="form-control" placeholder="Partner"/>
                                    </div>
                                    <div class="col-5">
                                        <input type="text" name="partner_phone" dir="ltr"
                                               class="form-control" placeholder="Phone"/>
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn_quiet"
                                    data-modryn-add="1" hidden="hidden">
                                Add another partner
                            </button>
                            <p class="modryn_plat_sub mb-0 mt-2">
                                Fill as many as the shop has. Blank rows are
                                ignored.
                            </p>
                        </div>

                        <!-- WHAT MODRYN HANDED THIS SHOP TO SIGN IN WITH. The
                             real accounts live in the boutique's own database;
                             these are the platform's note of what was issued,
                             which is the question nobody could answer without
                             opening that database.

                             Several, because a shop with two partners gets two
                             accounts and a register holding one would be
                             describing half the shop. -->
                        <div class="col-12" data-modryn-rows="accounts">
                            <hr class="my-2"/>
                            <label class="form-label">Sign-ins issued to this shop</label>
                            <div data-modryn-stack="1">
                                <div t-foreach="[1, 2]" t-as="n"
                                     class="row g-2 mb-2" data-modryn-row="1">
                                    <div class="col-4">
                                        <input type="text" name="account_username"
                                               class="form-control" dir="ltr"
                                               autocomplete="off" placeholder="Username"/>
                                    </div>
                                    <div class="col-4">
                                        <input type="text" name="account_password"
                                               class="form-control" dir="ltr"
                                               autocomplete="off" placeholder="Password"/>
                                    </div>
                                    <div class="col-4">
                                        <input type="text" name="account_holder"
                                               class="form-control" placeholder="Whose it is"/>
                                    </div>
                                </div>
                            </div>
                            <button type="button" class="btn_quiet"
                                    data-modryn-add="1" hidden="hidden">
                                Add another sign-in
                            </button>
                        </div>
                        <div class="col-12">
                            <p class="modryn_plat_sub mb-0">
                                Kept so it can be read back, which means it is
                                kept readable. No other screen shows it.
                            </p>
                        </div>

                        <div class="col-12 mt-2">
                            <button type="submit" class="btn_gold">Add boutique</button>
                        </div>
                    </form>
                </details>

                <p t-if="not shops" class="text-muted">
                    No boutiques yet. Add the first one above.
                </p>

                <div class="modryn_plat_scroll">
                <table t-if="shops" class="modryn_plat_table">
                    <thead>
                        <tr>
                            <th>No.</th><th>Name</th><th>Where</th>
                            <th>Partners</th><th>Subscription</th><th/>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="shops" t-as="shop">
                        <tr>
                            <td dir="ltr" t-out="shop['code']"/>
                            <td>
                                <strong t-out="shop['name']"/>
                                <div t-if="shop['slug']" class="modryn_plat_sub" dir="ltr"
                                     t-out="shop['slug']"/>
                            </td>
                            <td>
                                <t t-out="shop['city']"/>
                                <t t-if="shop['street']">, <t t-out="shop['street']"/></t>
                            </td>
                            <td>
                                <div t-foreach="shop['partners']" t-as="p" class="small">
                                    <t t-out="p['name']"/>
                                    <span t-if="p['phone']" dir="ltr" class="modryn_plat_sub">
                                        · <t t-out="p['phone']"/>
                                    </span>
                                </div>
                                <span t-if="not shop['partners']" class="modryn_plat_sub">—</span>
                                <div t-if="shop['accounts']" class="modryn_plat_sub">
                                    <i class="fa fa-key" aria-hidden="true"/>
                                    <t t-out="len(shop['accounts'])"/>
                                </div>
                            </td>
                            <td>
                                <!-- Editable in place: a shop moving up a tier is
                                     the single most common change to this row,
                                     and it should not need the whole form. -->
                                <form t-attf-action="/platform/boutiques/edit/#{shop['id']}"
                                      method="post" class="d-flex gap-1">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <select name="subscription_type_id"
                                            class="form-select form-select-sm w-auto">
                                        <option value="">-</option>
                                        <t t-foreach="types" t-as="ty">
                                            <option t-att-value="ty.id"
                                                    t-att-selected="'selected' if ty.name == shop['subscription'] else None"
                                                    t-out="ty.name"/>
                                        </t>
                                    </select>
                                    <button type="submit" class="btn_quiet">Save</button>
                                </form>
                            </td>
                            <td class="text-end">
                                <!-- Archiving ASKS. It used to happen on one
                                     press and the row simply left the list,
                                     which is also what pressing the wrong row
                                     looks like. A details/summary rather than a
                                     script: a confirmation that depends on
                                     JavaScript is one that can silently not
                                     happen. -->
                                <details class="modryn_plat_ask">
                                    <summary class="btn_quiet">Archive</summary>
                                    <div class="modryn_plat_confirm">
                                        <div class="modryn_plat_sub">
                                            Archive this boutique? It leaves the
                                            list and moves into the archive.
                                        </div>
                                        <form t-attf-action="/platform/boutiques/archive/#{shop['id']}"
                                              method="post">
                                            <input type="hidden" name="csrf_token"
                                                   t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn_gold">Yes, archive</button>
                                        </form>
                                    </div>
                                </details>
                            </td>
                        </tr>
                        <!-- The whole shop, one row down and folded away. On the
                             row it would be twelve fields wide; behind a
                             disclosure it is a form somebody opened on purpose. -->
                        <tr>
                            <td colspan="6" class="p-0">
                                <details class="modryn_plat_edit">
                                    <summary>Edit everything</summary>
                                    <form t-attf-action="/platform/boutiques/edit/#{shop['id']}"
                                          method="post" class="row g-2 p-3">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label">Shop number</label>
                                            <input type="text" name="code" dir="ltr"
                                                   class="form-control form-control-sm"
                                                   t-att-value="shop['code']"/>
                                        </div>
                                        <div class="col-6 col-md-4">
                                            <label class="form-label">Name</label>
                                            <input type="text" name="name"
                                                   class="form-control form-control-sm"
                                                   t-att-value="shop['name']"/>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label">City</label>
                                            <input type="text" name="city"
                                                   class="form-control form-control-sm"
                                                   t-att-value="shop['city']"/>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label">Street</label>
                                            <input type="text" name="street"
                                                   class="form-control form-control-sm"
                                                   t-att-value="shop['street']"/>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label">Subdomain</label>
                                            <input type="text" name="slug" dir="ltr"
                                                   class="form-control form-control-sm"
                                                   t-att-value="shop['slug']"/>
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label">Subscription</label>
                                            <select name="subscription_type_id"
                                                    class="form-select form-select-sm">
                                                <option value="">-</option>
                                                <t t-foreach="types" t-as="ty">
                                                    <option t-att-value="ty.id"
                                                            t-att-selected="'selected' if ty.name == shop['subscription'] else None"
                                                            t-out="ty.name"/>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <label class="form-label">Note</label>
                                            <input type="text" name="note"
                                                   class="form-control form-control-sm"
                                                   t-att-value="shop['note']"/>
                                        </div>

                                        <!-- Partners, as many as the shop has.
                                             Every existing one is a row that can
                                             be emptied to drop it, one blank pair
                                             waits at the end, and the button
                                             makes another whenever he wants one.

                                             The blank row is LAST on purpose:
                                             the button clones the last row, and
                                             cloning a filled one would copy a
                                             partner's name into the new pair. -->
                                        <div class="col-12" data-modryn-rows="partners">
                                            <label class="form-label">Partners</label>
                                            <div data-modryn-stack="1">
                                                <div t-foreach="shop['partners']" t-as="p"
                                                     class="row g-2 mb-2" data-modryn-row="1">
                                                    <div class="col-7">
                                                        <input type="text" name="partner_name"
                                                               class="form-control form-control-sm"
                                                               t-att-value="p['name']"/>
                                                    </div>
                                                    <div class="col-5">
                                                        <input type="text" name="partner_phone" dir="ltr"
                                                               class="form-control form-control-sm"
                                                               t-att-value="p['phone']"/>
                                                    </div>
                                                </div>
                                                <div class="row g-2 mb-2" data-modryn-row="1">
                                                    <div class="col-7">
                                                        <input type="text" name="partner_name"
                                                               class="form-control form-control-sm"
                                                               placeholder="Another partner"/>
                                                    </div>
                                                    <div class="col-5">
                                                        <input type="text" name="partner_phone" dir="ltr"
                                                               class="form-control form-control-sm"
                                                               placeholder="Phone"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="button" class="btn_quiet"
                                                    data-modryn-add="1" hidden="hidden">
                                                Add another partner
                                            </button>
                                            <p class="modryn_plat_sub mb-0 mt-2">
                                                Clear a name to remove that
                                                partner.
                                            </p>
                                        </div>

                                        <!-- The sign-ins MODRYN issued to this
                                             shop. Existing rows can be edited
                                             or emptied to drop them; one blank
                                             waits below and the button makes
                                             another, as many as the shop was
                                             given. -->
                                        <div class="col-12" data-modryn-rows="accounts">
                                            <label class="form-label">Sign-ins issued to this shop</label>
                                            <div data-modryn-stack="1">
                                                <div t-foreach="shop['accounts']" t-as="acc"
                                                     class="row g-2 mb-2" data-modryn-row="1">
                                                    <div class="col-4">
                                                        <input type="text" name="account_username" dir="ltr"
                                                               class="form-control form-control-sm"
                                                               autocomplete="off"
                                                               t-att-value="acc['username']"/>
                                                    </div>
                                                    <div class="col-4">
                                                        <input type="text" name="account_password" dir="ltr"
                                                               class="form-control form-control-sm"
                                                               autocomplete="off"
                                                               t-att-value="acc['password']"/>
                                                    </div>
                                                    <div class="col-4">
                                                        <input type="text" name="account_holder"
                                                               class="form-control form-control-sm"
                                                               t-att-value="acc['holder']"/>
                                                    </div>
                                                </div>
                                                <div class="row g-2 mb-2" data-modryn-row="1">
                                                    <div class="col-4">
                                                        <input type="text" name="account_username" dir="ltr"
                                                               class="form-control form-control-sm"
                                                               autocomplete="off" placeholder="Username"/>
                                                    </div>
                                                    <div class="col-4">
                                                        <input type="text" name="account_password" dir="ltr"
                                                               class="form-control form-control-sm"
                                                               autocomplete="off" placeholder="Password"/>
                                                    </div>
                                                    <div class="col-4">
                                                        <input type="text" name="account_holder"
                                                               class="form-control form-control-sm"
                                                               placeholder="Whose it is"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="button" class="btn_quiet"
                                                    data-modryn-add="1" hidden="hidden">
                                                Add another sign-in
                                            </button>
                                            <p class="modryn_plat_sub mb-0">
                                                Kept so it can be read back,
                                                which means it is kept readable.
                                                No other screen shows it.
                                            </p>
                                        </div>

                                        <div class="col-12">
                                            <button type="submit" class="btn_gold">Save the boutique</button>
                                        </div>
                                    </form>
                                </details>
                            </td>
                        </tr>
                        </t>
                    </tbody>
                </table>
                </div>

                <!-- ========================= the archive ========================= -->
                <!-- Its own place, not greyed-out rows mixed into the list above:
                     a register of forty shops that shows forty rows, eight of
                     which left last year, is a register nobody can count from. -->
                <details id="archive" class="modryn_plat_panel mt-4">
                    <summary class="modryn_plat_archive_head">
                        <i class="fa fa-archive" aria-hidden="true"/>
                        Archive
                        <span class="modryn_plat_badge" t-out="len(archived)"/>
                    </summary>

                    <p t-if="not archived" class="modryn_plat_empty mt-3 mb-0">
                        Nothing archived.
                    </p>

                    <div t-else="" class="mt-3">
                        <p class="modryn_plat_sub">
                            Boutiques that left the list. Restoring one puts it
                            back. Deleting one removes MODRYN's record that the
                            shop was ever a customer - it does not touch the
                            shop's own database, which lives somewhere this
                            screen cannot reach.
                        </p>

                        <div class="modryn_plat_scroll">
                        <table class="modryn_plat_table">
                            <thead>
                                <tr><th>No.</th><th>Name</th><th>Where</th><th/></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="archived" t-as="shop">
                                <tr>
                                    <td dir="ltr" t-out="shop['code']"/>
                                    <td>
                                        <strong t-out="shop['name']"/>
                                        <div t-if="shop['slug']" class="modryn_plat_sub"
                                             dir="ltr" t-out="shop['slug']"/>
                                    </td>
                                    <td>
                                        <t t-out="shop['city']"/>
                                        <t t-if="shop['street']">, <t t-out="shop['street']"/></t>
                                    </td>
                                    <td class="text-end">
                                        <form t-attf-action="/platform/boutiques/archive/#{shop['id']}"
                                              method="post" class="d-inline">
                                            <input type="hidden" name="csrf_token"
                                                   t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn_quiet">Restore</button>
                                        </form>
                                    </td>
                                </tr>
                                <!-- Its own row, because it is a four-field
                                     form: in the action cell it left the shop's
                                     details floating in the middle of a tall
                                     row with the buttons stacked above them. -->
                                <tr>
                                    <td colspan="4" class="p-0">
                                        <details class="modryn_plat_ask modryn_plat_danger_row">
                                            <summary class="btn_quiet">Delete for good</summary>
                                            <div class="modryn_plat_confirm">
                                                <div class="modryn_plat_sub">
                                                    This cannot be undone. Enter
                                                    everything you sign in with.
                                                </div>
                                                <form t-attf-action="/platform/boutiques/delete/#{shop['id']}"
                                                      method="post" class="row g-2 mt-1">
                                                    <input type="hidden" name="csrf_token"
                                                           t-att-value="request.csrf_token()"/>
                                                    <div class="col-6 col-md-3">
                                                        <input type="text" name="username"
                                                               class="form-control form-control-sm"
                                                               autocomplete="off"
                                                               placeholder="Username"/>
                                                    </div>
                                                    <div class="col-6 col-md-3">
                                                        <input type="text" name="phone" dir="ltr"
                                                               class="form-control form-control-sm"
                                                               autocomplete="off"
                                                               placeholder="Phone number"/>
                                                    </div>
                                                    <div class="col-6 col-md-3">
                                                        <input type="password" name="idnum" dir="ltr"
                                                               class="form-control form-control-sm"
                                                               autocomplete="off"
                                                               placeholder="ID number"/>
                                                    </div>
                                                    <div class="col-6 col-md-3">
                                                        <input type="password" name="password"
                                                               class="form-control form-control-sm"
                                                               autocomplete="off"
                                                               placeholder="Password"/>
                                                    </div>
                                                    <div class="col-12">
                                                        <button type="submit" class="btn_gold">
                                                            Delete this boutique
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </details>
                                    </td>
                                </tr>
                                </t>
                            </tbody>
                        </table>
                        </div>
                    </div>
                </details>
            </div>
        </t>
    </template>


    <!-- Subscription tiers, and what each one includes. The features are the
         owner's own list — he said he would decide them later, so they are rows
         he adds rather than a Selection a developer maintains. -->
    <template id="plans" name="MODRYN subscription plans">
        <t t-call="modryn_platform.platform_shell">
            <t t-set="here" t-value="'plans'"/>
            <div>
                <h1>Subscriptions</h1>
                <p class="modryn_plat_lead">
                    The tiers you sell: what each one costs a month, which
                    screens it opens, and which boxes on those screens. Tick a
                    screen to include it, then tick the boxes on it the boutique
                    should see.
                </p>

                <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>

                <h2 class="h5">Features</h2>
                <form action="/platform/plans/feature/new" method="post"
                      class="row g-2 mb-3" style="max-width: 820px;">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="col-md-4">
                        <input type="text" name="name" class="form-control"
                               placeholder="Feature name"/>
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="code" class="form-control" dir="ltr"
                               placeholder="code (optional)"/>
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="note" class="form-control"
                               placeholder="What it covers"/>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn_quiet w-100">Add</button>
                    </div>
                </form>

                <p t-if="not features" class="text-muted">
                    No features yet. Add the first one above, then tick it onto a tier.
                </p>
                <table t-if="features" class="modryn_plat_table mb-5"
                       style="max-width: 820px;">
                    <tbody>
                        <tr t-foreach="features" t-as="f"
                            t-attf-class="#{'text-muted' if not f.active else ''}">
                            <td>
                                <t t-out="f.name"/>
                                <span t-if="f.code" class="modryn_plat_sub" dir="ltr">
                                    · <t t-out="f.code"/>
                                </span>
                            </td>
                            <td class="modryn_plat_sub" t-out="f.note or ''"/>
                            <td class="text-end">
                                <form t-attf-action="/platform/plans/feature/archive/#{f.id}"
                                      method="post" class="d-inline">
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn_quiet">
                                        <t t-if="f.active">Archive</t><t t-else="">Restore</t>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <h2 class="h5">Tiers</h2>

                <form action="/platform/plans/type/new" method="post"
                      class="row g-2 mb-4" style="max-width: 820px;">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="col-12 col-md-4">
                        <input type="text" name="name" class="form-control"
                               placeholder="Tier name"/>
                    </div>
                    <div class="col-12 col-md-4">
                        <input type="text" name="note" class="form-control"
                               placeholder="Note (optional)"/>
                    </div>
                    <div class="col-6 col-md-2">
                        <input type="number" name="price" min="0" step="0.01" dir="ltr"
                               class="form-control" placeholder="Price"/>
                    </div>
                    <div class="col-6 col-md-2">
                        <button type="submit" class="btn_quiet w-100">Add tier</button>
                    </div>
                </form>

                <p t-if="not types" class="modryn_plat_empty">
                    No tiers yet. Add the first one above.
                </p>

                <!-- ONE FORM PER TIER, posting the price and the whole set of
                     ticks together. Replace-set rather than per-item toggles:
                     what gets stored is exactly what he is looking at, so two
                     tabs open on this page cannot disagree about a tier.

                     `ticks_posted` is the hidden field that makes an empty list
                     mean "untick everything" rather than "this form was not
                     about ticks" - without it, correcting a price would strip
                     the tier's screens. -->
                <div t-foreach="types" t-as="ty"
                     t-attf-class="modryn_plat_panel #{'' if ty.active else 'modryn_plat_faded'}">

                    <form t-attf-action="/platform/plans/type/edit/#{ty.id}" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="ticks_posted" value="1"/>

                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label modryn_plat_sub">Tier name</label>
                                <input type="text" name="name" class="form-control"
                                       t-att-value="ty.name"/>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label modryn_plat_sub">Note</label>
                                <input type="text" name="note" class="form-control"
                                       t-att-value="ty.note or ''"/>
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label modryn_plat_sub">Price a month (₪)</label>
                                <input type="number" name="price" min="0" step="0.01" dir="ltr"
                                       class="form-control"
                                       t-att-value="'%g' % ty.price if ty.price else ''"/>
                            </div>
                            <div class="col-6 col-md-2">
                                <button type="submit" class="btn_gold w-100">Save</button>
                            </div>
                        </div>

                        <!-- WHAT IT OPENS. The screens, and under each one the
                             boxes that sit on it. A box is only ever offered
                             under its own screen, so a tier cannot grant a panel
                             on a screen it does not include. -->
                        <div class="modryn_plat_sub mb-2">Screens, and the boxes on them</div>
                        <p t-if="not screens" class="modryn_plat_empty">
                            No screens listed yet.
                        </p>
                        <div class="modryn_plat_screens">
                            <div t-foreach="screens" t-as="sc" class="modryn_plat_screen">
                                <label class="modryn_plat_strong">
                                    <input type="checkbox" name="screen_id"
                                           t-att-value="sc.id"
                                           t-att-checked="'checked' if sc in ty.screen_ids else None"/>
                                    <span t-out="sc.name"/>
                                </label>
                                <div t-if="sc.section_ids" class="modryn_plat_boxes">
                                    <label t-foreach="sc.section_ids" t-as="sec">
                                        <input type="checkbox" name="section_id"
                                               t-att-value="sec.id"
                                               t-att-checked="'checked' if sec in ty.section_ids else None"/>
                                        <span t-out="sec.name"/>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <t t-if="features">
                            <div class="modryn_plat_sub mt-3 mb-2">Extras</div>
                            <t t-foreach="features" t-as="f">
                                <label t-if="f.active" class="me-3">
                                    <input type="checkbox" name="feature_id" t-att-value="f.id"
                                           t-att-checked="'checked' if f in ty.feature_ids else None"/>
                                    <span t-out="f.name"/>
                                </label>
                            </t>
                        </t>
                    </form>

                    <div class="mt-3">
                        <form t-attf-action="/platform/plans/type/archive/#{ty.id}"
                              method="post" class="d-inline">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <button type="submit" class="btn_quiet">
                                <t t-if="ty.active">Archive tier</t><t t-else="">Restore tier</t>
                            </button>
                        </form>
                    </div>

                    <!-- Four answers, the same bar as deleting a boutique, and
                         for the same reason: it cannot be undone. -->
                    <details class="modryn_plat_ask modryn_plat_danger_row mt-2">
                        <summary class="btn_quiet">Delete this tier</summary>
                        <div class="modryn_plat_confirm">
                            <div class="modryn_plat_sub">
                                This cannot be undone. Type everything you sign in
                                with.
                            </div>
                            <form t-attf-action="/platform/plans/type/delete/#{ty.id}"
                                  method="post" class="row g-2">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()"/>
                                <div class="col-12 col-sm-6">
                                    <input type="text" name="username" autocomplete="off"
                                           class="form-control form-control-sm"
                                           placeholder="Username"/>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <input type="text" name="phone" dir="ltr" autocomplete="off"
                                           class="form-control form-control-sm"
                                           placeholder="Phone number"/>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <input type="password" name="idnum" dir="ltr" autocomplete="off"
                                           class="form-control form-control-sm"
                                           placeholder="ID number"/>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <input type="password" name="password" autocomplete="off"
                                           class="form-control form-control-sm"
                                           placeholder="Password"/>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn_gold">Delete this tier</button>
                                </div>
                            </form>
                        </div>
                    </details>
                </div>
            </div>
        </t>
    </template>

</odoo>
